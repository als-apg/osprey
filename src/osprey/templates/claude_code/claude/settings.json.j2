{%- set ns = namespace() -%}
{#- Wiring the profile DECLARED for the custom hooks it ships (claude_code.hooks,
    resolved in claude_code.py). Purely additive: every block below emits the
    framework's own entries unconditionally and unaltered, then appends these. -#}
{%- set declared = declared_hooks | default({}) -%}
{%- macro declared_entry(rule, py) %}
      {
{%- if rule.matcher %}
        "matcher": {{ rule.matcher | tojson }},
{%- endif %}
        "hooks": [
{%- for h in rule.hooks %}
          {
            "type": "{{ h.type }}",
            "command": {{ h.command | replace("python3 ", '"' ~ py ~ '" ') | tojson }},
            "timeout": {{ h.timeout }}
          }{% if not loop.last %},{% endif %}
{%- endfor %}
        ]
      }
{%- endmacro -%}
{
  "showThinkingSummaries": true,
{%- if terminal_theme %}
{#- The terminal follows the deployment's `web.theme`, and only when that
    value PINS a mode (a concrete theme id like "desy-light"). A family pins
    nothing and this line is absent — Claude Code's own default applies. -#}
  "theme": {{ terminal_theme | tojson }},
{%- endif %}
  "outputStyle": ".claude/output-styles/control-operator.md",
  "statusLine": {
    "type": "command",
    "command": {{ ('"' ~ current_python_env ~ '" "$CLAUDE_PROJECT_DIR/.claude/statusline.py"') | tojson }}
  },
  "_PROMPT_PROVIDER_NOTE": "Permissions policy: allow/deny/ask lists. Framework defaults merged with facility overrides from claude_code.permissions config.",
  "enableAllProjectMcpServers": true,
{#- Claude Code ships harness-configuration skills with the CLI itself, so they
    are present in every deployed terminal uninvited. An OSPREY operator agent
    must never reconfigure its own harness (settings.json permissions, env
    vars, hooks, keybindings) — that is admin work done through the profile and
    regen, not live edits — so the harness-config family is switched off
    entirely: hidden from the model, hidden from the / menu, and invoking one
    by name returns an error instead of running. -#}
  "skillOverrides": {
    "update-config": "off",
    "keybindings-help": "off",
    "fewer-permission-prompts": "off"
  },
  "permissions": {
    "allow": [
{#- Build allow list from server registry -#}
{%- set allow_entries = [] -%}
{#- The agent must be able to read what it writes, so these are keyed off the
    project's own `agent_data.base_dir` rather than a literal: a relocated
    agent-data root would otherwise leave the agent refused access to its own
    artifacts. -#}
{%- set _ = allow_entries.append('"Read(' ~ agent_data_root ~ '/**)"') -%}
{%- set _ = allow_entries.append('"Read(' ~ agent_data_root ~ '/data/**)"') -%}
{%- set _ = allow_entries.append('"Read(' ~ agent_data_root ~ '/plots/**)"') -%}
{%- set _ = allow_entries.append('"Read(' ~ agent_data_root ~ '/results/**)"') -%}
{%- if textbooks_root -%}
{%- set _ = allow_entries.append('"Read(' ~ textbooks_root ~ '/**)"') -%}
{%- endif -%}
{%- if textbooks_root_tilde -%}
{%- set _ = allow_entries.append('"Read(' ~ textbooks_root_tilde ~ '/**)"') -%}
{%- endif -%}
{#- Per-server tool permissions -#}
{%- for s in servers if s.enabled -%}
{%- for tool in s.permissions_allow -%}
{%- set _ = allow_entries.append('"mcp__' ~ s.name ~ '__' ~ tool ~ '"') -%}
{%- endfor -%}
{%- for entry in s.fixed_allow -%}
{%- set _ = allow_entries.append('"' ~ entry ~ '"') -%}
{%- endfor -%}
{%- endfor -%}
{%- set _ = allow_entries.append('"NotebookEdit(' ~ agent_data_root ~ '/artifacts/**)"') -%}
{#- Per-agent Task() permissions -#}
{%- for a in agents if a.enabled -%}
{%- set _ = allow_entries.append('"Task(' ~ a.name ~ ')"') -%}
{%- endfor -%}
{%- for entry in facility_permissions.get('allow', []) -%}
{%- set _ = allow_entries.append('"' ~ entry ~ '"') -%}
{%- endfor -%}
{% for entry in allow_entries %}      {{ entry }}{% if not loop.last %},{% endif %}
{% endfor %}    ],
{#- The deny floor is DENY_DEFAULTS in osprey/cli/templates/claude_code.py,
    handed over as `deny_defaults` by config_derived_context (which both render
    paths call). Deliberately NOT re-declared here: the build lint and the
    headless read-only-floor drift test read that same constant, and a second
    copy in this file is how the two policies would silently fork.

    Note the loop below is Jinja, so a context MISSING `deny_defaults` renders
    an empty deny array instead of failing — a settings.json that looks whole
    and denies nothing. What actually catches that is coverage of the rendered
    artifact, not this file: test_claude_code_integration and test_claude_regen
    assert the framework defaults are present in a built project's
    permissions.deny, on the create_project and regenerate paths respectively. -#}
{#- Three parts, in this order:
      1. deny_defaults  - remove_deny
      2. facility deny  - remove_deny   (profile-authored; a profile may
                                         subtract what a profile added)
      3. killswitch_deny                (writes-off kill switch; appended LAST
                                         and NEVER filtered)
    Part 3 is the whole reason the kill switch renders through its own context
    key rather than through facility_permissions.deny: remove_deny is authored
    in the profile, so anything it can reach is something a profile can lift.
    A writes-off deny must not be liftable that way. -#}
{%- set remove_deny = facility_permissions.get('remove_deny', []) -%}
{%- set deny_entries = [] -%}
{%- for d in deny_defaults if d not in remove_deny -%}
{%- set _ = deny_entries.append(d) -%}
{%- endfor -%}
{%- for d in facility_permissions.get('deny', []) if d not in remove_deny -%}
{%- set _ = deny_entries.append(d) -%}
{%- endfor -%}
{%- for d in killswitch_deny | default([]) -%}
{%- set _ = deny_entries.append(d) -%}
{%- endfor -%}
    "deny": [
{% for entry in deny_entries %}      "{{ entry }}"{% if not loop.last %},{% endif %}
{% endfor %}    ],
    "ask": [
{%- set ask_entries = [] -%}
{%- for s in servers if s.enabled -%}
{%- for tool in s.permissions_ask -%}
{%- set _ = ask_entries.append('"mcp__' ~ s.name ~ '__' ~ tool ~ '"') -%}
{%- endfor -%}
{%- for entry in s.fixed_ask -%}
{%- set _ = ask_entries.append('"' ~ entry ~ '"') -%}
{%- endfor -%}
{%- endfor -%}
{%- for entry in facility_permissions.get('ask', []) -%}
{%- set _ = ask_entries.append('"' ~ entry ~ '"') -%}
{%- endfor -%}
{#- Kill-switch: drop tools the renderer pulled out of ask (e.g. mcp__python__execute
    when writes are disabled) so they can't reach the permissions.ask -> can_use_tool
    approval path. Mirrors the remove_deny filter above. -#}
{%- set remove_ask = facility_permissions.get('remove_ask', []) -%}
{% for entry in ask_entries if entry.strip('"') not in remove_ask %}      {{ entry }}{% if not loop.last %},{% endif %}
{% endfor %}    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ ('"' ~ current_python_env ~ '" "$CLAUDE_PROJECT_DIR/.claude/hooks/osprey_config_drift.py" 2>/dev/null || true') | tojson }},
            "timeout": 5
          },
          {
            "type": "command",
            "command": {{ ('"' ~ current_python_env ~ '" "$CLAUDE_PROJECT_DIR/.claude/hooks/osprey_panels_context.py" 2>/dev/null || true') | tojson }},
            "timeout": 5
          }
        ]
      }{% for rule in declared.get('SessionStart', []) %},{{ declared_entry(rule, current_python_env) }}{% endfor %}
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ ('"' ~ current_python_env ~ '" "$CLAUDE_PROJECT_DIR/.claude/hooks/osprey_focus_validate.py" 2>/dev/null || true') | tojson }},
            "timeout": 2
          },
          {
            "type": "command",
            "command": {{ ('"' ~ current_python_env ~ '" "$CLAUDE_PROJECT_DIR/.claude/hooks/osprey_workspace_delta.py" 2>/dev/null || true') | tojson }},
            "timeout": 3
          }
        ]
      }{% for rule in declared.get('UserPromptSubmit', []) %},{{ declared_entry(rule, current_python_env) }}{% endfor %}
    ],
    "PreToolUse": [
{%- set pre_rules = [] -%}
{%- for rule in framework_pre_hooks | default([]) -%}
{%- set _ = pre_rules.append(rule) -%}
{%- endfor -%}
{%- for s in servers if s.enabled -%}
{%- for rule in s.hooks_pre -%}
{%- set _ = pre_rules.append(rule) -%}
{%- endfor -%}
{%- endfor -%}
{#- Appended, so the framework's entries are neither removed nor altered. Claude
    Code runs every entry whose matcher fits, so position carries no authority
    and a declared hook is one MORE gate, never a way to relax an existing one. -#}
{%- for rule in declared.get('PreToolUse', []) -%}
{%- set _ = pre_rules.append(rule) -%}
{%- endfor -%}
{%- for rule in pre_rules %}
      {
        "matcher": {{ rule.matcher | tojson }},
        "hooks": [
{%- for h in rule.hooks %}
          {
            "type": "{{ h.type }}",
            "command": {{ h.command | replace("python3 ", '"' ~ current_python_env ~ '" ') | tojson }},
            "timeout": {{ h.timeout }}
          }{% if not loop.last %},{% endif %}
{%- endfor %}
        ]
      }{% if not loop.last %},{% endif %}
{%- endfor %}
    ],
    "PostToolUse": [
{%- set post_rules = [] -%}
{%- for s in servers if s.enabled -%}
{%- for rule in s.hooks_post -%}
{%- set _ = post_rules.append(rule) -%}
{%- endfor -%}
{%- endfor -%}
{%- for rule in framework_post_hooks | default([]) -%}
{%- set _ = post_rules.append(rule) -%}
{%- endfor -%}
{%- for rule in declared.get('PostToolUse', []) -%}
{%- set _ = post_rules.append(rule) -%}
{%- endfor -%}
{%- for rule in post_rules %}
      {
        "matcher": {{ rule.matcher | tojson }},
        "hooks": [
{%- for h in rule.hooks %}
          {
            "type": "{{ h.type }}",
            "command": {{ h.command | replace("python3 ", '"' ~ current_python_env ~ '" ') | tojson }},
            "timeout": {{ h.timeout }}
          }{% if not loop.last %},{% endif %}
{%- endfor %}
        ]
      }{% if not loop.last %},{% endif %}
{%- endfor %}
    ]
{#- Events the framework wires nothing on exist as keys only when declared. -#}
{%- for event in declared_extra_events | default([]) %},
    "{{ event }}": [
{%- for rule in declared[event] %}{{ declared_entry(rule, current_python_env) }}{% if not loop.last %},{% endif %}{% endfor %}
    ]
{%- endfor %}
  }
}
