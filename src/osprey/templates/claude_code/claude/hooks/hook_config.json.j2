{#-
  Runtime contract for the write-gating layers: the osprey_writes_check.py
  PreToolUse hook and the MCP audit middleware both read this file as data.
  Every write-gating key is emitted UNCONDITIONALLY — never under the writes-off
  kill-switch condition — because both consumers run under a readonly session
  posture too, where that condition never applied.

  `mcp__<name>__.*` is what the registry gives a facility-custom server that
  opts into writes_check: its tool names are unknown at render time. That
  matcher lands in `write_tools` like any other (it is also what
  read_only_disallowed_tools is built from), and the hooks' shared
  `is_write_tool` honours the trailing wildcard — so every tool on such a
  server is gated, reads included. A server that declares `writes:` gets one
  exact matcher per write tool instead, so its other tools stay reads.

  `facility_write_tools` is the facility (custom-server) write set — those
  exact names and whole-server matchers — as
  osprey.registry.mcp.facility_write_tools computed it; it is rendered
  verbatim, and this template derives nothing from it. Both write-target
  twins read it to send exactly those tools to `live`.

  `governed_tools` is the set the write switch's position decides for, as
  osprey.registry.mcp.governed_write_tools computed it; rendered verbatim, and
  read by the approval hook through `is_governed`, which honours the same
  trailing wildcard as `is_write_tool`.

  `control_system_write_tools` is the subset of the project's
  `control_system.write_tools` that this render actually APPENDED to
  `write_tools` — an extra naming a matcher a server already contributed is
  left out, because that one does reach `permissions.deny` under the writes
  kill switch. The appended ones never do: they are refused per call. Only
  osprey_config_drift.py reads this key, to keep those names out of the set it
  compares against a deployment's stale deny list; every other consumer reads
  `write_tools`, which is unchanged.

  `measurement` is each pyAML view's block, `{kinds, groups, rf, view_sha256}`
  per model, as the build read it from the view; `kinds` maps each listed kind
  to the view name of each setpoint role it steps; `{}` when the render has none.

  `app_approvals` is each application write tool's approval declaration keyed
  by its full `mcp__<app>__<tool>` name, and `app_error_types` the class and
  guidance text of each `<app>.<type>` error, both derived from the rendered
  `apps.<name>` leaves; `{}` when the render has no application.

  `watchdogs_enabled` is the one conditional key: `true` when the render has an
  enabled watchdog and absent otherwise, so a build with none renders what it
  would render without the feature. It has nothing to do with writes.
-#}
{%- set server_pfx = [] -%}
{%- set approval_pfx = [] -%}
{%- set write_tools = [] -%}
{%- set appended_extras = [] -%}
{%- for s in servers if s.enabled -%}
  {%- set _ = server_pfx.append("mcp__" ~ s.name ~ "__") -%}
  {%- for rule in s.hooks_pre -%}
    {%- for hook in rule.hooks -%}
      {%- if 'osprey_approval.py' in hook.command -%}
        {%- set _ = approval_pfx.append("mcp__" ~ s.name ~ "__") -%}
      {%- endif -%}
      {%- if 'osprey_writes_check.py' in hook.command -%}
        {%- set _ = write_tools.append(rule.matcher) -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endfor -%}
{%- for extra in control_system_write_tools -%}
  {%- if extra not in write_tools -%}
    {%- set _ = write_tools.append(extra) -%}
    {%- set _ = appended_extras.append(extra) -%}
  {%- endif -%}
{%- endfor -%}
{
  "server_prefixes": {{ server_pfx | tojson }},
  "approval_prefixes": {{ approval_pfx | tojson }},
  "write_tools": {{ write_tools | tojson }},
  "control_system_write_tools": {{ appended_extras | tojson }},
  "facility_write_tools": {{ facility_write_tools | default([], true) | tojson }},
  "governed_tools": {{ governed_tools | default([], true) | tojson }},
  "mixed_read_write_tools": {{ mixed_read_write_tools | default([], true) | tojson }},
  "lane_addressed_tools": {{ lane_addressed_tools | default([], true) | tojson }},
  "measurement": {{ measurement | default({}, true) | tojson }},
  "app_approvals": {{ app_approvals | default({}, true) | tojson }},
  "app_error_types": {{ app_error_types | default({}, true) | tojson }}
{%- if watchdogs_enabled %},
  "watchdogs_enabled": true
{%- endif %}
}
