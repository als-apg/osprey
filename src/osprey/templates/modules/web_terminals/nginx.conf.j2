{#
  nginx.conf.j2 — single-origin reverse proxy + landing page front door.

  Rendered by render_web_terminals() (src/osprey/deployment/web_terminals/render.py)
  with a Jinja2 Environment that has autoescape=False — this emits nginx conf
  syntax, not HTML.

  ----------------------------------------------------------------------------
  TEMPLATE CONTRACT (variables render.py MUST supply — same object shapes as
  docker-compose.web.yml.j2; see that template's header for the full spec)
  ----------------------------------------------------------------------------

    nginx_port: int, required
    bind_host: str, required (render.py's _LOOPBACK_BIND_HOST, "127.0.0.1")
      The loopback address every per-user app's `web` family binds (see
      docker-compose.web.yml.j2's OSPREY_TERMINAL_BIND_HOST). This is the
      `proxy_pass` upstream host below — nginx is the only process on the
      shared host netns expected to reach it from outside.
    services: list[dict], required (may be empty)
      Same list docker-compose.web.yml.j2 consumes. Only `user`, `web`,
      `terminal_secret_env` and `session_cookie` are read here
      — the artifact/ariel/lattice families get no nginx route of
      their own: once a browser is on a user's own `/u/<user>/` origin, the
      per-user app reverse-proxies its own panels (routes/proxy.py) to those
      three families internally, so nginx never needs to know about them.
      `session_cookie` is the name of the ONE cookie that user's app issues
      (`osprey_terminal_session_<web>`), resolved by render.py through the app's
      own `session_cookie_name()` so the perimeter cannot spell it differently
      than the app that reads it.
    tls_enabled: bool, required (defaults to False)
      When true, emit TWO server blocks: a redirect-only one on nginx_port
      whose entire content is `return 301 <external_origin>$request_uri;`
      (`https://$host$request_uri` when external_origin is empty), and the
      real content server on `listen <tls_port> ssl` with
      `ssl_certificate`/`ssl_certificate_key` pointing at tls_cert/tls_key.
      When false, nothing TLS-related is emitted and the single server listens
      on nginx_port — the plain-http posture.
    tls_port: int, required (defaults to 443, render.py's TLS_LISTEN_PORT)
      The port BOTH `listen ... ssl` lines bind, parsed from `tls.port`. Only
      read when tls_enabled is true. A value render.py cannot use as a port
      (non-integer, boolean, outside 1-65535) falls back to the default and
      lint reports it, so the listener never renders a value the deploy chain
      could not bind. render.py follows the same value into `external_origin`
      and into the perimeter deny list, so the listener, the render-time links
      and the deny-list are one number and not three.
    https_default_port: int, required (render.py's _HTTPS_DEFAULT_PORT, 443)
      The port a browser already goes to for an `https://` URL with no port in
      it. Read only by the plain redirect's `$host` arm, which renders when
      external_origin is empty: at that port the target stays a bare `$host`;
      on any other port it must name it (`$host:<tls_port>`), or the bounce
      lands on a port nothing listens on. Passed in rather than restated here
      so the redirect and render.py's `external_origin` decide "is a port
      needed" against the same constant.
    external_origin: str, required ("" when the render derives none)
      The one origin every per-user terminal accepts actions from (render.py's
      _external_origin). Derived whenever the roster has a user or a sidecar is
      active; a roster-less, sidecar-less render has none.
    origin_host: str, required ("" alongside an empty external_origin)
      The host of external_origin, without scheme or port. When set, the
      content server's `server_name` is origin_host, and a `default_server` on
      the same listener returns `301 <external_origin>$request_uri` for every
      other name. When empty, one `server_name _` server answers every name.
    tls_cert, tls_key: str | None
      Absolute paths inside the nginx container. Only read when tls_enabled
      is true; render.py already refuses to render (ValueError) if
      tls_enabled is true but either path is missing.
    auth_method: str, required ("none" | "token" | "password" | "oidc";
      defaults to "token"). Informational here — every gate below reads the
      derived booleans render.py computes from it, never the name.
    sidecar_active: bool, required (auth_method is "password" or "oidc")
      The LOGIN WALL. When true, emit an `auth_request` directive in every
      proxied `/u/<user>/` location, the per-user internal target
      location each of them subrequests, the `@osprey_auth_401` handler and
      its two maps, `absolute_redirect off`, and the public `/auth/` surface
      the sidecar serves the login flow from. When false ("token" and
      "none"), none of that is emitted: there is no sidecar to answer a
      subrequest, so nothing here may pretend one could.
    inject_secret: bool, required (auth_method is not "token")
      The SECRET INJECTION, and a separate axis from the wall above. When
      true, every `/u/<user>/` location `include`s that user's
      envsubst'd snippet, which sets `X-Osprey-Terminal-Secret` — so nginx
      itself vouches for the request and the app needs no token exchange.
      "none" (open, navigation-only) is exactly the combination this seam
      exists to render: inject_secret WITHOUT sidecar_active. "token" is the
      opposite pair — no wall and no injection — and is the only method that
      leaves a location with the secret header CLEARED.
    walled, token_exchange: bool, required — passed for contract symmetry
      with the compose overlay; unread here.
      No per-service exception: every `/u/<user>/` location is gated by the
      same two predicates, so the include and the cookie cut move together
      for the whole roster. Never gate one half of a predicate apart from the
      other — see the strip below for what each broken pairing costs.

    auth_port: int, required when sidecar_active (the layout's `auth` slot)
      The loopback port the auth sidecar listens on. Reached at bind_host, the
      same way every per-user app is: the sidecar shares the host network
      namespace with nginx (see docker-compose.web.yml.j2) and publishes
      nothing routable of its own.

  Render output: this file is expected at `nginx/nginx.conf` (relative to the
  rendered docker-compose.web.yml.j2), matching the
  `./nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro` mount in that
  template. The landing page itself (landing.html.j2's output) is expected
  alongside it at `nginx/landing.html`, matching that template's
  `./nginx/landing.html:ro` mount.

  THIS FILE IS A `server{}` FRAGMENT, NOT A COMPLETE MAIN CONFIG — no
  `events{}` wrapper, because `server`/`listen`/`location` (and the `map`
  below) are only valid nginx directives INSIDE an `http{}` block. It is
  deliberately mounted at `/etc/nginx/conf.d/default.conf`, not
  `/etc/nginx/nginx.conf`: the base nginx image's own (untouched) main config
  already ships `events{}` and already `include`s `/etc/nginx/conf.d/*.conf`
  from inside its `http{}` block — so this fragment's TOP LEVEL is already
  http context, with `server{}` nested one level below it. Mounting this
  fragment at the main-config path instead would fail nginx's parse at
  startup ("server" directive is not allowed there) and the whole stack
  would never come up — validate any change to this file by running
  `nginx -t` with it mounted at the EXACT container path above (against the
  real base image, not wrapped in a hand-written http{} block), not just as
  a syntactically-standalone fragment.

  ----------------------------------------------------------------------------
  WHAT REACHES AN UPSTREAM

  Every `/u/<user>/` location forwards exactly the credentials this perimeter
  put there, whatever the auth mode:

    * `Authorization` is cleared unconditionally. nginx never sets it on this
      path, so an arriving value is the client's; the app's own bearer tier is
      loopback traffic inside the container and never crosses this proxy.
    * `X-Osprey-Terminal-Secret` is either INJECTED (`inject_secret`, from
      that user's envsubst'd snippet) or CLEARED ("token") — it is never
      forwarded from the client. The two are exhaustive and mutually
      exclusive, which is what makes the name claimed exactly once in every
      proxying location.
    * `Cookie` is either cut entirely (locations behind the sidecar's
      `auth_request`, which authenticate by the injected header AND would
      otherwise hand a container the sidecar's origin-wide session) or
      narrowed to that user's own `session_cookie` ("token", "none"). Under
      "none" the narrowed cookie travels even though the secret is injected:
      there is no sidecar, so no origin-wide `osprey_auth_session` exists to
      leak, and the app's own session is still what carries per-user state.
      In neither case does the browser's whole jar — which names every other
      terminal it has unlocked, and the sidecar's origin-wide session — reach a
      container running agent-generated code.
    * `X-Osprey-Auth-Account` / `X-Osprey-Auth-Subject` /
      `X-Osprey-Auth-Role` / `X-Osprey-Auth-Role-Source` — which roster card the
      request is on, who proved the login, what privilege it holds and where
      that privilege came from — are written by EVERY proxying location:
      a gated `/u/<user>/` SETS them from `auth_request_set` variables carrying
      what the sidecar returned, and every other proxying location CLEARS them
      — the ungated `/u/<user>/` branch, the internal `/_osprey_auth/<user>`
      target (a subrequest inherits the parent's headers), and the public
      `/auth/` prefix. Either way the name is claimed by a directive, which is
      what stops nginx passing the client's own through, so no topology this
      template renders — auth off included — lets a client name itself to a
      terminal. Exactly one directive per name per location: a second entry for
      the same name buys nothing and warns on every reload.

      Never at `server` level. A location-level `proxy_set_header` REPLACES the
      entire inherited set rather than adding to it, and every location here
      sets `Host` at minimum, so a server-level clear would be silently
      discarded by all of them while reading as though it covered them.

  ----------------------------------------------------------------------------
  WHY A REAL REVERSE PROXY

  Every per-user app binds its `web` port on `bind_host` (127.0.0.1) only —
  off the routable interface — so nginx is the only off-host path and is the
  one process that makes the outbound connection to them. Each configured
  user therefore gets a genuine `proxy_pass` upstream under a shared single
  origin at `/u/<user>/`. The `map` below and the `proxy_set_header` lines
  are what make that proxied connection transparent to WebSocket traffic
  (`/ws/terminal`, the panel WebSocket) — without them the Upgrade handshake
  never reaches the upstream and every terminal connection would fail.

  `location /u/<user>/ { proxy_pass http://<bind_host>:<web>/; }` — the
  trailing slash on BOTH the location and the proxy_pass target strips the
  `/u/<user>` prefix before the request reaches the upstream app, so the app
  itself never sees the prefix in its request path (it only needs to know its
  own prefix for constructing prefixed links/asset URLs, an app-side concern
  handled by the app's own prefix contract, not by anything here).

  A no-trailing-slash `/u/<user>` request would otherwise fall through to
  `location /` (the landing page) instead of the user's app — the companion
  `location = /u/<user>` 301-redirects it to `/u/<user>/` so a bookmark
  without the trailing slash still routes in.

  `proxy_buffering off` + a raised `proxy_read_timeout`: every request under
  `/u/<user>/` genuinely flows through nginx, which means nginx's DEFAULT
  buffering and 60s read timeout apply to the app's Server-Sent-Events streams
  too (`/api/files/events`, chat SSE) — not just the WebSocket traffic the
  Upgrade headers above cover. Buffering ON would batch/delay SSE `data:` lines
  behind nginx's proxy buffer instead of flushing them as the app emits, and the
  60s default read timeout would tear down a heartbeat-less idle SSE stream
  every minute. Both directives are scoped to this proxied location only —
  WebSocket traffic bypasses proxy buffering entirely once the Upgrade
  handshake completes, so this isn't undoing anything the map/upgrade headers
  above already handle for `/ws/terminal`.

  0-user case: the loop below emits zero `location` blocks — the landing page
  (served at `/`) is the whole config, and it renders itself with an empty
  "users" group (see landing.html.j2's own emptiness handling). The `map`
  directive is still emitted unconditionally (it's cheap, valid with zero
  proxied locations, and avoids a second render path for the 0-user case).

  ----------------------------------------------------------------------------
  AUTH/TLS, OFF BY DEFAULT

  A deployment that sets neither `web_terminals.auth` nor `web_terminals.tls`
  renders plain http: no `auth_request`, and no operator secret injected into
  any location. That is not an open perimeter — each terminal behind it still
  authenticates EVERY request against its own operator secret, which `osprey
  up` mints for every roster user in every auth mode. What is missing here is a
  login FLOW: a browser gets past that gate by opening the user's `?token=` URL
  once (`osprey users login-url <user>`), which the app trades for its session
  cookie. See WHAT REACHES AN UPSTREAM above for what each location forwards.

  `auth.method: none` is the deliberate opposite, and the one posture that is
  genuinely open: nginx injects each user's operator secret itself,
  so anyone who can reach this port reaches that terminal with no token, no
  login page and no sidecar. Nothing below softens that — the perimeter IS the
  network the deployment sits on, which is the trade a facility makes when it
  chooses this method. What it still refuses is a client naming ITSELF: the
  identity headers are cleared here exactly as under "token", because no
  sidecar answered for this request and an unchecked subject must never reach
  a container.

  The two seams are opt-in, and each is gated independently:

  - `tls_enabled` (default False) emits nothing. When true, the plain port
    becomes a redirect-only server and a second `listen <tls_port> ssl` server
    — `tls_port` is 443 unless the deployment set `tls.port`, which is what a
    rootless nginx needs — carrying `ssl_certificate`/`ssl_certificate_key`
    from the configured paths and speaking HTTP/2, becomes the sole content
    server. The redirect
    targets the external origin, which names that port whenever it is not
    443. render.py refuses to render at
    all if either path is missing, so this template never has to guard against
    an incoherent pair. A render with an external origin adds a third server:
    the `default_server` on the content listener that redirects every name
    other than the origin's host to the origin.
  - without `sidecar_active` ("token", the default, and "none") the login
    wall emits nothing. When a sidecar method is set,
    every proxied `/u/<user>/` location gets an `auth_request` naming that
    user's own internal `/_osprey_auth/<user>` location, which asks the
    sidecar `GET /verify?user=<user>` over loopback. The username in that
    subrequest is fixed at render time from the roster, so the identity being
    authorized is structural — a request cannot influence which user it is
    checked against. The public `/auth/` prefix (login page, credential POST,
    OIDC callback, logout) stays outside `auth_request`, as does the landing
    page at `= /`; everything else under a user prefix is gated.
  - without `inject_secret` ("token" only) no location includes a secret
    snippet, and every one of them CLEARS the secret header instead. When it
    is set ("none", "password", "oidc") each location includes its own
    user's snippet — the one directive that names that header — so the
    include and the clear are two arms of one exhaustive branch and no
    location ever carries both.

  Fail-closed is the invariant that survives every partial state: a sidecar
  that is down, unconfigured, or answering 503 denies the subrequest, and
  nginx turns a denied subrequest into a refusal rather than a pass-through.
  Misconfiguration locks operators out; it never quietly lets strangers in.

  Both the default (off) render and an enabled render (tls on with a
  self-signed cert fixture + auth on) MUST pass `nginx -t` — the enabled path
  is validated by actually running nginx, not by string-matching the template
  output.
#}
# The access log, with the query string cut out of it.
#
# nginx's built-in `combined` format logs `$request` — the raw request line,
# query string and all. Under this deployment that is a credential store: the
# ONLY way into an auth-off multi-user terminal is
# `/u/<user>/?token=<that user's operator secret>` (the app exchanges the token
# for a session cookie and redirects to the clean URL), so with the default
# format every login writes a working credential in cleartext to nginx's stdout
# — readable by `docker logs`, and shipped verbatim by any log collector
# scraping container output. A log is not a place a credential can be revoked
# from.
#
# `$osprey_log_path` instead (mapped below): `$request_uri` with everything from
# the first `?` onward cut off. Still percent-encoded, so it is safe to emit —
# and `log_format` escapes control characters in every variable anyway (nginx
# >= 1.11.8, the default `escape`). `$uri` would also be query-free but is the
# post-rewrite path, so a landing-page hit would log as `/landing.html` rather
# than as the `/` the client asked for. `$request_method` and `$server_protocol`
# restore the two other pieces `$request` carried, so this stays a line the
# usual log parsers read.
#
# `$http_referer` is dropped rather than logged: a browser that lands on the
# `?token=` URL sends that whole URL as the Referer of everything the page then
# fetches, so the field is a second copy of the same secret. Nothing else here
# needs it.
#
# This covers the access log only. nginx's ERROR log is not formattable, and its
# entries carry `request: "GET /uri?args ..."` — so a token can still reach it
# when a request fails at the proxy (an upstream that is down, a timeout).
# Narrowing that is not something a config can do; it is the reason the
# `?token=` URL is one-shot in practice — the app redirects to the clean URL as
# soon as it has set the cookie.
# The requested path with the query string cut off. Anchored and greedy-free:
# `[^?]*` stops at the first `?`, which is where the query starts, so nothing
# after it can be carried into the value. A request with no query at all falls
# to the default and is logged whole.
map $request_uri $osprey_log_path {
    default $request_uri;
    "~^([^?]*)\?" $1;
}

log_format osprey_sanitized '$remote_addr - $remote_user [$time_local] '
                            '"$request_method $osprey_log_path $server_protocol" '
                            '$status $body_bytes_sent "$http_user_agent"';

# The `access_log` that selects it is emitted per SERVER, not here at http
# level, and that placement is the load-bearing part. The base image's own main
# config already carries `access_log /var/log/nginx/access.log main;` at http
# level (with that path symlinked to /dev/stdout), and nginx does not replace a
# same-level directive — every `access_log` on one level is written. A second
# one here would ADD the sanitized line beside the `combined`-format one that
# still holds the token. A `server`-level directive is what actually suppresses
# the inherited default: access_log is inherited from the level above ONLY when
# the current level defines none.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
{% if sidecar_active %}
# Is this request a browser NAVIGATION, or something a program issued?
#
# It decides what a denied `auth_request` looks like. A person typing a URL or
# clicking a link should land on the login page; a `fetch()`, an EventSource,
# or a WebSocket handshake should get a bare 401 it can act on. Redirecting
# those instead would hand a JSON caller a page of login HTML (a parse error
# somewhere far from the cause) and put an EventSource into a silent reconnect
# loop against a login page that never becomes the stream it wanted.
#
# The source is the Upgrade and Accept headers concatenated, which is a
# deliberate trick: browsers send `Accept: text/html,…` first on a navigation,
# so anchoring at the start matches exactly those — while any WebSocket
# handshake prefixes the upgrade token, pushing `text/html` off the anchor and
# scoring 0 no matter what its Accept header claims. `fetch()` defaults to
# `*/*`, XHR to `*/*`, and EventSource to `text/event-stream`; none match.
map $http_upgrade$http_accept $osprey_auth_wants_login_page {
    default 0;
    "~*^text/html" 1;
    "~*^application/xhtml\+xml" 1;
}

# The return-to path, or nothing. An allowlist, and it has to be one.
#
# `$uri` is nginx's DECODED path, which is the safe form for matching (it is
# what routed the request) and the DANGEROUS form for emitting: `%0d%0a` in a
# request path has already become a real CR LF by the time this is read, and
# `return 302` copies a variable into the Location header verbatim. Emitting
# `$uri` directly let one crafted link append arbitrary response headers —
# a Set-Cookie planting an attacker's session on this very origin, reachable
# by anyone, and most effective on a logged-out victim, which is exactly who
# follows a login link. A `%26` likewise arrived as a real `&` and appended a
# second `user=` parameter, which a query parser reading the last value would
# have taken over the one this deployment rendered.
#
# So nothing decoded is emitted unless it matches the shape of a legitimate
# terminal path. The character class admits no CR, no LF, no `&`, no `?`, no
# space — deep links keep working, and everything else collapses to the empty
# default, which the login page treats as "no return-to". `\z` rather than
# `$`: PCRE's `$` also matches immediately BEFORE a trailing newline, so a
# path ending in `%0a` would otherwise still be emitted, newline and all.
map $uri $osprey_auth_next {
    default "";
    "~^{{ url_mount_root_pattern }}/[A-Za-z0-9._-]+/[A-Za-z0-9._~/-]*\z" $uri;
}
{% endif -%}
{% if tls_enabled %}
# TLS is on, so the plain port serves NOTHING but the way to the secure one.
# A single server listening on both ports would answer the same content over
# cleartext — and any session cookie it set there would cross the network in
# the clear, which is the whole thing TLS was turned on to prevent. Splitting
# the listeners means there is no plain-http code path left to issue one.
#
# The redirect target is the external origin: the plain port's only job is to
# send a browser to the one origin the terminals accept actions from. A `$host`
# target would send it to whatever name it arrived on, whose pages load and
# whose every write is refused.
#
# A render with no origin (no roster, no sidecar) falls back to `$host`. There
# the PORT still comes from render time: `$host` carries the name a client
# asked for but never the port it should be sent to, and on a non-default
# `tls.port` a bare `$host` would bounce every client to 443, where this
# deployment has nothing listening. So that target names the TLS listener
# whenever it is not 443 — and at 443 says nothing, because that is the port
# an `https://` URL with no port already means.
server {
    listen {{ nginx_port }};
    listen [::]:{{ nginx_port }};
    server_name _;

    # Here too: this server sees the same URLs the content server does, tokens
    # included, and one that logged them in the default format would undo the
    # sanitizing next door.
    access_log /dev/stdout osprey_sanitized;

    return 301 {% if external_origin %}{{ external_origin }}{% else %}https://$host{% if tls_port != https_default_port %}:{{ tls_port }}{% endif %}{% endif %}$request_uri;
}
{% endif %}
server {
{%- if tls_enabled %}
    # The sole content server: with TLS on, everything below is reachable only
    # over the encrypted listener.
    listen {{ tls_port }} ssl;
    listen [::]:{{ tls_port }} ssl;
    ssl_certificate {{ tls_cert }};
    ssl_certificate_key {{ tls_key }};
    # HTTP/2 rides on the TLS handshake (ALPN), so it exists only here. It
    # multiplexes every request on one connection, which lifts the browser's
    # six-connections-per-host HTTP/1.1 cap — a hub tab holds several
    # long-lived event streams against that budget. WebSockets are unaffected:
    # the browser opens them on their own HTTP/1.1 connection regardless.
    http2 on;
{% else %}
    listen {{ nginx_port }};
    listen [::]:{{ nginx_port }};
{% endif %}
    server_name {{ origin_host or "_" }};

    # Server level, which is what makes it REPLACE the base image's http-level
    # `access_log ... main;` rather than run alongside it (see the log_format
    # above). Every request this deployment answers is logged through the
    # sanitized format, or not logged at all.
    access_log /dev/stdout osprey_sanitized;

    root /usr/share/nginx/html;
{%- if sidecar_active %}

    # Server level on purpose, so it covers EVERY redirect this server can
    # emit — the login redirect, the `/u/<user>` bookmark 301s, and whatever
    # is added later — not just the one location that first needed it.
    #
    # Left at its default, nginx turns a relative redirect target into an
    # absolute URL built from `$host` plus ITS OWN listening port. That is
    # wrong for precisely the topology `auth.allow_insecure_http` exists to
    # support: with a facility TLS terminator in front, a browser on
    # `https://facility/u/alice` gets walked to `http://facility:10000/u/alice/`
    # — cleartext, where a Secure cookie will not follow and a non-Secure one
    # would be exposed — while advertising the internal port on the way. A
    # relative Location keeps whatever origin the client already had.
    absolute_redirect off;
{%- endif %}

    # Exact match: ONLY the root serves the landing page. Any other path
    # outside a /u/<user>/ mount is a hard 404 — a prefix-catch-all here would
    # answer stray API calls (a panel fetch that lost its /u/<user> prefix)
    # with 200 + landing HTML, hiding the bug behind a JSON parse error.
    location = / {
        try_files /landing.html =404;
    }
{% if services %}

    # What a terminal's location answers while nothing is listening behind it
    # yet: a terminal's app spends tens of seconds starting after its
    # container does, and a browser left open across a restart asks for it
    # throughout. A self-reloading page in place of nginx's bare 502, as a 503
    # with Retry-After, which is what "not available yet, try again" is in
    # HTTP. Reached only through `error_page 502` in those locations, so it
    # stands in for nginx's OWN 502 (no connection to the upstream) and never
    # for a status the app returns: proxy_intercept_errors stays off.
    location @osprey_terminal_starting {
        default_type text/html;
        add_header Retry-After 5 always;
        add_header Cache-Control "no-store" always;
        return 503 '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta http-equiv="refresh" content="5"><title>Terminal starting</title><style>:root{color-scheme:light dark}body{margin:0;min-height:100vh;display:grid;place-items:center;font:16px/1.5 system-ui,sans-serif;background:Canvas;color:CanvasText}main{max-width:32rem;padding:1rem 1.5rem}p{opacity:.75}</style></head><body><main><h1>This terminal is not answering yet</h1><p>It is most likely still starting, which takes up to a minute after a deploy or restart. This page reloads itself every 5 seconds.</p></main></body></html>';
    }
{%- endif %}
{% for svc in services %}
{% if svc.user == "nginx" %}
  {# HARD FAIL: mirrors the same guard in docker-compose.web.yml.j2 — a user
     literally named "nginx" is reserved (see that template's header for why),
     and this template loops over the identical `services` list. #}
  {{ 1 / 0 }}
{% endif %}
    # Reverse proxy to {{ svc.user }}'s loopback upstream (the per-user app's
    # `web` family, bound to loopback only). Trailing slashes on both the
    # location and proxy_pass target strip /u/{{ svc.user }} before the
    # request reaches the upstream.
    location {{ url_mount_root }}/{{ svc.user }}/ {
{% if sidecar_active %}
        # Authentication is on (web_terminals.auth.method is "{{ auth_method }}"):
        # every request that reaches this location — page load, panel API call,
        # WebSocket handshake, SSE stream — is authorized first by the internal
        # subrequest below, which asks the sidecar about {{ svc.user }} and nobody
        # else. A denied subrequest means nginx never opens the upstream
        # connection at all, so an unauthenticated request never touches this
        # user's container.
        auth_request /_osprey_auth/{{ svc.user }};

        # Who the sidecar just said this is, lifted out of the subrequest's own
        # response. `auth_request_set` is the only construct that can do this —
        # a subrequest's response headers are otherwise invisible to the parent
        # request — and it reads `$upstream_http_*`, nginx's spelling of the
        # auth upstream's response header (lowercased, dashes to underscores).
        #
        # The variables are LOCAL to this location and fed by this user's own
        # `auth_request` above, so no user's identity can be observed here but
        # the one this location authorizes. A denied subrequest never reaches
        # the `proxy_pass` at all, so these can only ever hold a value the
        # sidecar returned for an authorization it granted.
        #
        # Any of them may be empty: the sidecar omits a header it has no value
        # for (an OIDC session with no mapped role, say). An empty value makes
        # the `proxy_set_header` below send nothing at all, which is the
        # deny-safe answer — a consumer reads an absent role as no privileges,
        # never as a default one.
        auth_request_set $osprey_auth_account $upstream_http_x_osprey_auth_account;
        auth_request_set $osprey_auth_subject $upstream_http_x_osprey_auth_subject;
        auth_request_set $osprey_auth_role $upstream_http_x_osprey_auth_role;
        auth_request_set $osprey_auth_role_source $upstream_http_x_osprey_auth_role_source;

        # Who a denied subrequest should prompt for. Carried in a variable
        # because the handler below is shared by every user; the value is
        # still a render-time literal, so it names this location's user and
        # cannot be steered by the request. Variables survive the internal
        # redirect into the named location.
        set $osprey_auth_user {{ svc.user }};
        # `=` matters: without it the named location's body would be served
        # under the original 401 status, and a browser does not follow the
        # Location header of a 401. With it, the handler's own status (302 or
        # 401) becomes the response's.
        #
        # This intercepts only nginx's OWN 401 from the auth_request above.
        # A 401 from the upstream app passes through untouched, because
        # proxy_intercept_errors is off by default and this deployment leaves
        # it off — the app's own API errors are its business, not the
        # perimeter's.
        error_page 401 = @osprey_auth_401;
{% endif -%}
{% if inject_secret %}
        # {{ svc.user }}'s operator secret — the credential that user's app
        # authenticates every request against — injected ONLY here, and only
        # under the ONE predicate `inject_secret`:
        #
        #  - Under "password"/"oidc" the sidecar's subrequest gate above stands
        #    in front of this directive, so nothing that failed the gate
        #    reaches the `proxy_pass` below and nothing unauthorized carries
        #    the header upstream.
        #  - Under "none" there is no gate to stand in front of it, and that is
        #    the method's whole content: reaching this port IS the
        #    authorization, and nginx vouches for the request so the browser
        #    needs no `?token=` exchange. The perimeter is the network.
        #  - Under "token" the directive is absent entirely, and the location
        #    CLEARS the header instead (see the branch below). The two are
        #    exhaustive, so the name is claimed by exactly one directive in
        #    every proxying location.
        #  - Because this SETS the header, a client that sends one of its own
        #    has it overwritten rather than forwarded — in every method that
        #    emits it.
        #  - The snippet is per-user: it names {{ svc.user }}'s own variable
        #    ({{ svc.terminal_secret_env }}) and no other, so no terminal is
        #    reachable with a different terminal's secret.
        #
        # The included file is deliberately absent from every rendered
        # artifact. render.py writes it as an nginx *template* next to this
        # conf (nginx/templates/secret-{{ svc.user }}.conf.template), compose
        # mounts that directory read-only at /etc/nginx/templates, and the base
        # image's entrypoint envsubsts it to the path below at container start
        # — so the secret VALUE lives only in the deploy .env and in the
        # container's environment, never on disk in build/ or in an image
        # layer. The entrypoint's output directory is /etc/nginx/osprey and
        # pointedly NOT conf.d, which the base image globs into `http{}`: a
        # secret header set at http level would be sent to every upstream,
        # the auth sidecar included.
        #
        # A missing file is a hard startup failure, which is the right way for
        # this to break: a deployment whose secrets were never minted must not
        # come up serving terminals that trust anything.
        include /etc/nginx/osprey/secret-{{ svc.user }}.conf;
{% endif %}
        # Nothing listening behind this terminal yet: the starting page above.
        error_page 502 = @osprey_terminal_starting;
        proxy_pass http://{{ bind_host }}:{{ svc.web }}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Nothing this perimeter did not itself put there.
        #
        # `Authorization` is a credential nginx never sets on this path, so
        # whatever arrives in it came from the client and means nothing here.
        # The app DOES accept an `Authorization: Bearer` — the panel token, the
        # narrow tier its own tooling authenticates with — and that traffic is
        # loopback INSIDE the container (the workspace hooks post to
        # `http://127.0.0.1:<web>/api/panels`), so it never crosses this proxy
        # and clearing the header costs it nothing. Unconditional, unlike the
        # two below: the header is never legitimate here in any auth mode.
        proxy_set_header Authorization "";
        # The four identity headers — which roster card the request is on, who
        # proved the login, what privilege it holds and where that privilege
        # came from. All four names are written into EVERY proxying location's
        # own header set, by whichever arm of the branch below renders: gated,
        # from the values the sidecar just returned; ungated, as an explicit
        # clear.
        #
        # Naming them is what drops the client's own. nginx builds one
        # proxy-headers table per location and copies the client's remaining
        # headers around it, so a name in that table is answered by its
        # directive and never by the request — including when the directive
        # evaluates EMPTY, which sends nothing rather than falling back to what
        # arrived. A location naming none of them would hand a client's values
        # straight to a container.
        #
        # Only this perimeter may name a user to a terminal: these headers are
        # what a container reads to know who is on the other end of the session,
        # so a client that simply types them would be choosing its own identity
        # — and with authentication off there is no sidecar answer to contradict
        # it. That is why the branch below is EXHAUSTIVE, unlike the cookie
        # handling it shares: no topology this template can render accepts a
        # client-supplied identity, and an auth-off deployment least of all.
        #
        # One directive per name per location, never two. A clear written
        # alongside the forward would be harmless at request time — nginx skips
        # an empty-valued `proxy_set_header` — but it enters the same name in
        # this location's header table twice, which costs a `could not build
        # optimal proxy_headers_hash` warning on every start and every reload,
        # emitted by the security perimeter itself. That is where a recurring
        # warning is most expensive: it is the one an operator learns to scroll
        # past.
{%- if sidecar_active %}
        # Gated: the values this perimeter DID establish, from the
        # `auth_request_set` variables above. Only a gated location has an
        # authorization to speak for. Any of these values may be empty — the
        # sidecar omits a header it has no value for — and an empty one is not
        # sent at all, which is the deny-safe answer and still not the
        # client's: the name is claimed by this directive either way.
        proxy_set_header X-Osprey-Auth-Account $osprey_auth_account;
        proxy_set_header X-Osprey-Auth-Subject $osprey_auth_subject;
        proxy_set_header X-Osprey-Auth-Role $osprey_auth_role;
        proxy_set_header X-Osprey-Auth-Role-Source $osprey_auth_role_source;

        # The browser's cookie header stops here — gated on `sidecar_active`,
        # the SIDECAR's predicate, not on the injection predicate the secret
        # include uses. The two coincide under "password"/"oidc" and part
        # company under "none", deliberately, because what makes the cookie
        # unforwardable is the sidecar's session existing at all:
        #
        # One cookie jar serves this whole origin, so forwarding it would hand
        # {{ svc.user }}'s container the sidecar's `osprey_auth_session` — the
        # cookie that unlocks every user this operator has open — and these
        # containers run agent-generated code, which makes anything readable
        # inside one a credential that has effectively left the perimeter. The
        # app's own `osprey_terminal_session_<port>` cookie is cut with it, and
        # nothing is lost: that cookie is the gate for locations which get no
        # header, and this location gets one.
        #
        # Under "none" there is no sidecar and so no `osprey_auth_session` to
        # leak, and the app's own session still carries per-user state — so
        # that method narrows the jar to one cookie (the branch below) rather
        # than cutting it.
        #
        # Within a sidecar method the two halves must never be gated apart.
        # Strip without header is a location that authenticates nothing and
        # 401s every request; header without strip lets an unauthenticated
        # request carry an operator's session cookie into a container.
        proxy_set_header Cookie "";
{%- else %}
{%- if inject_secret %}
        # No sidecar vouched for this request; nginx itself injects this
        # user's operator secret below. There is no authorization to speak
        # for, so all four identity names are CLEARED here rather than
        # forwarded: forwarding would announce a subject the perimeter never
        # checked, and leaving the names unwritten would let the client supply
        # them itself.
{%- else %}
        # Ungated — authentication is off. There is no authorization to speak
        # for, so all four identity names are CLEARED here rather than
        # forwarded: forwarding would announce a subject the perimeter never
        # checked, and leaving the names unwritten would let the client supply
        # them itself.
{%- endif %}
        proxy_set_header X-Osprey-Auth-Account "";
        proxy_set_header X-Osprey-Auth-Subject "";
        proxy_set_header X-Osprey-Auth-Role "";
        proxy_set_header X-Osprey-Auth-Role-Source "";
{%- if inject_secret %}
        # No clear for the operator-secret header here, and its absence is
        # load-bearing rather than an omission: the `include` above already
        # names that header in this location's table, and a second directive
        # for one name is what makes nginx log `could not build optimal
        # proxy_headers_hash` on every start and every reload.
        #
        # The client's own value is dropped all the same. nginx answers a named
        # header from the location's table and never from the request, so the
        # snippet's `proxy_set_header` overwrites an arriving one exactly as a
        # clear would — this location simply claims the name by SETTING it
        # instead of by emptying it.
{%- else %}
        # No operator secret is injected into this location — authentication is
        # off — so the two headers that carry one are handled the other way
        # round from the gated branch above.
        #
        # The secret header is CLEARED rather than left alone. nginx sets it on
        # gated locations only, so a value arriving here came from the client;
        # forwarding it would let anyone who can reach this port present a
        # credential the app trusts absolutely, which is the one thing this
        # carrier exists to make impossible.
        proxy_set_header X-Osprey-Terminal-Secret "";
{%- endif %}
{%- if inject_secret %}
        # The jar is narrowed rather than cut, and for a different reason than
        # the strip in the gated arm above: there is no sidecar in this
        # posture, so no origin-wide `osprey_auth_session` to leak. The app
        # still keeps its own per-user session, so its cookie travels below.
{%- else %}
        # Exactly ONE cookie is forwarded: the session cookie {{ svc.user }}'s own
        # app issues. It cannot be cut — with nothing injected here, that cookie
        # IS the only gate left in front of this terminal — but the rest of the
        # jar has no business travelling. Cookies ignore ports, so one jar
        # serves this whole origin: the raw `Cookie` header names every OTHER
        # terminal this browser has unlocked (`osprey_terminal_session_<port>`,
        # one per user) and, with auth on, the sidecar's origin-wide
        # `osprey_auth_session` as well. These containers run agent-generated
        # code, so anything readable inside one is a credential that has left
        # the perimeter.
        #
        # The name is a render-time literal from the app's own
        # `session_cookie_name()` (render.py resolves `svc.session_cookie`), so
        # the perimeter and the app cannot spell it differently. An absent
        # cookie substitutes to empty, which the app reads as no credential —
        # the same answer it gives to a request that sent none.
{%- endif %}
        proxy_set_header Cookie "{{ svc.session_cookie }}=$cookie_{{ svc.session_cookie }}";
{%- endif %}
        proxy_buffering off;
        proxy_read_timeout 3600s;
        # Nginx's own default (1m) is smaller than the feedback form's upload
        # cap — a screenshot attached to a bug report would 413 here before
        # the request ever reaches {{ svc.user }}'s app. Stated explicitly so
        # the limit is this proxy's contract, not an inherited default that
        # would silently shrink if the base image's own default ever changes.
        client_max_body_size 4m;
    }

    # Stable bookmark for {{ svc.user }} without a trailing slash.
    location = {{ url_mount_root }}/{{ svc.user }} {
        return 301 {{ url_mount_root }}/{{ svc.user }}/;
    }
{% if sidecar_active %}

    # {{ svc.user }}'s own auth target — the only thing the `auth_request` above
    # can reach. There is one of these per roster user, and the `?user=` it asks
    # the sidecar about is a RENDER-TIME LITERAL: no part of the client's
    # request (path, header, cookie) selects which user is being authorized, so
    # the sidecar never has to reconstruct the identity from $request_uri or
    # X-Original-URI — the two places a crafted URL could otherwise smuggle a
    # different username in. `internal` keeps the path unreachable from outside.
    location = /_osprey_auth/{{ svc.user }} {
        internal;
        proxy_pass http://{{ bind_host }}:{{ auth_port }}/verify?user={{ svc.user }};
        # Load-bearing, not an optimization. An auth subrequest inherits the
        # parent request's headers, so without these two directives a POST's
        # Content-Length is announced to the sidecar, which reads no body and
        # replies immediately — leaving the announced bytes unsent and the
        # subrequest hanging until it times out. Every authenticated POST (chat
        # message, file write, approval) would stall. `proxy_pass_request_body
        # off` suppresses the body; clearing Content-Length stops nginx
        # advertising a body it will not send.
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        # For the same reason, and it is easy to miss: a subrequest inherits the
        # PARENT request's headers, so a client that sent its own identity
        # headers would have them arrive at `/verify` looking like something
        # this perimeter established. The sidecar decides who the user is from
        # the session cookie and the render-time `?user=` above, and must never
        # see a value the request supplied. The clear lives in this location
        # rather than at server level because a location-level
        # `proxy_set_header` — the ones below — replaces the whole inherited
        # set, so a server-level clear would be discarded right here.
        proxy_set_header X-Osprey-Auth-Account "";
        proxy_set_header X-Osprey-Auth-Subject "";
        proxy_set_header X-Osprey-Auth-Role "";
        proxy_set_header X-Osprey-Auth-Role-Source "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # This subrequest sits in front of EVERY gated request, so its worst
        # case is the deployment's worst case. Answering it is a signature
        # check against process-local state over loopback — microseconds — so
        # nginx's 60s defaults describe nothing this can legitimately do, and
        # would let one wedged sidecar hold every open terminal's next request
        # for a minute before failing it. Failing in seconds turns that into a
        # visible error instead of a hang.
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
    }
{% endif -%}
{% endfor %}
{% if sidecar_active %}

    # The public login surface — the ONE place under this origin that answers
    # without a session, because it is where a session comes from. Everything
    # the sidecar serves publicly lives under this prefix: the login page and
    # its assets, the credential POST, the OIDC callback, and logout. No
    # `auth_request` here, by necessity: gating the login page behind a session
    # is a locked door whose key is inside the room.
    #
    # `/verify` is NOT reachable through this prefix — it is not under /auth/,
    # and the per-user targets that call it are `internal`. The landing page at
    # `= /` likewise stays public and ungated (it is the identity chooser, and
    # it is what the nginx container's own healthcheck probes); the per-user
    # apps' `/health` routes sit behind their user's gate on purpose, so an
    # expired session makes an open terminal's probe 401 and reload.
    # What a denied `auth_request` turns into, for every user. Reached only by
    # the `error_page 401` above — it is a named location, so nothing routes
    # here from outside.
    #
    # `if` is safe here in a way it famously is not elsewhere in nginx: a
    # location-level `if` containing nothing but `return` is one of the two
    # constructs documented as fully defined behaviour. There is no
    # proxy_pass, no rewrite, and no second directive inside it.
    location @osprey_auth_401 {
        # The return-to is `$osprey_auth_next` — the ALLOWLISTED form of the
        # path (see the map above) — and never `$uri` itself. Neither is
        # `$request_uri` the answer: it is injection-safe, being still
        # percent-encoded, but it carries whatever the client typed, including
        # a leading `//` that a browser reads as an absolute URL and follows
        # off-site. One variable is unsafe to emit, the other is unsafe to
        # trust; the map is what makes a value both.
        #
        # The query string is dropped with all of this — a deliberate trade,
        # since the terminal's own state does not live in one. The sidecar
        # still treats `next` as untrusted input.
        if ($osprey_auth_wants_login_page) {
            return 302 /auth/login?user=$osprey_auth_user&next=$osprey_auth_next;
        }
        # Programs get the status, not a page: a bare 401 is what the app's
        # WebSocket/SSE close handlers probe for to decide the session died.
        return 401;
    }

    location /auth/ {
        proxy_pass http://{{ bind_host }}:{{ auth_port }}/auth/;
        # This prefix is deliberately ungated — it is where a session comes
        # from — which makes it the surface an unauthenticated client can
        # always reach, and so the one it would forge an identity into. The
        # login flow establishes identity from credentials it verifies;
        # nothing it serves may read one out of the request.
        proxy_set_header X-Osprey-Auth-Account "";
        proxy_set_header X-Osprey-Auth-Subject "";
        proxy_set_header X-Osprey-Auth-Role "";
        proxy_set_header X-Osprey-Auth-Role-Source "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Stated outright rather than left to defaults or to whatever the
        # terminal locations above need. The login flow is a handful of short
        # request/response round trips against a loopback service — it has no
        # long-poll, no stream, and nothing to keep open — so a sidecar that
        # is wedged should surface as a prompt error in seconds, not as a
        # browser tab that hangs for a minute on a dead upstream.
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
    }
{% endif %}
}
{%- if origin_host %}

# The terminals accept actions only from the one origin, so a page served under
# another name would load and then refuse every write. This server sends every
# name the content server does not claim to the origin instead, path and query
# intact. `server_name` matches the host alone, so the origin's host on any port
# still reaches the content server.
{%- if tls_enabled %}
#
# The certificate is repeated because nginx needs one to complete a handshake
# for a name the content server does not claim. A client that sent no SNI, or a
# different one, sees this certificate and then the redirect.
{%- endif %}
server {
{%- if tls_enabled %}
    listen {{ tls_port }} ssl default_server;
    listen [::]:{{ tls_port }} ssl default_server;
    ssl_certificate {{ tls_cert }};
    ssl_certificate_key {{ tls_key }};
{%- else %}
    listen {{ nginx_port }} default_server;
    listen [::]:{{ nginx_port }} default_server;
{%- endif %}
    server_name _;

    # The sanitized format applies here too.
    access_log /dev/stdout osprey_sanitized;

    return 301 {{ external_origin }}$request_uri;
}
{%- endif %}
{%- if reader_server %}

# ---------------------------------------------------------------------------
# The readers' origin.
#
# A second server on its own port, so it is its own browser origin: the people
# who read the telemetry store with a key reach it here, and nothing a page on
# this origin does can touch a terminal's session on the other one. It answers
# two paths of the store and refuses every other — the store's HTTP interface
# also serves its dashboards, its docs and a terminal, and none of those is
# offered to a reader.
#
# The store itself decides who a reader is and what they may read. This server
# adds no account, no rate limit and no rewriting of what a reader asked: a key
# is a long random token, and each reader's quota and query slots are the
# store's own.

# Whether a request names no account at all. The store's query page sends
# `Authorization: never` and carries the account as `user` and `password`
# parameters; every other client sends a Basic header. A request with none of
# the three is one nginx answers itself, with the challenge a browser and
# `curl -u` both understand, instead of letting it reach the store as its
# default account.
map "$http_authorization$arg_user$arg_password" $osprey_reader_anonymous {
    "" 1;
    default 0;
}

# The query string sent upstream: the reader's own, with one parameter added
# behind it. `http_wait_end_of_query` makes the store finish a query before it
# starts answering, so a query that fails or is cut by a limit answers with an
# error status rather than with a 200 whose body stops halfway. Appended to
# what the reader sent, never edited into it: nginx cannot find a parameter
# that is percent-encoded or repeated, and the store's account settings already
# refuse the parameters that would undo this one.
map $args $osprey_reader_query {
    "" "http_wait_end_of_query=1";
    default "$args&http_wait_end_of_query=1";
}

# `$uri`, never `$request_uri`: the query page carries a reader's key in the
# query string, and a log line holding it would be a second copy of the key.
log_format osprey_reader '$remote_addr - $remote_user [$time_local] '
                         '"$request_method $uri $server_protocol" '
                         '$status $body_bytes_sent';
{%- if history_location %}

# Whether a request for the history page was made by a page on another origin
# for anything but a top-level navigation. The session cookie is `SameSite=Lax`
# and the terminals' origin is the same site as this one, so a page served
# there — agent-authored HTML among them — could frame the history page, or
# load it as an image or a script, with the viewer's cookie attached. The
# same-origin policy keeps it from reading the answer, but every such load
# would still be asked of the store as the viewer, against the viewer's quota.
# A link opened from the terminals, and the way back from signing in, are
# top-level navigations and pass; the page's own requests are same-origin and
# pass. A browser that sends no fetch metadata passes too: the page's
# `frame-ancestors` and resource policy below still stand in front of it.
# Regexes are tried in order and the first match wins, so the navigation is
# exempted before the refusal.
map "$http_sec_fetch_site:$http_sec_fetch_mode:$http_sec_fetch_dest" $osprey_history_embedded {
    default 0;
    "~^(same-site|cross-site):navigate:document\z" 0;
    "~^(same-site|cross-site):" 1;
}

# The history path a signed-out visitor is returned to after signing in. An
# allowlist, for the reason the terminals' return-to map is one: `$uri` is the
# decoded path, and a `return 302` copies it into the Location header verbatim,
# so a CR LF or an `&` in a crafted link would otherwise reach it. Anything else
# is the page itself, because the sign-in accepts a return to this origin only
# under `/history/`. The query string, the page's selection among them, is
# dropped: the page opens on the default selection.
map $uri $osprey_history_next {
    default "/history/";
    "~^/history/[A-Za-z0-9._~/-]*\z" $uri;
}
{%- endif %}

server {
{%- if tls_enabled %}
    listen {{ reader_port }} ssl;
    listen [::]:{{ reader_port }} ssl;
    ssl_certificate {{ tls_cert }};
    ssl_certificate_key {{ tls_key }};
    http2 on;
{%- else %}
    listen {{ reader_port }};
    listen [::]:{{ reader_port }};
{%- endif %}
    server_name _;

    # Server level, which is what replaces the base image's http-level
    # `access_log` instead of adding a line beside it.
    access_log /dev/stdout osprey_reader;
    # An error line quotes the whole request line, key and all, so only the
    # conditions that stop this server from serving are written.
    error_log /dev/stderr crit;

    # A relative redirect stays relative. Left on, nginx would rebuild it from
    # the name and the port it listens on, which is not the address a browser
    # behind a load balancer is on.
    absolute_redirect off;

    # The query page pings its origin with an OPTIONS request before it
    # connects. Nothing else lives at the root.
    location = / {
        if ($request_method = OPTIONS) {
            return 204;
        }
        return 404;
    }

    # The query endpoint. Exact match: one path reaches the store's query
    # interface, and it always arrives there as `/`.
    location = /telemetry/ {
        if ($osprey_reader_anonymous) {
            return 401;
        }
        error_page 401 @osprey_reader_401;

        # Loopback, where the store publishes whatever address this deployment
        # binds its other services to.
        proxy_pass http://127.0.0.1:{{ reader_store_port }}/?$osprey_reader_query;
        proxy_http_version 1.1;
        # The store answers nothing until the query is done, and its own limit
        # is what ends a slow one.
        proxy_read_timeout {{ reader_read_timeout }}s;

        # Only the headers a query needs go upstream. The store reads several
        # others as instructions (an account, a quota key, a session, a
        # forwarded address), and none of those is a reader's to give. The body
        # length is nginx's own count of what it forwards.
        proxy_pass_request_headers off;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Content-Encoding $http_content_encoding;
        proxy_set_header Accept-Encoding $http_accept_encoding;

        # The store allows every origin to read its answers; this one is read
        # by its own pages only.
        proxy_hide_header Access-Control-Allow-Origin;
        # A reader may name response headers for a query (`http_response_headers`,
        # which is how Download names its file). Of those, the ones a browser
        # acts on beyond the answer itself never leave this server: no cookie,
        # redirect, link, stored policy, report endpoint or cross-origin grant
        # is a reader's to set on this host, which the terminals share. The
        # headers nginx itself acts on are read as data, so a query cannot send
        # this server to another of its locations.
        proxy_hide_header Set-Cookie;
        proxy_hide_header Refresh;
        proxy_hide_header Location;
        proxy_hide_header Link;
        proxy_hide_header Clear-Site-Data;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header Alt-Svc;
        proxy_hide_header NEL;
        proxy_hide_header Report-To;
        proxy_hide_header Reporting-Endpoints;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Content-Security-Policy-Report-Only;
        proxy_hide_header Access-Control-Allow-Credentials;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Expose-Headers;
        proxy_hide_header Access-Control-Allow-Private-Network;
        proxy_ignore_headers X-Accel-Redirect X-Accel-Expires X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset;
        # A result is data. Whatever a query returns, no browser may sniff it
        # into a document or run it as one.
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
    }

    # Reached only through the `error_page` above.
    location @osprey_reader_401 {
        add_header WWW-Authenticate 'Basic realm="telemetry"' always;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        return 401;
    }

    # The store's query page.
    location = /telemetry/play {
{%- if reader_play_script_sha256 %}
        if ($request_method != GET) {
            return 405;
        }
        # The page queries the address in its `url` parameter and, without
        # one, its own — which answers nothing here. A link that lost the
        # parameter is sent back with this origin's query endpoint in it, and
        # with whatever else it carried. The endpoint is spelled at render
        # time: behind a load balancer the scheme and the name a request
        # arrives with are this server's, not the browser's.
        if ($arg_url = "") {
            return 302 {{ reader_play_redirect }}&$args;
        }
        # The page reads its parameters in the browser; the store is asked
        # for the page alone, so no key in the address reaches it or its log.
        # A target holding a variable is sent as written, with no query string
        # added behind it.
        set $osprey_reader_play /play;
        proxy_pass http://127.0.0.1:{{ reader_store_port }}$osprey_reader_play;
        proxy_pass_request_headers off;
        proxy_hide_header Access-Control-Allow-Origin;

        # The page is one document with one inline script, and that script is
        # the only code this origin lets a browser run: it is named by its
        # hash, which is a constant per store image. No `'self'` anywhere a
        # script could come from, so a query result served by this origin can
        # never be loaded as one. `wasm-unsafe-eval` is for the page's own
        # query lexer, which it compiles on load. Form posts are allowed to this
        # origin only, because the page's Download form posts to this origin's
        # query endpoint.
        add_header Content-Security-Policy "default-src 'none'; script-src 'sha256-{{ reader_play_script_sha256 }}' 'wasm-unsafe-eval'; style-src 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
        add_header X-Content-Type-Options nosniff always;
{%- else %}
        # `services.telemetry_store.image` names a tag whose query page has no
        # entry in PLAY_SCRIPT_SHA256 (osprey.deployment.telemetry_config), so
        # nothing vouches for the script it would run. Add the tag there, as
        # that constant describes, and the page is served again.
        return 404;
{%- endif %}
    }
{%- if history_location %}

    # The history page: the agent record of the sessions a signed-in person may
    # see. The sidecar decides who the browser is and what they may see; the
    # history app reads that answer from the headers below and from nothing
    # the browser sent. Trailing slashes on both the location and the target
    # strip `/history` before the request reaches the app, which writes it back
    # onto every link it renders.
    location /history/ {
        # Refused before the sign-in is asked about, so an embed spends
        # nothing. It is answered with the 403 page below, which the policy on
        # that page keeps any embedding page from showing.
        if ($osprey_history_embedded) {
            return 403;
        }
        auth_request /verify-history;

        # Who the person is, which view of the store they read through, and
        # which selections their sign-in offers, lifted out of the sidecar's
        # answer. An optional one the sidecar omits is sent as nothing.
        auth_request_set $osprey_history_person $upstream_http_x_osprey_history_person;
        auth_request_set $osprey_history_scope $upstream_http_x_osprey_history_scope;
        auth_request_set $osprey_history_view $upstream_http_x_osprey_history_view;
        auth_request_set $osprey_history_role $upstream_http_x_osprey_history_role;
        auth_request_set $osprey_history_tables $upstream_http_x_osprey_history_tables;
        auth_request_set $osprey_history_entry $upstream_http_x_osprey_history_entry;
        auth_request_set $osprey_history_choices $upstream_http_x_osprey_history_choices;

        # A signed-out navigation is sent to the terminals' sign-in; anything
        # else gets the bare status. `=` lets the handler's own status stand.
        error_page 401 = @osprey_history_401;
        # A sign-in that names no roster person. No `=`: the page is served
        # under the sidecar's 403. The app's own 403s pass through untouched,
        # because proxy_intercept_errors stays off.
        error_page 403 /history-403.html;

        # The gate secret the history app accepts, from the snippet nginx's
        # entrypoint substitutes at start (see the terminals' `include` for the
        # mechanism). Reached only after the sign-in check above.
        include /etc/nginx/osprey/{{ history_gate_snippet }}.conf;
        proxy_pass http://127.0.0.1:{{ history_port }}/;
        proxy_http_version 1.1;

        # Only the request headers a page load needs go upstream, by name, so
        # no header a browser types — an identity, a credential, a forwarded
        # address — reaches the app as though this perimeter had set it.
        # `Origin` and `Sec-Fetch-Site` stay: they are what the app's own
        # cross-origin check reads on a request that writes.
        proxy_pass_request_headers off;
        proxy_set_header Host $host;
        proxy_set_header Accept $http_accept;
        proxy_set_header Accept-Encoding $http_accept_encoding;
        proxy_set_header Accept-Language $http_accept_language;
        proxy_set_header If-Modified-Since $http_if_modified_since;
        proxy_set_header If-None-Match $http_if_none_match;
        proxy_set_header User-Agent $http_user_agent;
        proxy_set_header Origin $http_origin;
        proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Osprey-History-Person $osprey_history_person;
        proxy_set_header X-Osprey-History-Scope $osprey_history_scope;
        proxy_set_header X-Osprey-History-View $osprey_history_view;
        proxy_set_header X-Osprey-History-Role $osprey_history_role;
        proxy_set_header X-Osprey-History-Tables $osprey_history_tables;
        proxy_set_header X-Osprey-History-Entry $osprey_history_entry;
        proxy_set_header X-Osprey-History-Choices $osprey_history_choices;
        # Claimed as clears as well, as in every proxying location of this
        # template: the terminals' identity, a credential, and the cookie jar,
        # whose session cookie unlocks every terminal this browser has open.
        proxy_set_header X-Osprey-Auth-Account "";
        proxy_set_header X-Osprey-Auth-Subject "";
        proxy_set_header X-Osprey-Auth-Role "";
        proxy_set_header X-Osprey-Auth-Role-Source "";
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";

        # The page loads its own resources and nothing else, and no other page
        # may frame it or load it as a resource of its own.
        add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'" always;
        add_header Cross-Origin-Resource-Policy same-origin always;
        add_header X-Content-Type-Options nosniff always;
    }

    # Stable bookmark without a trailing slash.
    location = /history {
        return 301 /history/;
    }

    # The history page's auth target. `internal` keeps it unreachable from
    # outside; the sidecar serves it outside its public `/auth/` prefix for the
    # same reason.
    location = /verify-history {
        internal;
        proxy_pass http://{{ bind_host }}:{{ auth_port }}/verify-history;
        # A subrequest carries no body and announces none (see the terminals'
        # auth target for why both lines are needed).
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        # The page's selection among the person's sign-ins travels in the query
        # string, which the subrequest's own URI does not carry.
        proxy_set_header X-Original-URI $request_uri;
        # A subrequest inherits the client's headers; the sidecar reads the
        # session cookie and the URI above, never an identity the request
        # supplied.
        proxy_set_header X-Osprey-Auth-Account "";
        proxy_set_header X-Osprey-Auth-Subject "";
        proxy_set_header X-Osprey-Auth-Role "";
        proxy_set_header X-Osprey-Auth-Role-Source "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
    }

    # What a refused history sign-in check turns into. A navigation goes to the
    # terminals' sign-in, which is on their origin: this one has none. It is
    # sent back here afterwards, to the allowlisted path.
    location @osprey_history_401 {
        if ($osprey_auth_wants_login_page) {
            return 302 {{ history_sign_in }}$osprey_history_next;
        }
        return 401;
    }

    # Reached only through the `error_page 403` above.
    location = /history-403.html {
        internal;
        default_type text/html;
        charset utf-8;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        add_header Cross-Origin-Resource-Policy same-origin always;
        add_header X-Content-Type-Options nosniff always;
        return 403 '<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>History</title></head>
<body>
<h1>No sessions to show</h1>
<p>Your sign-in names no roster person, so there are no sessions for this page to show you.</p>
<p>Sessions recorded under a shared card are shown to people who may see every session.</p>
</body>
</html>
';
    }

    # Sign-out, for a person who signed in to read the history page. The
    # sidecar returns the browser only to a path it accepts.
    location = /auth/logout {
        proxy_pass http://{{ bind_host }}:{{ auth_port }}/auth/logout;
        proxy_set_header X-Osprey-Auth-Account "";
        proxy_set_header X-Osprey-Auth-Subject "";
        proxy_set_header X-Osprey-Auth-Role "";
        proxy_set_header X-Osprey-Auth-Role-Source "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
    }
{%- endif %}

    # Every other page of the store's HTTP interface.
    location /telemetry/ {
        return 404;
    }

    location / {
        return 404;
    }
}
{%- endif %}
