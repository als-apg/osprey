{#
  docker-compose.web.yml.j2 — multi-user web-terminal stack overlay.

  Rendered by render_web_terminals() (src/osprey/deployment/web_terminals/
  render.py) with a Jinja2 Environment that has autoescape=False — this emits YAML,
  not HTML, and autoescape would corrupt env values containing "&", "<", etc. Added
  to `runtime.compose_files` alongside the base docker-compose.yml.

  ----------------------------------------------------------------------------
  TEMPLATE CONTRACT (variables render.py MUST supply)
  ----------------------------------------------------------------------------

    facility_prefix: str
      `facility.prefix` from the deployed project's config (e.g. "als"). Used for
      container_name (`<prefix>-web-<user>`, `<prefix>-nginx`) only — the
      per-user agent-data mount path comes from each service's own
      `container_agent_data_dir` (below), not this field, so a persona-resolved
      user's mount can differ from the facility-prefix default.

    registry_url: str
      `registry.url` from the deployed project's config. NOT read directly by this
      template's per-user image line (that comes pre-resolved as `svc.image`,
      below) — kept in the render context for the nginx/landing sibling
      templates and any future use, per the same convention as the
      `ariel-sync` service in templates/core/docker-compose.yml.

    services: list[dict], required (may be empty — the 0-user case)
      ONE entry per configured user, PRE-BUILT by render.py from
      `resolve_personas()` (deployment/web_terminals/ports.py) +
      `allocate_ports()` — persona resolution and port arithmetic both stay
      in Python; this template only iterates. Each entry is
      `{"user": str, "image": str, "project": str, "container_project_dir": str,
      "container_agent_data_dir": str, "extra_mounts": list,
      "display_name": str | None, "panel_env": list,
      **allocate_ports(base_ports, index)}`:
        {
          "user": str,                  # bare username, e.g. "thellert"
          "image": str,                 # resolved by resolve_personas() -> per-svc `image:`
          "project": str,               # resolved by resolve_personas() (not read by this template)
          "container_project_dir": str, # resolved by resolve_personas(); the in-container
                                        #   project root (not read directly by this template)
          "container_agent_data_dir": str,
                                        # where this user's agent-data volume mounts, i.e. the
                                        #   directory the agent inside the container writes to.
                                        #   Built by render._container_agent_data_dir() from
                                        #   `agent_data.base_dir` anchored on container_project_dir,
                                        #   so the mount follows the same key the agent resolves,
                                        #   whenever the deployed config and the persona image's
                                        #   config agree on it.
                                        #   Joined in Python, not here: an ABSOLUTE base_dir must
                                        #   not be re-anchored under the project directory.
          "container_bundle_dir": str | None,
                                        # where the DEPLOYMENT's facility-knowledge bundle
                                        #   mounts for this user, or None when the user is not
                                        #   entitled (its persona's project names no
                                        #   `facility_knowledge.bundle_path`) or the deployment
                                        #   configures no bundle at all. Built by
                                        #   render._container_bundle_dir() from that key anchored
                                        #   on container_project_dir — per service, because two
                                        #   personas read the bundle at two different paths.
                                        #   Joined in Python for the same reason as
                                        #   container_agent_data_dir above.
                                        #   Pairs with the file-level `facility_bundle_source`.
          "container_mirror_dir": str | None,
                                        # where the DEPLOYMENT's ARIEL qmd mirror mounts for
                                        #   this user, or None when the user is not entitled
                                        #   (its persona's project runs no qmd export) or the
                                        #   deployment writes no mirror. Built by
                                        #   render._container_mirror_dir() from
                                        #   `qmd_export.mirror_path` anchored on
                                        #   container_project_dir — the path this persona's own
                                        #   exporter writes. Pairs with the file-level
                                        #   `ariel_mirror_source`.
          "audit_identity": str,        # WHO this container's audit records are written as —
                                        #   the roster user name (OSPREY_AUDIT_IDENTITY).
          "container_audit_dir": str,   # where those records are written inside the container
                                        #   (`<container_project_dir>/var/audit/<identity>`,
                                        #   render._container_audit_dir()).
          "audit_mount_source": str,    # the host directory backing it, spelled as a compose
                                        #   bind source (`./var/audit/<identity>`,
                                        #   render._audit_mount_source()).
          "extra_mounts": [str, ...],   # resolved by resolve_personas() from the persona's
                                        #   `extra_mounts` -> extra per-user `volumes:` lines
                                        #   (compose volume strings, e.g. "/opt/data:/app/data:ro").
                                        #   Empty list (the default) emits none.
          "display_name": str | None,   # optional window/tab title -> OSPREY_WEB_APP_NAME;
                                        #   None (the default) emits NO env line — see below
          "web": int,        # web_base_port + index -> OSPREY_WEB_PORT / OSPREY_TERMINAL_WEB_PORT
          "panel_env": [     # ONE entry per FRAMEWORK_WEB_SERVERS companion family,
            {"name": str,    #   derived by render.py from the registry's port_env_var
             "port": int},   #   + `<family>_base_port + index` (ports.PANEL_ENV_VARS)
            ...              #   — the template only iterates; hand-listing env vars
          ],                 #   here is what would let a panel miss multi-user wiring
        }
      (allocate_ports() also merges each companion family's port under its
      family name — e.g. "artifact": int — for callers/tests; this template
      reads only "web" and "panel_env".)
      A no-personas config resolves every entry's `image` to
      `<registry_url>/web-terminal:latest` and every entry's
      `container_project_dir` to `/app/<facility_prefix>-assistant` (see
      resolve_personas()'s docstring). render.py MUST NOT include an entry
      whose "user" is "nginx" (reserved service name; enforced by the lint
      against the roster).
      This template ALSO refuses to render such a `services` list (see the
      loop below) — belt-and-suspenders, because a `services:` mapping with
      two `nginx:` keys wouldn't fail loudly on its own: PyYAML silently
      keeps the last duplicate key, so the whole nginx service would just
      vanish with no error if the lint didn't run first.

    facility_bundle_source: str, required (may be "")
      The deployment's facility-knowledge bundle on the HOST, spelled as a compose
      bind source (`./data/facility_knowledge`, or an absolute path verbatim).
      ONE directory for every user — the corpus is shared, not copied per user —
      paired with each service's own `container_bundle_dir` target. `""` when the
      deployment configures no `facility_knowledge.bundle_path`, which emits no
      mount for anyone. Note this mount SHADOWS whatever the persona image baked
      at that path; the reasoning is at the mount line itself.

    ariel_mirror_source: str, required (may be "")
      The deployment's ARIEL qmd mirror on the HOST, spelled as a compose bind
      source the same way as `facility_bundle_source`, and paired with each
      service's own `container_mirror_dir` target. ONE directory for every user
      and for the host's own exporter — the sidecar indexes the union. `""` when
      the deployment runs no qmd export, which emits no mount for anyone.

    ariel_mirror_gid: str, required (may be "")
      Group id of that host directory, for the same `group_add:` reason as
      `facility_bundle_gid` below.

    facility_bundle_gid: str, required (may be "")
      Group id of that host directory, read off disk by the deploy and emitted as
      `group_add:` on every entitled service. Setgid decides which group OWNS a
      new file, not which groups a process belongs to, so membership has to be
      granted separately: this gid is the RUNTIME half of that grant, reaching
      the container's initial process. In a framework-built image the membership
      the serving process keeps comes from the entrypoint's own `/etc/group` join
      for OSPREY_FACILITY_BUNDLE_DIR instead, because `gosu` re-derives
      supplementary groups from that file and discards the runtime grant; the
      runtime half is what carries access when that join never runs (a container
      started with `--user`, or an image with no OSPREY entrypoint). Reasoning at
      the `group_add:` line itself. `""` (directory not provisioned yet, or a
      platform with no gids) emits no `group_add` rather than a guess.

    nginx_port: int, required
      Host port nginx publishes for the landing page + per-user redirects.

    landing_url: str, required when `services` is non-empty
      The fully-qualified origin browsers use to reach nginx, e.g.
      "http://als-deploy.lbl.gov:9080" (scheme + deploy host + nginx_port, no
      trailing slash). Passed to every per-user service as
      OSPREY_TERMINAL_LANDING_URL so the in-app logout control has a target.
      This can't be computed the way nginx.conf.j2 computes its targets (from
      request-time `$host`) — env vars are baked in at container start — so
      render.py must resolve it once, typically from `deploy.host` + this
      same `nginx_port`.

    nginx_image: str, optional, default "nginx:1.27-alpine"
    facility_timezone: str, optional, default "UTC" -> TZ

    tls_host_cert_dir: str | None, tls_mount_target: str | None
      Together they render nginx's one optional volume: the operator's
      certificate directory on the DEPLOY HOST, mounted read-only at the
      in-container directory `tls.cert` names. Both come from
      `_auth_tls_context()`; `tls_mount_target` is derived from `tls.cert`
      rather than configured, so the mount cannot land somewhere other than
      where the `ssl_certificate` directive looks. When `tls_host_cert_dir` is
      None the volume list renders byte-identically to a no-TLS deployment and
      the operator supplies the mount from their own compose file.

    AUTH SIDECAR (all from render.py's `_auth_tls_context()`, the single parser
    of `modules.web_terminals.auth`/`tls` — this template re-parses nothing):

    auth_method: str, required ("none" | "password" | "oidc")
      "none" (the default posture) renders NO `auth:` service at all — the
      whole block below is suppressed, byte for byte, so a deployment that has
      not opted into authentication carries no login surface.
    auth_port: int, required
      Host port the sidecar's uvicorn binds — on `bind_host` only, exactly like
      the per-user apps. nginx (same host netns) is the only thing that reaches
      it; `auth_request` subrequests and the `/auth/*` login flow both proxy
      there. Joined into lint's port-collision check against the per-user
      families, so this port is guaranteed not to be some user's panel port.
    auth_session_lifetime: int, required (seconds) -> OSPREY_AUTH_SESSION_LIFETIME
    auth_image: str | None
      Registry-mode image for the sidecar. When unset, the local-build tag
      `<facility_prefix>-assistant-auth:local` is referenced instead — the
      suffixed local-tag pattern personas.py keeps for entries without their
      own render (`<project>-<suffix>:local`) applied to the sidecar, whose
      `<project>` is resolve_personas()'s default `<facility_prefix>-assistant`.
      Producing that image is the runtime build's job; this template only
      names the tag.
    auth_oidc_issuer: str | None, auth_oidc_client_id_env / auth_oidc_client_secret_env: str
      Emitted only in `oidc` mode. The two `*_env` values are env-var NAMES, not
      credentials: the sidecar reads the named variable out of its `.env.auth`
      environment (one level of indirection, so a facility keeps its own
      variable names). No credential is ever rendered here.
    auth_oidc_claim: str | None
      Which ID-token claim carries the identity to map onto a roster user.
      `None` (the common case) emits NO env line, leaving the sidecar's own
      documented default — so the default is defined once, in the sidecar,
      rather than restated here.
    authorization_claim: str | None / authorization_claim_map: {claim value: role}
      The group binding, from render.py's `_authorization_context()` (the single
      parser of `modules.web_terminals.authorization`) -> OSPREY_AUTH_ROLE_CLAIM
      and OSPREY_AUTH_ROLE_MAP. Emitted only in `oidc` mode: the claim is read
      out of an ID token, and a password login has none — that posture's role
      comes from the roster entry instead.
      Both lines or neither, never one. The sidecar reads half a binding as a
      broken deployment and refuses every login needing a role
      (`RoleBinding.configured` is `claim OR claim_map`), which is the right
      reading for a deployment that LOST a half and the wrong one to render for
      a deployment that never declared either.
    services[].oidc_subject: str, optional — this user's expected IdP identity
      (the non-secret half of the roster->identity mapping; the credential half
      lives in `.env.auth`, keyed by the same suffix). Resolved from the roster
      by resolve_personas() and carried through render.py's per-service dicts
      like `display_name`/`theme`.
    services[].oidc_subject_env: str — the env-var name the above is emitted
      under, pre-resolved by render.py through personas.env_var_suffix(). Always
      present; read only when `oidc_subject` is set. Pre-resolved on purpose:
      the username->env-var mapping has exactly one definition, and a template
      that re-derived it could key a subject differently from the password hash
      keyed by the same user.
    services[].role: str, optional — this user's static role, straight off the
      roster entry's `role:` -> OSPREY_AUTH_ROSTER_ROLE_<SUFFIX>. Emitted under
      BOTH login methods, unlike the group binding above, because it does two
      jobs: under `password` it IS the session role, and under `oidc` it is the
      cross-check the sidecar refuses a disagreeing ID token against — a `role:`
      is what the render resolved this user's persona from, so it already
      decided which container their login lands in.
      Absent (no `role:` on the entry) emits no line at all, and the sidecar
      resolves "" — no privileges — for that user. Note this is the role NAME,
      not the persona it binds: the persona already reached this file as the
      service's image and project.
    services[].role_env: str — the env-var name the above is emitted under,
      pre-resolved by render.py through personas.env_var_suffix(). Always
      present; read only when `role` is set. Pre-resolved for the same reason
      `oidc_subject_env` is. The `ROSTER_` infix is load-bearing:
      OSPREY_AUTH_ROLE_CLAIM / OSPREY_AUTH_ROLE_MAP above are the deployment's
      group binding, so a user named `claim` or `map` under a plain
      OSPREY_AUTH_ROLE_ prefix would have read that binding as their own role.
    services[].terminal_secret_env: str, required
      The env-var NAME this user's operator secret travels in
      (`OSPREY_TERMINAL_SECRET_<SUFFIX>`), pre-resolved by render.py through
      terminal_secret_env_var(). A NAME, never a value — see the OPERATOR
      SECRET section below for the whole carrier. Pre-resolved for the same
      reason `oidc_subject_env` is: the username->env-var mapping has exactly
      one definition, and a template that re-derived it could read a secret
      back under a spelling it was never minted under.
    services[].external_origin: str, required (may be "" only on a roster-less
      render, which emits no per-user service at all)
      The one origin browsers reach this deployment on -> each per-user
      service's OSPREY_TERMINAL_EXTERNAL_ORIGIN. The app inside the container
      checks a mutating request's `Origin` against it (the CSRF half of the
      carrier). Deployment-wide, so it always equals `landing_url` and the
      file-level `external_origin` below; carried per service only because
      that is where it is read.

    external_origin: str -> OSPREY_AUTH_EXTERNAL_ORIGIN
      The one origin browsers reach nginx on; the OIDC `redirect_uri` is built
      from it. Same derivation the landing link uses (render.py::_external_origin)
      — `modules.web_terminals.external_origin` when the operator set it (the
      shape where a load balancer in front of this nginx is what browsers
      reach), and `deploy.fqdn` + scheme/port otherwise.
    tls_enabled: bool -> OSPREY_AUTH_TLS_ENABLED
      Whether that origin is HTTPS. The sidecar terminates no TLS itself (nginx
      does) — this only decides the `Secure` attribute on the cookies it issues,
      which is why no cert/key is mounted into this service.

    bind_host: str, required
      Loopback address (always "127.0.0.1") baked into every per-user
      service's OSPREY_TERMINAL_BIND_HOST — and into the auth sidecar's own
      uvicorn bind. Not sourced from config at all — see render.py's
      `_LOOPBACK_BIND_HOST` for why this is a constant, not a knob.

  ----------------------------------------------------------------------------
  SECRETS ISOLATION (the reason for the auth service's env_file/environment split)

  The sidecar's `env_file` is `.env.auth` (0600, project root, written by
  auth_credentials.ensure_auth_credentials) and NOTHING ELSE. Two rules, both
  load-bearing:

  1. `.env.auth` is never given to a `web-*` service. Those containers run the
     agent; the session signing key in `.env.auth` would let any user's agent
     mint a valid cookie for every other user, which is precisely the isolation
     this feature exists to establish. The inverse also holds: the sidecar never
     reads `.env.users` — the per-user containers' shared env file — so no
     provider key or facility credential is in reach of the login surface.
  2. Secrets travel ONLY as `env_file` entries, never as `environment:` values,
     and every secret VALUE must be free of `$`. Both halves are load-bearing.

     Keeping secrets out of `environment:` keeps them out of the rendered
     compose file AND out of `docker inspect` for the service that reads them —
     compose interpolates an `environment:` value at container-create time and
     stores the result in the container's own Config.Env, while an `env_file`
     value is handed to the runtime without being baked into the definition. The
     per-user operator secret is the ONE knowing exception to this rule; the
     OPERATOR SECRET section below states exactly what it costs and why
     `env_file` cannot express it. But do NOT read that as "an env_file value is
     passed through literally" — it is not. Every compose implementation
     interpolates `${...}` in env_file values too, and Docker Compose
     additionally replaces every `$` followed by an identifier character with
     the empty string. That is why the stored hash is separated by `.` rather
     than the conventional `$` (osprey.services.auth_sidecar.passwords
     `FIELD_SEP`): a `$`-separated hash arrives here with its salt and key
     eaten, verifies against nothing, and refuses every login — silently, and
     only for the values whose random base64 happens to start with a letter.

     Anything new added to `.env.auth` must therefore encode `$`-free.
     `tests/deployment/web_terminals/test_auth_credentials.py` pins that as a
     property of the whole file, not of the hash alone. Non-secret settings
     (method, lifetime, roster, origin, OIDC issuer and per-user subject
     mapping) come from the template variables above and stay in
     `environment:`.

  ----------------------------------------------------------------------------
  OPERATOR SECRET (the per-user carrier, and why no VALUE is rendered here)

  Every request nginx proxies to a per-user terminal carries that user's own
  secret as the `X-Osprey-Terminal-Secret` header, and the terminal refuses any
  request arriving without it. That is what makes nginx the only way in: the
  per-user apps bind loopback, but loopback is visible to every process sharing
  the host netns (see NETWORKING below), so the bind alone stops nothing that is
  already on the box — a neighbouring container included.

  One secret PER USER, so a value leaked from one container cannot be replayed
  against another user's terminal. Both ends of one user's carrier name the same
  variable, `svc.terminal_secret_env` (`OSPREY_TERMINAL_SECRET_<SUFFIX>`,
  pre-resolved by render.py::terminal_secret_env_var):

    * the per-user service reads it into the container-shape `OSPREY_TERMINAL_SECRET`
      (`interfaces.web_auth.OPERATOR_SECRET_ENV`) — the app pops it at construction,
    * the nginx service exports it under its own name, and nginx's entrypoint
      substitutes it into that user's snippet at container start.

  NO SECRET VALUE APPEARS IN THIS FILE, in any other rendered artifact, or in
  any image layer. Every reference is `${VAR:-}`, which compose interpolates at
  container-create time from the pinned deploy `.env` (--env-file; see
  provision.web_stack_compose_cmd) — the same file `ensure_terminal_secrets`
  mints into during preflight. The `:-` default only suppresses compose's
  unset-variable warning; it does NOT half-authenticate, because a blank value
  fails closed at app construction rather than at compose parse — which is where
  an operator can still read the error.

  WHAT `${VAR:-}` DOES AND DOES NOT BUY, precisely — because the rule at
  SECRETS ISOLATION above says secrets travel only as `env_file` entries, and
  this carrier is a deliberate exception to it.

  It keeps the value out of: this rendered file, `git status`, and every image
  layer. It does NOT keep it out of `docker inspect` or `docker compose config`:
  compose interpolates `environment:` values at container-create time and stores
  the result in the container's own `Config.Env`, so the per-user secret is
  readable there for the nginx service (the whole roster) and for each `web-*`
  service (its own). An `env_file` entry is what avoids that, and it is not
  available here: the value has to arrive at nginx under a per-user NAME and at
  that user's own container under the fixed name `OSPREY_TERMINAL_SECRET`, and
  `env_file` carries a file's variables verbatim — it cannot rename one. Writing
  per-service env files instead would put the secret VALUES on disk in `build/`,
  which is the thing this carrier exists to avoid and the strictly worse trade.

  So the exception is accepted knowingly, and it costs less than it looks:
  reading `docker inspect` means already holding the container runtime's socket,
  which is root-equivalent on this host and can read the deploy `.env` (and
  everything else) directly. The isolation the carrier does establish — one
  secret per user, so a value leaked from one container cannot be replayed
  against a neighbour's terminal — is unaffected by any of this.

  ENVSUBST, and the three settings that must travel together:

    NGINX_ENVSUBST_FILTER=^OSPREY_TERMINAL_SECRET_
      The base image's entrypoint otherwise substitutes EVERY variable in its
      environment into every template. Restricting it to this prefix keeps any
      other credential that happens to be in nginx's environment from being
      written into a file under the output directory.
    NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx/osprey
      NOT the entrypoint's default of `/etc/nginx/conf.d`, which the base image
      globs into its `http{}` block: a `proxy_set_header` spliced in at http
      level would send one user's secret to EVERY upstream, the auth sidecar
      included. `/etc/nginx/osprey` is read only by the per-user `include`
      nginx.conf.j2 emits inside each authenticated `location`.
    ./build/nginx/templates:/etc/nginx/templates:ro
      The source directory render.py writes `secret-<user>.conf.template` into
      and `clear_nginx_templates_dir` empties before every render, so a
      decommissioned user's snippet cannot survive. Render output, hence
      build-relative (see MOUNT PATHS below). Read-only: nothing in the stack
      has any reason to write it.

  All three are emitted whatever the roster size. They describe where this
  service reads templates from and writes them to, which is not a function of
  how many users happen to be configured — and leaving OUTPUT_DIR unset for the
  0-user case would put the dangerous conf.d default one roster edit away.

  ----------------------------------------------------------------------------
  NETWORKING

  Every service (per-user AND nginx) runs `network_mode: host`. Per-user
  services need it for EPICS CA UDP broadcast discovery; under host
  networking there is no internal->host port map, so each per-user app's
  OSPREY_WEB_PORT/etc. is a host port. Unlike the port, the *bind address* is
  NOT the host's routable interface: every per-user app binds `bind_host`
  ("127.0.0.1", via OSPREY_TERMINAL_BIND_HOST) only, so a per-user port is
  unreachable from off-host even though it shares the host network
  namespace. nginx is therefore the only intended off-host path to a per-user
  app — it reverse-proxies to these loopback upstreams. nginx itself runs on
  host networking and binds every interface, unrestricted — it is the one
  service required to be reachable off-host, and it can always reach the
  per-user loopback upstreams because loopback is visible to every process
  sharing the same host netns.

  MOUNT PATHS: every relative path in this file — the nginx mounts and both
  `env_file:` entries — resolves against ONE directory, the pinned compose
  project directory, which is the deployment REPO ROOT
  (`--project-directory <repo>`; see compose_generator.compose_base_cmd).
  Never against this file's own location, which is `build/`. That single pin is
  what lets one rendered file reference both zones correctly: the nginx config
  and landing page are render output and live under `./build/nginx/`, while
  `.env.auth` and `.env.users` are durable secrets and live at the repo
  root, where the roster verbs write them and `rm -rf build/` cannot touch them.

  NGINX MOUNT TARGET: nginx.conf.j2's rendered output is a `server{}` FRAGMENT, not a
  complete main config (no `events{}`/`http{}` wrapper — `server`/`listen`/
  `location` are only valid inside `http{}`). It mounts to
  `/etc/nginx/conf.d/default.conf`, NOT `/etc/nginx/nginx.conf` — the base
  nginx image's own (untouched) main config already `include`s
  `/etc/nginx/conf.d/*.conf` from inside its `http{}` block, and already
  ships `events{}`. Mounting the fragment at the main-config path instead
  would fail nginx's parse at startup ("server" directive is not allowed
  there) and the whole stack would never come up.
#}
services:

  nginx:
    image: {{ nginx_image | default("nginx:1.27-alpine") }}
    container_name: {{ facility_prefix }}-nginx
    restart: unless-stopped
    network_mode: host
    labels:
      com.osprey.repo-id: "{{ repo_id }}"
    environment:
      - TZ={{ facility_timezone | default("UTC") }}
      {#- Where the base image's entrypoint writes the envsubst'd snippets, and
         which variables it may substitute. Both are spelled out in the OPERATOR
         SECRET section of the header; the short version is that the default
         output directory (conf.d) would splice a per-user `proxy_set_header`
         into `http{}` and leak one user's secret to every upstream, and an
         unfiltered pass would substitute unrelated credentials into files on
         disk. #}
      - NGINX_ENVSUBST_FILTER=^OSPREY_TERMINAL_SECRET_
      - NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx/osprey
{%- for svc in services %}
      {#- One roster user's operator secret, under the SAME variable name the
         user's own service reads (svc.terminal_secret_env) and the same one
         that user's snippet references. A NAME here, never a value: compose
         interpolates it at container-create time from the deploy .env. #}
      - {{ svc.terminal_secret_env }}=${{ "{" }}{{ svc.terminal_secret_env }}:-}
{%- endfor %}
    volumes:
      {#- Render output, so it is addressed under build/ — see the MOUNT PATHS
         note in the header for why these are build-relative while the env
         files below are repo-root-relative. #}
      - ./build/nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./build/nginx/landing.html:/usr/share/nginx/html/landing.html:ro
      {#- The per-user secret snippets, as nginx TEMPLATES — their `${...}` is
         resolved by the entrypoint at container start, not by Jinja2 at render
         time, which is what keeps the values off disk. Cleared and rewritten
         whole by every render (render.clear_nginx_templates_dir), so this
         directory holds exactly the current roster and nothing else. #}
      - ./build/nginx/templates:/etc/nginx/templates:ro
{%- if tls_host_cert_dir and tls_mount_target %}
      {#- The operator's certificate directory, read-only, landing at the
         directory `tls.cert` names so nginx's ssl_certificate finds it. Emitted
         only when `tls.host_cert_dir` is set: without it this list is byte-for-
         byte what a no-TLS deployment renders, and the operator is expected to
         supply the mount from a compose file of their own. render.py has
         already refused a relative source, and a key living outside this
         directory, so one mount is known to deliver both files. #}
      - {{ tls_host_cert_dir }}:{{ tls_mount_target }}:ro
{%- endif %}
    {#- The envsubst OUTPUT directory (NGINX_ENVSUBST_OUTPUT_DIR, above),
       provided as a tmpfs so it EXISTS and is WRITABLE before the base image's
       entrypoint runs. The entrypoint's 20-envsubst-on-templates.sh does not
       create its own output directory — a bare `-w` guard makes it skip the
       whole substitution when the directory is not already writable — and the
       base image ships no `/etc/nginx/osprey`. Without this the per-user secret
       snippets are never rendered, and nginx then dies at start on the
       unconditional `include /etc/nginx/osprey/secret-<user>.conf` every
       authenticated location carries (nginx.conf.j2). A tmpfs, not a bind or a
       named volume: the content is regenerated from the mounted templates on
       every start and must never outlive the container or touch disk — the
       secret VALUES are what land here after substitution. Emitted at every
       roster size, alongside the NGINX_ENVSUBST_* environment it backs.

       WHY THE MODE, AND WHY THIS SPELLING OF IT. A tmpfs mounted without a mode
       lands at 1777, world-writable and world-readable, and the envsubst'd files
       inside it are 0644: every roster user's operator secret, in plaintext,
       readable by any process in this container. 0700 with a root-owned
       directory is what the two readers actually need — the base image's
       entrypoint runs as root and writes the files there, and nginx's MASTER
       process (also root) is what reads the `include`s at startup and on reload.
       The unprivileged workers never open a config file, so nothing is lost by
       shutting them out.

       The mode rides as a MOUNT OPTION on the service-level `tmpfs:` short form,
       `<path>:mode=0700`, and NOT as the long-form `volumes:` entry
       (`{type: tmpfs, target: ..., tmpfs: {mode: 0700}}`) that would express the
       same thing to Docker Compose alone. OSPREY supports podman-compose as a
       first-class provider, and the two forms do not survive it equally. In the
       long form `0700` is YAML octal, so it parses to the INTEGER 448: Docker
       Compose sends that to the daemon as a numeric filemode and the directory
       comes up `drwx------`, but podman-compose formats the same value straight
       into `--tmpfs <path>:mode=448`, and podman passes tmpfs options through to
       the kernel verbatim — where `mode=` is parsed as OCTAL, so 448 is rejected
       and the container never starts. Quoting it (`mode: "0700"`) does not
       reconcile them either: Docker Compose refuses a string there outright. The
       option string below has no such ambiguity — both providers hand
       `mode=0700` to the kernel unchanged. #}
    tmpfs:
      - /etc/nginx/osprey:mode=0700
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:{{ nginx_port }}/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
{#- The auth sidecar. Whitespace control on this `if` (and its `endif`) is what
   keeps the `auth.method: none` render free of a stray blank line:
   with the block suppressed, the `{%- if %}` swallows the newline it would
   otherwise leave behind and the `endif` line's own newline restores the one
   that ended `start_period: 10s`. Service key "auth" cannot collide with a
   roster user — users render as `web-<user>` — nor with nginx or any base
   docker-compose.yml service. #}
{%- if auth_method != "none" %}

  auth:
    {#- Registry mode pins `auth.image`; local mode leaves it unset and the
       runtime build produces this tag (see AUTH SIDECAR contract above). A
       registry-mode deployment that forgot `auth.image` is caught by the
       deploy preflight, not by silently building here. #}
    image: {{ auth_image | default(facility_prefix ~ "-assistant-auth:local", true) }}
    container_name: {{ facility_prefix }}-auth
    restart: unless-stopped
    network_mode: host
    {#- Single process, deliberately: the revocation list and the brute-force
       throttle are in-memory, so a second worker would answer with a different
       view of both. Bound to `bind_host` for the same reason the per-user apps
       are — nginx shares this host netns and is the only intended caller, and
       the login surface must not be reachable off-host on its own port. `curl`
       is not in an OSPREY service image, so the probe is the in-image python
       one every other OSPREY service uses; /health answers 200 even when the
       sidecar is unconfigured and refusing everything, so the container stays
       up to explain itself rather than crash-looping. #}
    command: ["uvicorn", "osprey.services.auth_sidecar.app:create_app", "--factory", "--host", "{{ bind_host }}", "--port", "{{ auth_port }}"]
    env_file: .env.auth
    labels:
      com.osprey.repo-id: "{{ repo_id }}"
{%- if auth_env_digest %}
    {#- The sha256 of `.env.auth`'s current content. Compose bakes env_file
       content into a container at CREATION time, and a service-DEFINITION
       change is the only recreate trigger every compose implementation honours
       — podman-compose never recreates on a content-only file change, so
       without this a hand-edited `.env.auth` (the documented OIDC credential
       workflow) leaves the sidecar serving the previous file, /health green
       and everything else 503. The digest turns the edit into a definition
       change; only the sidecar carries it, so only the sidecar is recreated
       (podman-compose 1.0.6 hashes the whole file and bounces the project —
       accepted, versus silently-stale credentials). The label is not a secret:
       it is a hash of the whole file, never a variable's value. Empty digest
       means a render outside the deploy path (e.g. `osprey scaffold
       web-terminals render`), which emits no label; every `osprey up`
       re-renders with a current one. #}
      {{ auth_env_digest_label }}: "{{ auth_env_digest }}"
{%- endif %}
    environment:
      - TZ={{ facility_timezone | default("UTC") }}
      {#- The sidecar's audit identity and the directory it writes to. It is one
         service rather than one per user, so the identity is the FIXED name
         `sidecar` (render.AUTH_SIDECAR_AUDIT_IDENTITY) — the users its login and
         denial events name are their SUBJECTS, never their writers, and a
         record filed under a username here would read as that user having
         written it.

         The directory arrives under the auth-specific name because this
         container reads it that way: it is not an OSPREY project (WORKDIR
         /app, one uvicorn app), it resolves no project root, and an unset
         value degrades to a log line rather than a guess. It is also the one
         service excluded from the entrypoint's group step — it runs as root
         with no entrypoint and no `user:`, so it needs no supplementary group
         and writes root-owned records. The generic OSPREY_AUDIT_DIR is
         deliberately NOT emitted here: it is the variable that step is to
         iterate, and this image has no root phase to read it. #}
      - OSPREY_AUDIT_IDENTITY={{ auth_audit_identity }}
      - OSPREY_AUTH_AUDIT_DIR={{ auth_audit_dir }}
      - OSPREY_AUTH_METHOD={{ auth_method }}
      - OSPREY_AUTH_SESSION_LIFETIME={{ auth_session_lifetime }}
      - OSPREY_AUTH_TLS_ENABLED={{ "true" if tls_enabled else "false" }}
      - OSPREY_AUTH_EXTERNAL_ORIGIN={{ external_origin }}
      {#- The roster the sidecar will answer for, in declaration order (the
         login page reuses that order). Rendered from the same `services` list
         the per-user containers and nginx locations come from, so a user can
         never exist in one and be missing from the other. #}
      - OSPREY_AUTH_USERS={{ services | map(attribute="user") | join(",") }}
{#- Everything OIDC — issuer, credential-variable names, claim, and the per-user
   subject mapping — is gated on the mode, so a `password` deployment carries no
   OIDC settings at all even if a roster entry still declares an `oidc_subject`
   from an earlier posture. #}
{%- if auth_method == "oidc" %}
{%- if auth_oidc_issuer %}
      - OSPREY_AUTH_OIDC_ISSUER={{ auth_oidc_issuer }}
{%- endif %}
      {#- NAMES of the variables holding the client credentials, not the
         credentials: the values themselves arrive from `.env.auth` under
         whatever names a facility already keeps them under. #}
      - OSPREY_AUTH_OIDC_CLIENT_ID_ENV={{ auth_oidc_client_id_env }}
      - OSPREY_AUTH_OIDC_CLIENT_SECRET_ENV={{ auth_oidc_client_secret_env }}
{%- if auth_oidc_claim %}
      {#- Only when the facility names one: with no line here the sidecar
         applies its own documented default (`sub`), so the default lives in
         one place instead of being restated by the renderer. #}
      - OSPREY_AUTH_OIDC_CLAIM={{ auth_oidc_claim }}
{%- endif %}
{%- set role_claim = authorization_claim | default("") %}
{%- set role_map = authorization_claim_map | default({}) %}
{%- if role_claim and role_map %}
      {#- The group binding: which ID-token claim carries group membership, and
         the table turning that claim's values into one of the roles
         `authorization.roles` declared. Rendered as a PAIR or not at all —
         `RoleBinding.configured` is `claim OR claim_map`, so the sidecar reads
         either half alone as a deployment whose authorization block broke and
         refuses every login that needs a role. That is the right reading for a
         half that went missing and the wrong thing to render for a deployment
         that declared neither, which is why the condition tests both.
         render.py already refuses half a `claims:` stanza, so these two ctx
         keys arrive both-or-neither; this is the second guard, so a later
         change there cannot quietly emit one line on its own.

         The map is COMPACT JSON — no space after the `:` — assembled pair by
         pair rather than through `tojson`, whose object form spaces its
         separators. Both parse, but the compact spelling is the wire format
         the sidecar documents, and it is what keeps this a plain scalar rather
         than something a reader has to check against the YAML flow-mapping
         syntax it resembles.

         Each key and value is JSON-quoted, and the whole `KEY=value` is quoted
         again (the `oidc_subject` treatment above): group values belong to the
         provider, and an LDAP-backed IdP emits DN-style names carrying `,`,
         `=` and `": "` — the last of which would otherwise derail the YAML
         parse of this list item. Jinja's `tojson` is HTML-safe, so `&`, `<`,
         `>` and `'` come out as `\uXXXX` escapes rather than literally; that
         is still one JSON object and still round-trips to the same string. #}
      {%- set role_map_pairs = [] %}
      {%- for claim_value, role_name in role_map.items() %}
      {%- set _ = role_map_pairs.append((claim_value | tojson) ~ ":" ~ (role_name | tojson)) %}
      {%- endfor %}
      - {{ ("OSPREY_AUTH_ROLE_CLAIM=" ~ role_claim) | tojson }}
      - {{ ("OSPREY_AUTH_ROLE_MAP={" ~ role_map_pairs | join(",") ~ "}") | tojson }}
{%- endif %}
{%- for svc in services %}
{%- if svc.oidc_subject %}
      {#- This user's expected IdP identity — the non-secret half of the
         roster→identity mapping. The variable NAME arrives pre-resolved as
         `svc.oidc_subject_env` (render.py, via personas.env_var_suffix()) and
         is emitted verbatim: deriving `upper|replace` here would be a second
         copy of the username→env-var mapping, free to drift from the one that
         keys this user's password hash in `.env.auth`. tojson quotes the WHOLE
         `KEY=value` (see OSPREY_WEB_APP_NAME below) because a subject can be an
         email or a DN containing `": "`, which would derail the YAML parse. #}
      - {{ (svc.oidc_subject_env ~ "=" ~ svc.oidc_subject) | tojson }}
{%- endif %}
{%- endfor %}
{%- endif %}
{#- The roster's own roles, which do TWO jobs and are therefore emitted under
   BOTH login methods (under `none` there is no sidecar at all, so this whole
   service — and this family with it — is absent):

     * password — the roster IS the session role. No third party is involved,
       so the entry's `role:` is the whole answer.
     * oidc — the roster is the CROSS-CHECK TARGET. A `role:` is what the render
       resolved this user's persona from, so it already decided which container
       the login lands in; the sidecar refuses a login whose validated ID token
       maps to a different role, because that session would name one role while
       sitting in another's container. Where the deployment binds no `claims:`
       at all, nothing asked the provider about privilege and this stays the
       session role, exactly as under password.

   One line per entry that declares a role; an entry with none emits nothing and
   the sidecar resolves "" for it, which is "no privileges" rather than a role
   named "". Entries opted out of the login wall (`login: false`) are NOT
   filtered out here: they are on OSPREY_AUTH_USERS above, which is the roster
   this table is keyed from, and a role table that disagreed with that roster is
   the drift worth avoiding. Nothing is granted by it — an exempt entry has no
   password provisioned, so no login of theirs ever reaches the lookup.

   The variable NAME arrives pre-resolved as `svc.role_env` (render.py, via
   personas.env_var_suffix()) and is emitted verbatim, for the reason spelled
   out on `oidc_subject_env` above. tojson quotes the WHOLE `KEY=value`, the
   same treatment: a role name is config, and `": "` in one would otherwise
   turn this list item into a YAML mapping and hand the sidecar a truncated
   role.

   Ungated on the method, unlike the `claims:` family above: the enclosing
   `auth_method != "none"` around this whole service is what keeps it out of a
   login-free deployment, and there is no method that mints a session without a
   container behind it to have been rendered. #}
{%- for svc in services %}
{%- if svc.role %}
      - {{ (svc.role_env ~ "=" ~ svc.role) | tojson }}
{%- endif %}
{%- endfor %}
    volumes:
      {#- The sidecar's own audit subdirectory, mount-isolated exactly like
         every user's: it holds the LOGIN half of the trail (who authenticated,
         who was refused), and no terminal container has a mount through which
         it could read or edit it. Provisioned host-side before this mount
         exists, for the usual root-owned-bind-source reason. #}
      - {{ auth_audit_mount_source }}:{{ auth_audit_dir }}
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://{{ bind_host }}:{{ auth_port }}/health').status==200 else 1)\""]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
{%- endif %}
{% for svc in services %}
{% if svc.user == "nginx" %}
  {# HARD FAIL: a user literally named "nginx" would silently clobber the
     nginx service key above (PyYAML keeps the last of two duplicate mapping
     keys, so the whole nginx service — and the landing page — would just
     vanish with no render error). The lint already rejects this
     against the roster; this is a second, independent guard that fires
     even if render.py is ever called without going through the lint first. #}
  {{ 1 / 0 }}
{% endif %}

  web-{{ svc.user }}:
    image: {{ svc.image }}
    container_name: {{ facility_prefix }}-web-{{ svc.user }}
    restart: unless-stopped
    network_mode: host
    labels:
      com.osprey.repo-id: "{{ repo_id }}"
    env_file: .env.users
    environment:
      - CLAUDE_CONFIG_DIR=/data/claude-config
      - HOME=/data/claude-config
      - TZ={{ facility_timezone | default("UTC") }}
      - OSPREY_TERMINAL_USER={{ svc.user }}
      {#- WHO this container's audit records are written as, and WHERE. Both
         rendered from the same roster name that names the mount below
         (render._audit_mount_source / _container_audit_dir), so the identity
         stamped into a record and the directory the record lands in can never
         name two different users — an audit trail that attributes alice's
         actions to bob is worse than no trail at all.

         Unconditional, and deliberately so: the audit mount follows the
         MIDDLEWARE, not the login wall. This container hosts an interface app
         and launches framework MCP servers whatever `auth.method` says, so it
         records under its own identity on an unauthenticated deployment
         exactly as it does behind a login.

         OSPREY_AUDIT_DIR is also the CONTRACT this file offers the image's
         entrypoint: the render names the directories, and the entrypoint's root
         phase is to join their groups before dropping privileges — compose
         `group_add:` alone does not survive `gosu`, and the script reads no
         config, so a directory it is not told about is one it cannot join. The
         value is the CONTAINER path, never the host one: the entrypoint stats
         the directory it can actually see. #}
      - OSPREY_AUDIT_IDENTITY={{ svc.audit_identity }}
      - OSPREY_AUDIT_DIR={{ svc.container_audit_dir }}
{%- if facility_bundle_source and svc.container_bundle_dir %}
      {#- The bundle mount's target, named for the same entrypoint contract: the
         root phase is to iterate exactly the directories these two variables
         name, so the group the bundle is shared through is granted the same way
         the audit group is, and neither is guessed. Gated on the same pair as
         the mount itself — a service with no bundle bound has no second
         directory to name, and the step skips what is unset. #}
      - OSPREY_FACILITY_BUNDLE_DIR={{ svc.container_bundle_dir }}
{%- endif %}
      - OSPREY_TERMINAL_LANDING_URL={{ landing_url }}
      - OSPREY_TERMINAL_BIND_HOST={{ bind_host }}
      - OSPREY_TERMINAL_WEB_PORT={{ svc.web }}
      - OSPREY_WEB_PORT={{ svc.web }}
      {#- Where the telemetry store is from inside this container. The agent's
         launch derives its OTLP endpoint from `claude_code.telemetry` with the
         host chosen for the running context, and the context it would sniff
         here is wrong: `/.dockerenv` says "container", which selects the
         compose DNS name `openobserve` — a name that resolves to nothing under
         `network_mode: host`, so every metric and log would be dropped with no
         error anywhere. Under host networking this container's loopback IS
         the deployment host's, and the store answers there on the port it
         PUBLISHES — which the emitter reads from `services.openobserve.port`
         in this persona's own config (inherited from the hosting profile), so
         no port is declared here. Same convention, same reason, as the
         dispatch worker's compose. Inert unless telemetry is enabled with
         backend: openobserve. #}
      - OSPREY_OTEL_OPENOBSERVE_HOST={{ bind_host }}
      {#- This user's operator secret, in the container-shape variable the app
         pops at construction (web_auth.OPERATOR_SECRET_ENV). The per-user
         variable it is interpolated FROM is the same one nginx exports and this
         user's snippet substitutes, so the two ends of the carrier cannot be
         minted under one spelling and read under another — see the OPERATOR
         SECRET section in the header.

         `${VAR:-}` rather than a rendered value, exactly as ZO_INGEST_SA_TOKEN
         above and for the same reason: the secret stays in the deploy .env and
         out of this file, out of `git status`, and out of every image layer. It
         is NOT out of `docker inspect` — compose interpolates this at
         container-create time and the result is stored in the container's
         Config.Env — which is the accepted exception the OPERATOR SECRET
         section of the header spells out, along with why `env_file` cannot
         express this particular carrier. The `:-` default suppresses compose's
         unset warning only — an empty value fails closed at app construction,
         which is a startup error naming the variable rather than a terminal
         that quietly trusts everything. #}
      - OSPREY_TERMINAL_SECRET=${{ "{" }}{{ svc.terminal_secret_env }}:-}
      {#- The origin this deployment is reached on, which the app checks a
         mutating request's `Origin` against (common_middleware.EXTERNAL_ORIGIN_ENV)
         — the CSRF half of the carrier: without it a page on any other origin
         could drive this terminal using the browser's own credentials.

         Baked in here rather than derived per request from nginx's `$host`,
         because a container reads its environment once at start and because
         `$host` carries no port — a deployment behind a non-443 plain-HTTP
         nginx would then check against an origin no browser ever sends.
         Deployment-wide, so it equals `landing_url`: a service believing in a
         different origin would reject the very links the landing page hands
         out. A deployment fronted by a TLS-terminating load balancer sets
         `modules.web_terminals.external_origin` to the address that balancer
         answers on, and it lands here — the browser's origin is that host, and
         nothing derivable from this config could name it. Not quoted, for the
         same reason OSPREY_TERMINAL_LANDING_URL above is not — a URL holds no
         `": "` and so is a plain YAML scalar. #}
      - OSPREY_TERMINAL_EXTERNAL_ORIGIN={{ svc.external_origin }}
      {#- The telemetry ingest identity's SECRET. Every persona's rendered
         config.yml carries `password: ${ZO_INGEST_SA_TOKEN}` verbatim (the
         build defers it — the store mints the token, so no build can resolve
         it), and the agent this container starts re-resolves that reference
         against its own environment. Without this line the placeholder is
         still a placeholder inside the container and the terminal refuses to
         start: `_openobserve_auth_header` is strict at runtime, so a web
         terminal that cannot resolve it crash-loops behind the proxy.

         Unconditional, unlike the three credentials below: this is not a
         per-persona entitlement. Every terminal runs an agent that emits
         telemetry as the same ingest account, so there is no tier to express
         here — which is also why gating it on a persona set would only
         produce terminals that fail to start.

         NOT in `.env.users`, though, and that exclusion is deliberate
         (`env_production._build_env_production_subset`): the account reads
         back every log and metric in the store, and `.env.users` is a
         rendered, operator-facing file that `osprey users env` re-writes
         whole. `${VAR:-}` keeps the secret out of every rendered artifact
         instead — compose interpolates it at container-create time from the
         deploy `.env` (the pinned --env-file, see
         provision.web_stack_compose_cmd), which is where `osprey up` harvests
         it to (`container_lifecycle._stage_openobserve_identity`, which runs
         before this stack is brought up).

         The `:-` default only suppresses compose's unset-variable warning. An
         empty value does NOT quietly half-authenticate: the same strict check
         refuses a blank credential, so a deploy that never provisioned the
         token fails where it is visible rather than shipping an agent whose
         telemetry is silently dropped. #}
      - ZO_INGEST_SA_TOKEN=${ZO_INGEST_SA_TOKEN:-}
{%- if svc.display_name %}
      {#- Human-facing window/tab title. tojson quotes the WHOLE `KEY=value` as
         one double-quoted YAML scalar (never just the value — the compose
         `- KEY=value` list form has no per-value quoting), so a display_name
         containing spaces or a `": "` can't derail YAML parsing; compose then
         splits the parsed string on the first `=`. app.py reads
         OSPREY_WEB_APP_NAME in preference to config web.app_name. #}
      - {{ ("OSPREY_WEB_APP_NAME=" ~ svc.display_name) | tojson }}
{%- endif %}
{%- if svc.theme %}
      {#- This user's default web UI theme: a theme family ("desy") or a
         concrete id ("desy-light", which additionally pins light/dark).
         Quoted the same way as OSPREY_WEB_APP_NAME above, for the same
         reason. app.py reads OSPREY_WEB_THEME in preference to config
         web.theme, and warns+falls back on an unknown value. A user's own
         choice in the display menu still outranks this. #}
      - {{ ("OSPREY_WEB_THEME=" ~ svc.theme) | tojson }}
{%- endif %}
{%- for env in svc.panel_env %}
      - {{ env.name }}={{ env.port }}
{%- endfor %}
{%- if svc.wants_dispatcher %}
      {#- The event dispatcher's bearer, for a persona that declares the EVENTS
         panel. Every dashboard DATA endpoint is bearer-gated, and the web
         terminal's panel proxy injects this server-side (routes/proxy.py) so the
         browser never holds it; without it the tab renders empty.

         Deliberately HERE and not in `.env.users`: that file is handed to
         every user's container alike, so a token in it would reach read-only
         personas too — and this one credential can fire triggers. Per-user is
         the only placement that can express the tier boundary.

         `${VAR:-}` is resolved by compose from the deploy `.env` (the pinned
         --env-file, see provision.web_stack_compose_cmd), so the secret is never
         written into this rendered file. The `:-` default keeps compose from
         warning, and an unset var renders an empty value the dispatcher then
         rejects with a 401 — visible, rather than a silent half-auth. #}
      - EVENT_DISPATCHER_TOKEN=${EVENT_DISPATCHER_TOKEN:-}
{%- endif %}
{%- if svc.wants_ariel_db %}
      {#- The ARIEL Postgres password, for a persona that configures ARIEL. Two
         consumers in this container authenticate with it — the ARIEL panel's own
         server and the `ariel` MCP server the agent calls — and both derive the
         DSN the same way (services.ariel_search.config.resolve_ariel_dsn), from
         `services.postgresql` plus this variable. Without it they fall back to
         the shipped default while Postgres holds the password `osprey up` minted,
         and the ARIEL tab reports the database as unavailable.

         Per-user for the same reason as the dispatcher token above: a shared
         `.env.users` cannot say "the personas that configure ARIEL".

         `:-ariel` mirrors the postgresql service template's own default, so a
         project deploying no minted password behaves here exactly as it does on
         the host — an empty value would NOT, since `resolve_ariel_dsn` falls
         back only on an unset variable, never on an empty one. #}
      - ARIEL_DB_PASSWORD=${ARIEL_DB_PASSWORD:-ariel}
{%- endif %}
{%- if svc.wants_launch_token %}
      {#- The Bluesky queue's launch token, for a persona entitled to arm a queue
         start. The consumer is the `bluesky` MCP server inside this container:
         holding this token is what lets the agent start the queue on the
         operator's approval of that one tool call, with no second confirmation
         step anywhere else. A persona without it is refused by the bridge, and
         the operator starts the queue from the BLUESKY panel themselves.

         Per-user for the same reason as the two credentials above, and more
         sharply: this one arms physical hardware motion. A read-only persona
         reads the same `.env.users` as everyone else, so a token placed
         there would hand queue-start capability to exactly the personas that
         must never have it.

         `${VAR:-}` is resolved by compose from the deploy `.env`, so the secret
         is never written into this rendered file. The `:-` default keeps compose
         from warning, and an empty value is falsy to `resolve_launch_token`,
         which then resolves no token and refuses the launch client-side — the
         same fail-closed outcome as never emitting this line at all. #}
{%- for var in launch_token_env_vars %}
      {#- One token PER PLAN LANE the deployment renders (`BLUESKY_LAUNCH_TOKEN`
         for lane 1; `BLUESKY_VA_LAUNCH_TOKEN` / `BLUESKY_LIVE_LAUNCH_TOKEN`
         for a second lane), because each lane is a whole bridge stack armed by
         its own token — one shared token would let a launch approved against
         one machine be replayed against the other. The persona is told both
         lanes' addresses by the build for the same reason it is handed both
         tokens here: its session may be switched to either target. #}
      - {{ var }}={{ '${' ~ var ~ ':-}' }}
{%- endfor %}
{%- endif %}
{%- if svc.wants_graphdb %}
      {#- The graph store's Neo4j password, for a persona that configures one.
         The consumer is the `graph` MCP server in this container, which resolves
         what to dial and with which password through
         deployment.graphdb_service.resolve_graphdb_connection — from
         `services.graphdb` plus this variable. Without it the server
         authenticates with the shipped default while the store holds the
         password `osprey up` minted, and every graph query fails on auth.

         Per-user for the same reason as the credentials above: a shared
         `.env.users` cannot say "the personas that configure a graph store".
         Read-only personas ARE among them, unlike the launch token: Neo4j has a
         single write-capable account, so read-only-ness is enforced by the
         graph server's read transactions rather than by withholding this.

         `:-ospreygraph` mirrors the graphdb service template's own
         `NEO4J_AUTH: "neo4j/${GRAPHDB_PASSWORD:-ospreygraph}"`, so a deployment
         that minted no password behaves identically inside this container and
         outside it. An empty value would NOT — `resolve_graphdb_connection`
         reads the variable with a `.get` default, which falls back only on an
         UNSET variable and would otherwise authenticate with the empty
         string. #}
      - GRAPHDB_PASSWORD=${GRAPHDB_PASSWORD:-ospreygraph}
{%- endif %}
{%- if svc.archiver_password_env %}
      {#- The archiver store's password, for a persona whose archiver connector
         authenticates with one. The consumer is the connector inside this
         container — the `control_system` MCP server's archiver tools and the
         Python executor's `read_archiver` both open it — and it reads the
         variable its own `archiver.<type>.password_env` names, which is why
         this line carries a per-persona NAME rather than a fixed one: the
         control-assistant preset spells it MONGO_ROOT_PASSWORD (minted by
         `osprey up`), a facility-run store may spell it anything.

         Per-user for the same reason as the four credentials above: a
         shared `.env.users` cannot say "the personas whose archiver reads
         this", and it excludes service tokens by design.

         `${VAR:-}` is resolved by compose from the deploy `.env`, so the
         secret is never written into this rendered file. The `:-` default
         keeps compose from warning, and an empty value is refused by the
         connector exactly as an unset one is — "Environment variable '…' is
         not set" — so a deploy that never minted it fails where it is visible
         rather than half-authenticating. #}
      - {{ svc.archiver_password_env }}={{ "${" ~ svc.archiver_password_env ~ ":-}" }}
{%- endif %}
    volumes:
      - {{ svc.user }}-claude-config:/data/claude-config
      {#- Mount target comes from render.py's _container_agent_data_dir, which
         reads `agent_data.base_dir` — the same key the agent inside this
         container resolves its own agent-data root from. Never a literal: a
         path spelled here that the container does not write to is a volume
         mounted over an empty directory, while memory, sessions and artifacts
         accumulate in the writable layer and vanish at the next recreate. #}
      - {{ svc.user }}-agent-data:{{ svc.container_agent_data_dir }}
      {#- This user's audit subdirectory, and ONLY this user's. A bind, not a
         volume: the records are for the operator to read, grep and purge on the
         host, which a named volume would bury inside the runtime's storage.

         The isolation is the MOUNT, not a permission: alice's container is
         handed `var/audit/alice` and nothing else under `var/audit`, so bob's
         records are not merely unreadable to it — they are not in its
         filesystem to read. Widening this to the audit root would hand every
         terminal the whole deployment's trail.

         Read-WRITE, and provisioned host-side before this mount is ever created
         (compose_generator.ensure_audit_dir, called from the deploy path):
         left to the container runtime, a rootful daemon creates the missing
         source owned by root and the dropped `osprey` process inside can write
         nothing. That helper also makes it setgid + group-writable, which is
         what keeps the records the container writes purgeable on the host by
         the operator who deployed it. #}
      - {{ svc.audit_mount_source }}:{{ svc.container_audit_dir }}
{%- if facility_bundle_source and svc.container_bundle_dir %}
      {#- THE DEPLOYMENT BUNDLE SHADOWS THE PERSONA'S BAKED COPY. BY DESIGN.

         If you are here because a concept you baked into a persona image is not
         showing up: this line is why. The persona image may ship its own
         `data/facility_knowledge/` — `osprey build` renders one into the project
         — and this bind mount covers that directory entirely. The container sees
         the DEPLOYMENT's bundle at that path and nothing of the image's own.

         That is the intended behaviour, not an accident of mount ordering. The
         bundle is operational knowledge: it is edited by operators and drafted
         into by the agents themselves, between image builds and without one.
         A container reading its baked copy would be reading a snapshot frozen at
         build time, and two personas built at different times would disagree
         about the facility. To change what a container sees, edit the
         deployment's bundle; to change what a fresh deployment STARTS from,
         edit the persona's.

         Read-WRITE, unlike the qmd sidecar's `:ro` mount of the same directory.
         The agent drafts concepts here; the sidecar only indexes them. The
         shared group that lets one container's draft be read by the next (and by
         the sidecar) comes from the setgid mode the deploy path provisions this
         directory with — see compose_generator.ensure_shared_corpus_dir.

         Source is the ONE deployment bundle for every user, so the corpus is
         genuinely shared rather than per-user copies. The target is per service:
         it comes from render._container_bundle_dir(), which anchors
         `facility_knowledge.bundle_path` on THIS persona's
         container_project_dir, because two personas built from different
         projects read the bundle at two different in-container paths.

         The short form below is a YAML comment, not a Jinja one, so it survives
         into the rendered build/docker-compose.web.yml — which is the file an
         operator on the deploy host actually opens when a baked concept has
         gone missing. #}
      # The DEPLOYMENT's facility-knowledge bundle, shared by every entitled
      # user. This SHADOWS the copy baked into the persona image at this path,
      # by design: the bundle is edited between image builds, and a container
      # reading its baked copy would serve a snapshot frozen at build time.
      # Edit the deployment's bundle to change what runs; edit the persona's to
      # change what a fresh deployment starts from.
      #
      # SHARING: the deploy makes this directory setgid + group-writable, so
      # every file written into it is owned by the directory's group whichever
      # container wrote it. Setgid decides which group OWNS a new file, not
      # which groups a process belongs to, so membership still has to come
      # from somewhere -- and this image gets it from TWO mechanisms that
      # cover different processes. `group_add` below reaches this container's
      # initial process; it does NOT survive this framework's own entrypoint
      # dropping privileges with `gosu`, which re-derives the dropped
      # process's supplementary groups from `/etc/group` and discards
      # whatever `group_add` granted. The join that DOES survive is the
      # entrypoint's own root-phase `/etc/group` entry for
      # OSPREY_FACILITY_BUNDLE_DIR (below), which is why both are here. If a
      # concept drafted in one terminal is unreadable in another, check both.
      # LIMIT: setgid does not change each file's permission BITS, which still
      # come from the writer's umask (usually 022 -> rw-r--r--). That is enough
      # for another container to READ a draft and for the qmd sidecar to index
      # it, but not for one container to overwrite another's file in place.
      - {{ facility_bundle_source }}:{{ svc.container_bundle_dir }}
{%- endif %}
{%- if ariel_mirror_source and svc.container_mirror_dir %}
      {#- THE DEPLOYMENT'S ARIEL MIRROR, at the path THIS persona's exporter
         writes. The `qmd_export` enhancement module runs inside every persona
         container that enables it — an entry enhanced from a terminal is
         mirrored by that terminal's own process — and it resolves `mirror_path`
         against the project root, which in here is this persona's
         container_project_dir (render._container_mirror_dir, the same
         derivation as the bundle target above). Without this bind the mirror
         it writes is a directory in the container's writable layer: the qmd
         sidecar, which indexes the HOST's mirror, never sees those entries, and
         the next recreate discards them.

         Source is the ONE deployment mirror for every user and for the host's
         own exporter, so the sidecar's corpus is the union of everything any
         process enhanced. Read-write, like the bundle and unlike the sidecar's
         `:ro` mount of the same directory; shared through the same setgid group
         (see `group_add` below). #}
      # The DEPLOYMENT's ARIEL qmd mirror, written by this container's own
      # qmd_export module and indexed by the qmd sidecar. Bound here so an entry
      # enhanced from this terminal reaches the sidecar's corpus instead of a
      # directory in the container's writable layer that nothing indexes and
      # the next recreate discards.
      - {{ ariel_mirror_source }}:{{ svc.container_mirror_dir }}
{%- endif %}
{%- for mount in svc.extra_mounts %}
      - {{ mount }}
{%- endfor %}
{#- Every shared host directory bound above, and the group each was provisioned
    with: the bundle and the mirror, where this service is entitled to them.
    Collected into one list so one `group_add:` is emitted per service, with
    each gid once — the deploy creates both as the same user, so they usually
    share a group, and compose rejects nothing for a repeat, but a list that
    says the same thing twice reads like two groups. This user's audit
    subdirectory is deliberately NOT in the list: its membership is granted
    inside the container by the entrypoint, which stats the mounted directory
    itself, so no gid is read back for it at render time. #}
{%- set shared_gids = [] %}
{%- if facility_bundle_gid and svc.container_bundle_dir and facility_bundle_gid not in shared_gids %}
{%- set _ = shared_gids.append(facility_bundle_gid) %}
{%- endif %}
{%- if ariel_mirror_gid and svc.container_mirror_dir and ariel_mirror_gid not in shared_gids %}
{%- set _ = shared_gids.append(ariel_mirror_gid) %}
{%- endif %}
{%- if shared_gids %}
    # Supplementary group(s) for the shared host directories mounted above (the
    # knowledge bundle, the ARIEL mirror -- whichever this service binds),
    # granted to this container's INITIAL process: a process is a MEMBER of
    # only the groups its image or its runtime gives it, and this is the
    # runtime half of that grant. On a framework-built image started the normal
    # way that half is NOT what carries access: the initial process is root,
    # which bypasses group checks anyway, and the grant the process actually
    # SERVING requests keeps is the entrypoint's own root-phase `/etc/group`
    # join for the mounted directories (above) -- `gosu` re-derives
    # supplementary groups from that file for the target user and discards
    # whatever this line granted the initial process.
    #
    # This line is what is left when that join never runs. A container started
    # with `--user` takes the entrypoint's non-root branch (`if [ "$(id -u)"
    # -ne 0 ] ... exec "$@"`), which skips both the join and the drop, so the
    # groups the runtime granted are the only membership the serving process
    # has. The same holds for any image started without this framework's
    # entrypoint at all. Dropping this line would silently take the bundle
    # and the mirror away from both.
    #
    # Each value is the directory's OWN group id, read off the host at render
    # time -- never a hardcoded id, which would be wrong on every host but the
    # one it was chosen on. Retarget it by chgrp'ing the directory and
    # re-running `osprey up`.
    group_add:
{%- for gid in shared_gids %}
      - "{{ gid }}"
{%- endfor %}
{%- endif %}
    healthcheck:
      # osprey web's own default listen port is the fixed constant 8087
      # (cli/web_cmd.py) — only relevant to a bare `osprey web` with no
      # OSPREY_WEB_PORT override. Every per-user container here sets
      # OSPREY_WEB_PORT above, so the probe targets the ACTUAL bound port,
      # never the bare 8087 default. Probed via bind_host itself (not a
      # hardcoded "127.0.0.1" literal) since that's the same loopback
      # address OSPREY_TERMINAL_BIND_HOST bakes into the app's own bind.
      test: ["CMD-SHELL", "curl -fsS http://{{ bind_host }}:{{ svc.web }}/health || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
{% endfor %}
{% if services %}

volumes:
{% for svc in services %}
  {{ svc.user }}-claude-config:
    labels:
      com.osprey.repo-id: "{{ repo_id }}"
  {{ svc.user }}-agent-data:
    labels:
      com.osprey.repo-id: "{{ repo_id }}"
{% endfor %}
{% endif %}
