# syntax=docker/dockerfile:1
# Reference container image for {{ project_name }} — rendered by `osprey build`.
#
# `osprey up` builds this for you. To build it by hand, do it from the container
# repo the build renders for exactly this purpose, one directory above the render
# this file sits in:
#   cd build/.image/{{ project_name }} && docker build -t {{ project_name }} -f build/Dockerfile .
# Run (secrets at runtime — no .env ever enters the image):
#   docker run --rm -p 8087:8087 --env-file .env {{ project_name }}
#
# The container starts as ROOT and does not stay there. `build/entrypoint.sh`
# re-renders any drifted Claude Code artifact and restores the operator's owned
# scaffold bodies — both writes into a render this image deliberately leaves
# root-owned — and only then drops to the unprivileged `osprey` user with
# `gosu` for the actual command. Running the image with `--user` skips the two
# startup steps and says so in the log rather than failing halfway through.
#
# Build args:
#   OSPREY_PIP_SPEC     pip requirement for OSPREY (default: PyPI release;
#                       override with a git+https URL or ==version to pin an
#                       unreleased build). The deps layer primes this spec with
#                       its dependencies, plus any local dependency delta staged
#                       as osprey-local-requirements.txt on dev builds. If
#                       `osprey up --dev` stages a local *.whl in the
#                       build context, a later wheel layer force-reinstalls
#                       osprey itself from that wheel on top of the primed deps.
#   OSPREY_DEV          "1" relaxes the deps layer: if the pinned OSPREY_PIP_SPEC
#                       is unreleased and fails to install, fall back to the
#                       latest published osprey-framework instead of failing.
#   CLAUDE_CLI_VERSION  Claude Code CLI version to pin (default: this
#                       project's claude_code.cli_version). Bump deliberately
#                       — an unpinned upstream release could silently change
#                       agent behavior between image builds.
#   PIP_NO_PROXY        hosts exempted from any proxy during pip install
#   OSPREY_OFFLINE      "1" vendors web assets into the image (air-gapped hosts)
#   OSPREY_SITE_CA      name of a site CA file staged in the build context, for
#                       networks where a proxy re-signs TLS with its own CA.
#                       Unset (the default), the CA layer is a no-op.

FROM python:3.12-slim
ARG OSPREY_PIP_SPEC="osprey-framework"
ARG OSPREY_DEV=""
ARG CLAUDE_CLI_VERSION={{ claude_code_cli_version }}
ARG PIP_NO_PROXY=""
ARG OSPREY_OFFLINE="0"
ARG OSPREY_SITE_CA=""

# Optional site CA, for building (and running) behind a TLS-intercepting proxy
# that re-signs traffic with a site CA. OSPREY_SITE_CA names a CA file (PEM)
# staged in the build context — COPY cannot reach outside it, so a build host
# stages a copy of its bundle beside the Dockerfile and passes the file name.
# The `.dockerignore` sibling keeps the glob COPY matching when nothing is
# staged (same idiom as the wheel layer below), and with the ARG unset the RUN
# is a no-op. This layer sits BEFORE every network fetch deliberately: apt,
# npm and pip below all verify TLS against the system store this extends.
#
# The ENVs point each tool family at the merged Debian bundle the install
# lands in — Node reads no system store without NODE_EXTRA_CA_CERTS, pip
# trusts only its bundled certifi without PIP_CERT, and SSL_CERT_FILE /
# REQUESTS_CA_BUNDLE cover Python's ssl module and requests. They persist into
# the running container, so runtime fetches trust the site CA too; with no CA
# staged they restate each tool's default bundle and change nothing.
COPY .dockerignore *.cr[t] *.pe[m] /tmp/ca-ctx/
RUN if [ -n "$OSPREY_SITE_CA" ]; then \
        cp "/tmp/ca-ctx/${OSPREY_SITE_CA}" /usr/local/share/ca-certificates/osprey-site-ca.crt \
        && update-ca-certificates; \
    fi \
 && rm -rf /tmp/ca-ctx
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Debian apt mirrors over HTTPS (plain-HTTP bulk fetches are throttled or
# broken by middleboxes on some networks; deb.debian.org supports HTTPS), and
# bounded apt retries with backoff so a transient network blip mid-build does
# not fail the whole image. Pipelining is disabled alongside those retries
# because retries alone were seen not to cover every blip: a CI build lost one
# 4.6 kB .deb to a peer connection reset while 70 other packages fetched fine
# from the same host, with Acquire::Retries already in effect. Apt's default of
# up to 10 requests per connection is the part of that failure we can act on —
# one request per connection is marginally slower and strictly easier to
# recover. Set for both schemes deliberately: these mirrors are rewritten to
# HTTPS just above, and apt keeps no https entry in its config tree unless one
# is written, so relying on a fallback from the http key is how this would
# quietly become a no-op.
RUN export http_proxy="${http_proxy:-${HTTP_PROXY:-}}" https_proxy="${https_proxy:-${HTTPS_PROXY:-}}" no_proxy="${no_proxy:-${NO_PROXY:-}}"; \
    find /etc/apt \( -name '*.sources' -o -name '*.list' \) \
    -exec sed -i 's|http://deb.debian.org|https://deb.debian.org|g' {} + \
 && printf 'Acquire::Retries "5";\nAcquire::http::Pipeline-Depth "0";\nAcquire::https::Pipeline-Depth "0";\n' > /etc/apt/apt.conf.d/80-osprey-retries

# Tools the agent's shell reaches for at runtime (curl, git, procps) and Node
# for the Claude Code CLI installed below. Node comes from the base image's own
# Debian release rather than a third-party apt repo, so the image has a single
# package provenance and needs no network beyond the Debian mirror to build. The
# CLI's engines floor is node >= 18, which every Debian release the slim bases
# resolve to satisfies.
#
# npm is a runtime dependency, not a build-time convenience: the agent is
# launched as `npx -y @anthropic-ai/claude-code@<version>` (claude_launcher.py),
# so npm must remain in the final image.
#
# `gosu` is what the entrypoint drops privileges with. It is a Debian package
# for the same reason Node is — one package provenance — and it is installed
# here, in the layer that changes least, rather than beside the entrypoint it
# serves: a privilege-drop tool added to the tail of the file would re-run apt
# on every render change. Without it the entrypoint refuses to start, which is
# the intended failure: the alternative is running the agent as root.
RUN export http_proxy="${http_proxy:-${HTTP_PROXY:-}}" https_proxy="${https_proxy:-${HTTPS_PROXY:-}}" no_proxy="${no_proxy:-${NO_PROXY:-}}"; \
    apt-get update \
 && apt-get install -y --no-install-recommends curl git procps ca-certificates gosu nodejs npm \
 && rm -rf /var/lib/apt/lists/*

# Claude Code CLI, pinned via CLAUDE_CLI_VERSION (npm global install) so an
# upstream release cannot silently change agent behavior between image
# builds — mirrors the dispatch-worker image's pinned install.
RUN export http_proxy="${http_proxy:-${HTTP_PROXY:-}}" https_proxy="${https_proxy:-${HTTPS_PROXY:-}}" no_proxy="${no_proxy:-${NO_PROXY:-}}"; \
    npm install -g "@anthropic-ai/claude-code@${CLAUDE_CLI_VERSION}"

# OSPREY + profile dependencies (deps layer). A C toolchain (build-essential +
# python3-dev) is needed at install time to compile native deps (e.g.
# accelerator-toolbox); it is purged in the same RUN so it never bloats the
# final image (mirrors the dispatch image). The pinned OSPREY_PIP_SPEC is primed
# here with its dependencies, plus any local dependency delta staged as
# osprey-local-requirements.txt by `osprey up --dev` — installed after
# the primer, while the toolchain is still available. The `.dockerignore` COPY
# sibling keeps the glob matching when no manifest is staged, so the deps cache
# only busts when the manifest content changes. When OSPREY_DEV=1 and the pinned
# spec is unreleased (the primer install fails), fall back to the latest
# published osprey-framework so dev builds are not blocked; otherwise the build
# fails loudly. A git+ OSPREY_PIP_SPEC points into the monorepo, so the
# osprey-connectors workspace member the framework requires is pre-installed
# from the same URL's packages/ subdirectory first — a commit-pinned build
# cannot assume a satisfying connectors release exists on PyPI (best-effort: a
# spec pip cannot take a #subdirectory fragment on falls through to PyPI).
COPY .dockerignore osprey-local-requirements.tx[t] /tmp/deps-ctx/
# setuptools 84.0.0 breaks setuptools_dso's compile-probe error handling
# (CompileError escapes uncaught), which fails any source build of the EPICS
# toolchain (pvxslibs/epicscorelibs/softioc) on platforms without a binary
# wheel — notably linux/arm64 images built on Apple Silicon. PIP_CONSTRAINT
# reaches pip's isolated build environments, where a plain requirement pin
# would not. Drop the constraint once a fixed setuptools or setuptools_dso
# release is out.
RUN export http_proxy="${http_proxy:-${HTTP_PROXY:-}}" https_proxy="${https_proxy:-${HTTPS_PROXY:-}}" no_proxy="${no_proxy:-${NO_PROXY:-}}"; \
    export NO_PROXY="$PIP_NO_PROXY" no_proxy="$PIP_NO_PROXY" \
    && printf 'setuptools<84\n' > /tmp/deps-ctx/pip-constraints.txt \
    && export PIP_CONSTRAINT=/tmp/deps-ctx/pip-constraints.txt \
    && apt-get update \
    && apt-get install -y --no-install-recommends build-essential python3-dev \
    && { case "$OSPREY_PIP_SPEC" in \
           git+*) pip install --no-cache-dir "osprey-connectors @ ${OSPREY_PIP_SPEC}#subdirectory=packages/osprey-connectors" \
                  || echo "WARNING: could not pre-install osprey-connectors from the git spec; resolving from PyPI" ;; \
         esac; } \
    && { pip install --no-cache-dir "$OSPREY_PIP_SPEC" {{ pip_dependency_args | default("") }} \
         || if [ "$OSPREY_DEV" = "1" ]; then \
                echo "WARNING: pin unreleased, priming with latest" \
                && pip install --no-cache-dir osprey-framework {{ pip_dependency_args | default("") }}; \
            else exit 1; fi; } \
    && if [ -f /tmp/deps-ctx/osprey-local-requirements.txt ]; then \
           pip install --no-cache-dir -r /tmp/deps-ctx/osprey-local-requirements.txt; \
       fi \
    && apt-get purge -y build-essential python3-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /tmp/deps-ctx

# Dev wheel drop (wheel layer). `osprey up --dev` stages a locally-built
# wheel in the build context; when present, reinstall osprey from it (deps
# first, then a --no-deps --force-reinstall so the local build wins over the
# primed copy) and `pip check` the result. With no wheel staged this RUN is a
# no-op (exit 0) and the image is complete after the deps layer. The
# `.dockerignore` sibling in the COPY glob guarantees the COPY always matches at
# least one file, so it never fails when no wheel exists.
COPY .dockerignore *.wh[l] /tmp/ctx/
RUN if ls /tmp/ctx/*.whl >/dev/null 2>&1; then \
        pip install --no-cache-dir /tmp/ctx/*.whl \
        && pip install --no-cache-dir --no-deps --force-reinstall /tmp/ctx/*.whl \
        && pip check; \
    fi \
    && rm -rf /tmp/ctx

# Optional offline mode: vendor web assets (JS/CSS/fonts) into the image so
# the web UI works without internet access. "0" is falsy for is_offline().
RUN if [ "$OSPREY_OFFLINE" = "1" ]; then osprey vendor fetch; fi
ENV OSPREY_OFFLINE=${OSPREY_OFFLINE}

# The deployment, verbatim. The build context is a deployment REPO — profile.yml
# and the source zone beside it, the render below in build/ — so this one COPY
# reproduces the repo layout inside the image, and nothing here has to know
# which directory is which. That is what makes `{project_root}/build/config.yml`
# (registry/mcp.py, and every server's OSPREY_CONFIG) as true in a container as
# it is on a host, and it is what lets `osprey web` below resolve the deployment
# it serves by walking up to profile.yml, exactly as every verb does on a host.
#
# `osprey build` renders that context specifically for the container, against
# this /app path rather than the building host's — see
# build_cmd._render_container_project. Building from the host's own build/
# instead would produce an image whose every recorded path points at the machine
# that built it.
COPY . /app/{{ project_name }}/
# The state zone, created here and not later: each of these directories is
# written by the unprivileged user at runtime, and a directory the image never
# created is created ROOT-owned at first start — by the volume mount for the
# first, by the first write for the others — which that user then cannot write
# to. Creating them before the chown below is what makes them writable.
#
#   var/agent_data/api_calls        must name the same directory as config.yml's
#                                   `agent_data.base_dir`; the agent-data volume
#                                   mounts here.
#   var/agent_data/config-backups   every config write copies the file here
#                                   BEFORE touching it (config_writer.
#                                   CONFIG_BACKUP_DIRNAME). Not writable, and
#                                   the admin Config panel's save fails without
#                                   a byte being written.
#   var/audit                       the protected-write refusal log
#                                   (workspace.AUDIT_DIR_RELPATH). A refusal
#                                   nobody can record is a refusal only the
#                                   agent's own transcript ever saw.
RUN mkdir -p /app/{{ project_name }}/var/agent_data/api_calls \
             /app/{{ project_name }}/var/agent_data/config-backups \
             /app/{{ project_name }}/var/audit

# The privilege split.
#
# The agent runs as `osprey` (Claude Code refuses bypassPermissions mode as
# root), and that user owns exactly the mutable state: `var/` — agent data,
# audit log, config backups — plus the facility-knowledge bundle it drafts
# concepts into. Everything else stays root-owned, and the render in `build/`
# is the part that matters: `config.yml`, `.mcp.json` and the `.claude/`
# artifacts are the files that decide what the agent may do, so an agent that
# can rewrite them can rewrite its own limits and no deny list, hook or
# approval policy outlives that. The two startup steps that legitimately write
# there — the drift regen and the scaffold restore — run as root in the
# entrypoint, once, before the server that serves requests exists.
#
# The bundle chown is conditional because the directory is: `osprey build`
# renders `build/data/facility_knowledge/` only for a deployment that names a
# `facility_knowledge.bundle_path`, and a chown of a path that is not there
# fails the build.
#
# uid/gid are PINNED rather than left to useradd's next-free, so they are a
# fact of this image instead of an accident of whichever Debian release the
# base resolves to: OSPREY_RUNTIME_UID below states the same pair, and the
# host-side seeding chowns each per-user volume to what that variable says
# (deployment/web_terminals/seeding.py). A base image that ever ships its own
# uid 1000 fails this line loudly, which is the right way to find out.
RUN groupadd --gid 1000 osprey \
 && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash osprey \
 && chown -R osprey:osprey /app/{{ project_name }}/var \
 && if [ -d /app/{{ project_name }}/build/data/facility_knowledge ]; then \
        chown -R osprey:osprey /app/{{ project_name }}/build/data/facility_knowledge; \
    fi
{% if is_setup_patch_capable %}
# This persona keeps the setup capability — its permission render leaves
# `mcp__osprey_workspace__setup_patch` outside the deny list — so the one file
# that capability exists to edit is handed to the agent's user. Rendered ONLY
# for such a persona: for every other tier this line is absent and `config.yml`
# stays root-owned, which is what makes the tier boundary a filesystem fact
# rather than a permission list the agent is asked to respect.
RUN chown osprey:osprey /app/{{ project_name }}/build/config.yml
{% endif %}
# No USER instruction, deliberately: the container starts as root so the
# entrypoint can perform the two root-only startup writes, and drops to
# `osprey` itself. Adding one back would make the entrypoint's regen and
# restore silent no-ops.
ENV HOME=/home/osprey
# The user the entrypoint drops to, numerically, for anything outside the
# container that has to agree with it — the per-user volume seeding reads this
# out of the running image rather than guessing (seeding.py). `uid:gid`.
ENV OSPREY_RUNTIME_UID=1000:1000
# The render is root-owned in this image, so the server must not attempt the
# writes it would make on a host — a bare-host deployment self-heals a drifted
# artifact, here that same write is a 500 the operator cannot fix. The web app
# reads this and skips them, saying so once at startup.
ENV OSPREY_RENDER_ZONE_READONLY=1
WORKDIR /app/{{ project_name }}
EXPOSE 8087
# The entrypoint ships inside the render (`osprey build` emits it beside
# config.yml) and the COPY above carries it in with its exec bit, so it is
# named at its rendered path rather than installed somewhere else. It runs the
# startup regen and scaffold restore as root, then `exec gosu osprey "$@"` —
# and "$@" is the CMD below, so overriding the command on `docker run` still
# goes through the privilege drop.
ENTRYPOINT ["/app/{{ project_name }}/build/entrypoint.sh"]
# No location flag: `osprey web` discovers its deployment by walking up from the
# working directory, and WORKDIR above is already that directory.
CMD ["osprey", "web", "--host", "0.0.0.0", "--port", "8087"]
