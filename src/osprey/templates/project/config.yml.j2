{#-
  The framework configuration template.

  It renders ONLY what the build DERIVES — the project layout, the port
  layout, the provider catalog, and the handful of keys a profile FIELD
  (`provider:`, `model:`, `channel_finder_mode:`, `default_panel:`,
  `panel_presets:`) decides. Everything an operator may state lives in
  `profile.yml`'s `config:` block, documented on the line that sets it, and is
  applied over this render on the ordinary config-override path.

  So a key belongs here only if `osprey.cli.derived_keys.DERIVED_KEYS` claims
  it (plus `api.providers`, which `providers.yml` owns and this file is the one
  writer of). Adding anything else would give one fact two homes, and the
  losing copy would be the silent one.

  `web:` renders only when it has a member: `interfaces/web_terminal/app.py`
  cannot load a bare `web:` mapping.
-#}
{%- macro yaml_block(node, indent) -%}
{%- for key, value in node.items() -%}
{%- if value is mapping and value %}
{{ indent }}{{ key | tojson }}:
{{- yaml_block(value, indent ~ "  ") }}
{%- elif value is mapping %}
{{ indent }}{{ key | tojson }}: {}
{%- else %}
{{ indent }}{{ key | tojson }}: {{ value | tojson }}
{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
# ============================================================
# GENERATED — {{ project_name }}
# ============================================================
# Written by `osprey build`. Every build clears and re-renders it, so an edit
# here is discarded: edit `profile.yml` (and `providers.yml`) instead, then
# rebuild. This file holds the keys the BUILD derives; the rest arrive from the
# profile's own `config:` block, which is where they are documented.
# ============================================================

# ── Project layout ──────────────────────────────────────────
# Taken from the repository this render was made in. `project_root` is the
# REPO root, not this file's directory: every relative path below is anchored
# on it, and build/ is wiped by each build.
project_name: "{{ project_name }}"
project_root: {{ project_root }}
build_dir: ./build

# Working directory for artifacts, data context, screenshots. Under var/, the
# durable STATE zone — the project Dockerfile pre-creates the same path before
# it chowns the tree, so the two must name one directory.
agent_data:
  base_dir: "var/agent_data"

# Subdirectory names within the agent data directory above.
file_paths:
  api_calls_dir: api_calls
  registry_exports_dir: registry_exports

# ── Build provenance ────────────────────────────────────────
# The environment declaration this project was built from, recorded so the
# build can be reproduced. Nothing reads it at run time, and editing it here
# changes nothing — rebuild to change the environment.
#   python           base interpreter the build profile declared. null means
#                    the build used its own interpreter; its installed
#                    packages are deliberately not carried over.
#   packages         extra requirements installed on top of the base.
#   inherit_exclude  distributions left out when a declared venv base is frozen.
execution:
  environment:
    python: {{ environment_python | default(none) | tojson }}
    packages: {{ environment_packages | default([]) | tojson }}
    inherit_exclude: {{ environment_inherit_exclude | default([]) | tojson }}

# ── Port layout ─────────────────────────────────────────────
# The artifact gallery's host port, from this deployment's `deployment.port_base`.
# OSPREY_ARTIFACT_SERVER_PORT still outranks it at run time.
artifact_server:
  port: {{ osprey_ports.artifact }}

# ── Which model answers ─────────────────────────────────────
# From the profile's `provider:` and `model:` fields. `provider` names an entry
# of `api.providers` below; `default_model` is a tier (haiku | sonnet | opus)
# resolved through that entry's `models` map.
claude_code:
  provider: {{ default_provider }}
  default_model: {{ default_model | default("haiku") }}
{% if default_pipeline is defined and default_pipeline %}
# ── Channel finder ──────────────────────────────────────────
# From the profile's `channel_finder_mode:` field. The mode selects the
# paradigm and, with it, the one pipeline block that configures it. `graph`
# names nothing here: it answers from the Neo4j store declared under
# `services.graphdb`, so the mode plus that block is its whole configuration
# and this section renders no pipeline.
channel_finder:
  pipeline_mode: {{ default_pipeline }}

  pipelines:
{%- if enable_in_context | default(false) %}
    # In-Context (semantic search) — best for a few hundred channels.
    in_context:
      database:
        type: template                # "template" (device-family expansion) or "flat"
        path: data/channel_databases/in_context.json
        presentation_mode: template   # Preview rendering only — `osprey channel-finder
                                      # preview` honours it; the MCP server and the web UI
                                      # build their own prompt text and never consult it.
                                      # "explicit" lists every expanded name instead.
      # Inner LLM model for the ask_channels subagent tool (set per benchmark
      # cell at run time).
      subagent_model: null
{%- endif %}
{%- if enable_hierarchical | default(false) %}
    # Hierarchical (structured navigation) — best for >1,000 channels with a
    # clean naming convention.
    hierarchical:
      database:
        type: hierarchical            # Always "hierarchical" for this pipeline mode
        path: data/channel_databases/hierarchical.json
                                      # Nested: system -> family -> device -> field -> subfield
      # Feedback loop: records successful navigation paths so an identical
      # future query resolves from the prior path.
      feedback:
        enabled: true
        store_path: var/agent_data/feedback/hierarchical_feedback.json
                                      # Written at run time, so it lives in the var/
                                      # STATE zone alongside agent_data.base_dir —
                                      # data/ is rebuilt from the profile and every
                                      # build clears build/.
{%- endif %}
{%- if enable_middle_layer | default(false) %}
    # Middle Layer (react agent over an MML database) — best for MATLAB Middle
    # Layer style databases (System -> Family -> Field).
    middle_layer:
      database:
        type: middle_layer            # Always "middle_layer" for this pipeline mode
        path: data/channel_databases/middle_layer.json
                                      # MML structure: System -> Family -> Field -> ChannelNames
        # duckdb_path gates the `run_sql` SQL/FTS tool: with it unset that one
        # tool returns `not_configured` and the other middle-layer tools carry
        # on working. Nothing in build, scaffold or deploy creates the file —
        # build it from the JSON above yourself:
        #   python -m osprey.services.channel_finder.databases.duckdb_import \
        #     --json data/channel_databases/middle_layer.json \
        #     --output data/channel_databases/middle_layer.duckdb
        # A relative path resolves against this config file's directory.
        # duckdb_path: data/channel_databases/middle_layer.duckdb
{%- endif %}
{%- endif %}
{%- if ariel_server_on | default(false) %}

# ── Logbook composition ─────────────────────────────────────
# From the profile's `provider:` field. The compose panel resolves its tier
# through api.providers[provider].models.
logbook:
  composition:
    provider: {{ default_provider }}

# ── ARIEL semantic processor ────────────────────────────────
# From the profile's `provider:` and `model:` fields. The module has no
# fallback to claude_code.provider, so the build states it here.
ariel:
  enhancement_modules:
    semantic_processor:
      provider: {{ default_provider }}
      model:
        model_id: {{ default_model }}
{%- endif %}
{%- set _builtin_panels = builtin_panels | default([]) %}
{%- set _enabled_builtin_panels = selected_web_panels | default([]) | select("in", _builtin_panels) | list %}
{%- set _has_default_panel = default_panel is defined and default_panel %}
{%- set _has_presets = panel_presets is defined and panel_presets %}
{%- if _has_default_panel or _enabled_builtin_panels or _has_presets %}

# ── Web workspace ───────────────────────────────────────────
# From the profile's `web_panels:`, `default_panel:` and `panel_presets:`
# fields. A tab shows because the selection names it; a `web.panels.<id>`
# block that says otherwise is refused at build time.
web:
{%- if _has_default_panel %}
  # Tab focused on cold load. Falls back to "artifacts" (Workspace) when unset.
  default_panel: {{ default_panel }}
{%- endif %}
{%- if _enabled_builtin_panels %}
  panels:
{%- for panel in _enabled_builtin_panels %}
    {{ panel }}:
      enabled: true
{%- endfor %}
{%- else %}
  panels: {}  # No builtin panels selected; custom panels arrive from `config:`.
{%- endif %}
{%- if _has_presets %}
  # Panel layouts ("Layouts"): named sets of panels a human applies in one
  # click from the "+" popover. The key is the menu label; the value is the
  # exact set of panels to show (non-member panels close).
  presets:
{%- for preset_name, preset_panels in panel_presets.items() %}
    {{ preset_name | tojson }}: [{{ preset_panels | join(", ") }}]
{%- endfor %}
{%- endif %}
{%- endif %}
{%- if provider_catalog is defined and provider_catalog %}

# ── Provider catalog ────────────────────────────────────────
# `providers.yml` beside profile.yml, rendered verbatim. Add or re-point a
# gateway there, not here. `claude_code.provider` above names one of these
# entries; each entry's `models` map resolves the haiku/sonnet/opus tiers to
# that provider's own model IDs. API keys are ${ENV_VAR} references expanded
# from the project .env at run time.
api:
  providers:
{{- yaml_block(provider_catalog, "    ") }}
{%- endif %}
