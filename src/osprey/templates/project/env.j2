# {{ project_name }} Environment Configuration
#
# Derived from the build profile's `.env`, which is the source of truth for
# this project's secrets: a value set there survives every rebuild, and is
# carried in below under the "Carried from the profile .env" heading. Provider
# API keys included — set them in the profile, not here.
#
# Nothing is read from the environment `osprey build` happened to run in. An
# ambient key would make the build non-reproducible in a way invisible in this
# file, and would reach this project — and every container started from it —
# without ever being recorded in the profile that is meant to account for it.

# Project Configuration (Optional - for advanced use cases)
# Uncomment if you need to override the project root set in config.yml
# Useful for multi-environment deployments or if you move the project directory
# (to make an override survive a rebuild, set it in the profile `.env` instead)
#PROJECT_ROOT={{ project_root }}
#LOCAL_PYTHON_VENV={{ current_python_env }}
{% if va_channels_file %}
# Virtual Accelerator channel source. Build-derived: the build writes these
# from this project's own channel databases and rewrites them on every
# rebuild, so editing them here has no lasting effect (see
# osprey.utils.dotenv.BUILD_DERIVED_KEYS). They disappear again if a later
# build can no longer generate the manifest.
VA_CHANNELS_FILE={{ va_channels_file }}
VA_LATTICE={{ va_lattice }}
{% endif -%}
