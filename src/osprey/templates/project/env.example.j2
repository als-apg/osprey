# {{ project_name }} Environment Configuration
#
# The single documented list of every variable this agent reads. Copy it to
# `.env` beside your build profile and fill in the values you need — the build
# derives the project's own `.env` from that file, so the profile is where a
# secret survives a rebuild.
#
# This file carries no secrets and is safe to commit.

# API Keys — set the key(s) for the provider(s) your config.yml uses.
# (Provider list derived from the OSPREY provider registry.)
{% for entry in provider_api_keys -%}
{{ entry.var }}=your-{{ entry.provider }}-api-key-here
{% endfor %}
{%- if env_required %}
# Required by this profile — the build profile's `env.required` names these,
# and the agent cannot run without them.
{% for var in env_required -%}
{{ var }}=
{% endfor %}
{%- endif %}
{%- if env_defaults %}
# Declared by this profile with a default (`env.defaults`). Override only if
# your facility needs a different value.
{% for var, value in env_defaults.items() -%}
{{ var }}={{ value }}
{% endfor %}
{%- endif %}
# Project Configuration (Optional - for advanced use cases)
# Uncomment if you need to override the project root set in config.yml
#PROJECT_ROOT={{ project_root }}
#LOCAL_PYTHON_VENV=/path/to/your/venv/bin/python

# Optional: Proxy settings (uncomment if behind corporate firewall)
# NO_PROXY=localhost,127.0.0.1
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# Service credentials — minted automatically by `osprey deploy up` when the
# matching service is deployed, and written back to the profile `.env`. Set one
# by hand only to pin a value the deploy must not replace (an existing database
# volume's password, say); an unset variable is minted, never guessed.
{% for entry in service_token_vars -%}
# {{ entry.var }}=  # {{ entry.services }}{% if entry.note %} — {{ entry.note }}{% endif %}
{% endfor -%}
