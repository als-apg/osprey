{#- This file's RENDER is pinned byte for byte by the suites below. Any
    edit — a reworded comment included — reddens their goldens until they
    are regenerated in the same change. One command per suite that pins
    THIS template:

      PYTHONPATH=src ./.venv/bin/python tests/templates/test_render_defaults_golden.py
      PYTHONPATH=src ./.venv/bin/python tests/templates/test_render_axis_shapes.py
-#}
{%- import "services/_env_axis.j2" as hostenv -%}
{%- import "services/_site_image_args.j2" as site -%}
{#- The `build:` gate: rendered only while this service runs the image
    OSPREY builds, by the shared macro so every built template gates alike. -#}
{%- import "services/_own_image.j2" as own -%}
{%- set svc = services.optimizer -%}
{%- set port = svc.port | default(osprey_ports.optimizer, true) -%}
{%- set targets = svc.targets | default(['va'], true) -%}
# The optimizer service: a FastAPI process (osprey_optimizer.api.main) that runs
# Xopt-driven optimizations against the control system, and the Redis job store
# it keeps its jobs, locks and cancellation flags in.
# Its image is built from the Dockerfile beside this file unless
# services.optimizer.image names a different image, which this file then runs
# as named with no build. OSPREY_OPTIMIZER_IMAGE names one for a single shell,
# and a start that reads it builds nothing for this service.
# Use `osprey build --dev` to bake in your local optimizer and connectors
# checkout via wheels; otherwise the image installs them from PyPI.

services:
  optimizer:
    image: ${OSPREY_OPTIMIZER_IMAGE:-{{ svc.image | default(osprey_images.optimizer) }}}
{%- call own.build(svc.image, osprey_images.optimizer) %}
    build:
      # Relative paths resolve against the compose project directory, the
      # deployment repo root, never this file's own subdir.
      context: ./build/services/optimizer
      dockerfile: Dockerfile
      args:
        OSPREY_VERSION: "{{ osprey_version | default('') }}"
        OSPREY_PROJECT_NAME: "{{ osprey_labels.project_name }}"
{{- site.build_args(site_image_build_args | default({})) }}
{% if dev_mode | default(false) %}
        OSPREY_DEV: "1"
{% endif %}
{%- if osprey_pip_pre | default(false) %}
        OSPREY_PIP_PRE: "1"
{%- endif %}
{%- endcall %}
    depends_on:
      optimizer-redis:
        condition: service_healthy
{%- if 'virtual_accelerator' in deployed_services and 'va' in targets %}
      # Only when the Virtual Accelerator is co-deployed and this optimizer may
      # drive it: a run must not open its connector before the VA's Channel
      # Access server answers. Compose errors on a depends_on naming a service
      # no document defines, hence the co-deployment test.
      virtual-accelerator:
        condition: service_healthy
{%- endif %}
{%- if 'live_standin' in deployed_services and 'standin' in targets %}
      # The same guard on the stand-in soft IOC, when this optimizer may drive it.
      live-standin:
        condition: service_healthy
{%- endif %}
    # container_name is a HOST-GLOBAL docker identifier: namespaced per project.
    # In-network consumers reach this service by its compose key `optimizer`.
    container_name: {{ osprey_labels.project_name }}-optimizer
    # An init process is PID 1, not uvicorn: the connector-host children the
    # service starts treat a parent of PID 1 as gone and exit at once, so with
    # uvicorn there every read and write of the machine fails. It also forwards
    # SIGTERM and reaps the exited children.
    init: true
    # The service runs as root, so before it starts root is renamed to the
    # optimizer's control identity (uid 0 keeps its number) and every write it
    # makes names the optimizer in the put-log. The name labels and guards
    # nothing, so a failed rename warns and the service starts as `root`. The
    # `;` is load-bearing: uvicorn starts on either outcome.
{%- if svc.writes_enabled %}
    # Then a write probe of the write ledger (OSPREY_WRITE_LEDGER_DIR): root
    # needs no group to write it, but a bind that cannot be written leaves
    # every run unable to ask for or spend a write authorization, and every
    # write refused `auth_unreadable`, so it warns here. `$$` is compose's
    # escape: the shell sees one `$`. The probe redirects `true`, not `:`: a
    # failed redirection on a special builtin exits a POSIX shell, which would
    # stop the service instead of warning.
{%- endif %}
    command:
      - "sh"
      - "-c"
      - >-
        python {{ control_identity_container_path }} apply --uid 0 --name {{ optimizer_control_identity }}
        || echo "WARNING: control identity {{ optimizer_control_identity }} not applied; the optimizer writes as root" >&2;
{%- if svc.writes_enabled %}
        probe="$$OSPREY_WRITE_LEDGER_DIR/.osprey-write-probe";
        { true > "$$probe" && rm -f "$$probe"; } 2> /dev/null
        || echo "WARNING: OSPREY_WRITE_LEDGER_DIR=$$OSPREY_WRITE_LEDGER_DIR cannot be written; every optimizer write will be refused auth_unreadable" >&2;
{%- endif %}
        exec uvicorn osprey_optimizer.api.main:app --host 0.0.0.0 --port {{ port }}
    restart: unless-stopped
    ports:
      - "{{ deployment.bind_address | default('127.0.0.1') }}:{{ port }}:{{ port }}"
    environment:
      # The mounted config, named twice for its two kinds of reader: the
      # connectors read CONFIG_FILE, the framework's config loader
      # OSPREY_CONFIG. Its control_system section is where each target's
      # connector block, gateway and write posture come from.
      CONFIG_FILE: /app/project/config.yml
      OSPREY_CONFIG: /app/project/config.yml
      TZ: {{ system.timezone }}
      # The job store, by its in-network compose key on the internal network.
      REDIS_URL: redis://optimizer-redis:6379/0
      # The environment files mounted below. Set even with no directory
      # mounted, so the service never falls back to its working directory.
      OPTIMIZER_ENVIRONMENTS_DIR: /app/environments
      # Where runs are written: the results volume mounted below.
      OPTIMIZER_RESULTS_DIR: /app/results
      # The control targets this deployment's optimizer may drive. The live
      # machine is refused at build time until the optimizer supports it.
      OPTIMIZER_TARGETS: "{{ targets | join(',') }}"
      # No :-default — an unset token stays EMPTY, so the routes that move
      # hardware refuse rather than accept a guessable secret. `osprey up`
      # mints it into the project .env when unset (container_lifecycle's
      # per-service token-mint map).
      OPTIMIZER_LAUNCH_TOKEN: ${OPTIMIZER_LAUNCH_TOKEN}
      # Who this service's audit records are written as: its compose key. It
      # is also the holder every write authorization the optimizer asks for
      # names, and the one its connector children are checked against.
      OSPREY_AUDIT_IDENTITY: optimizer
      # Where it appends its agent-record events and keeps its own state: its
      # own directories in the two zones, bound below.
      OSPREY_SPOOL_DIR: {{ osprey_service_container_spool_dir }}/optimizer
      OSPREY_STATE_DIR: {{ osprey_service_container_state_dir }}/optimizer
{%- if svc.writes_enabled %}
      # The read-only control-context tree, mounted below: the connector judges
      # an owned write against the record the identity behind it last wrote.
      # Gated on the write tier like the limits mount: with a tier that allows
      # no writes the tree is a bind nothing reads.
      OSPREY_CONTROL_CONTEXT_TREE: {{ osprey_container_control_tree_dir }}
      # The write ledger, mounted read-write below: where a run writes the
      # request a person approves, and where its connector child spends the
      # authorization's steps and the run renews its lease. Bound with the
      # tree, because under a bound tree a writer with no ledger directory has
      # every write refused.
      OSPREY_WRITE_LEDGER_DIR: {{ write_ledger_container_dir }}
{%- endif %}
{{- hostenv.passthrough(svc) }}
    volumes:
      - ./build/services/optimizer/config.yml:/app/project/config.yml:ro
      # The control-identity script the command runs, with its catalog
      # closure beside it, staged into this build context by compose_generator
      # byte for byte. Read-only: it runs as root, so nothing inside may edit it.
      - ./build/services/optimizer/control_identity:{{ control_identity_container_dir }}:ro
      # This service's spool and state directories, and only its own,
      # provisioned host-side before the mount is created
      # (compose_generator.FIXED_SERVICE_AUDIT_IDENTITIES).
      - {{ osprey_spool_mount_source }}/optimizer:{{ osprey_service_container_spool_dir }}/optimizer
      - {{ osprey_state_zone_mount_source }}/optimizer:{{ osprey_service_container_state_dir }}/optimizer
      # Run results (configs, evaluated points, best points): the operator's
      # record of what the optimizer did, kept across container restarts.
      - optimizer_results:/app/results
{%- if svc.environments_dir %}
      # services.optimizer.environments_dir, mounted read-only. The injector
      # stores it compose-ready (a relative path `./`-prefixed, resolving
      # against the repo root), so it renders verbatim.
      - {{ svc.environments_dir }}:/app/environments:ro
{%- endif %}
{%- if svc.writes_enabled and limits_mount is defined %}
      # The channel-limits database the connector checks every write against,
      # as finished strings computed host-side by `resolve_limits_mount`.
      - {{ limits_mount.source }}:{{ limits_mount.target }}:ro
{%- endif %}
{%- if svc.writes_enabled %}
      # The control-context tree, read-only and outside the project's state
      # zone, computed host-side like the limits mount above.
      - {{ osprey_control_tree_mount_source }}:{{ osprey_container_control_tree_dir }}:ro
      # The deployment's write ledger, READ-WRITE and outside the state zone:
      # the run's requests, its ledgers and its self-issued grants. The deploy
      # provisions it setgid + group-writable; every web terminal reads its
      # requests/ through a read-only bind of its own.
      - {{ write_ledger_mount_source }}:{{ write_ledger_container_dir }}
{%- endif %}
    networks:
      # osprey-network to reach the control system's Channel Access servers;
      # optimizer-internal for the job store.
      - osprey-network
      - optimizer-internal
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:{{ port }}/health').status==200 else 1)\""]
      interval: 10s
      timeout: 5s
      retries: 5
      # Importing the search stack (torch, BoTorch) takes several seconds.
      start_period: 30s

  optimizer-redis:
    image: ${OSPREY_OPTIMIZER_REDIS_IMAGE:-{{ svc.redis_image | default('redis:7.4-alpine') }}}
    container_name: {{ osprey_labels.project_name }}-optimizer-redis
    command: ["redis-server", "--appendonly", "yes"]
    restart: unless-stopped
    environment:
      TZ: {{ system.timezone }}
{#- The same env passthrough as the optimizer's: Redis reads none of it, and
    leaving the sidecar out would make the axis mean something different here
    than in every other file. -#}
{{- hostenv.passthrough(svc) }}
    volumes:
      - optimizer_redis:/data
    networks:
      # ONLY the internal network, and no published ports: the job store is
      # the optimizer's alone.
      - optimizer-internal
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

networks:
  osprey-network:
  # `internal: true` cuts the job store off from every other container and
  # from the outside; the optimizer reaches it here.
  optimizer-internal:
    internal: true

volumes:
  optimizer_redis:
  optimizer_results:
