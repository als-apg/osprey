    edit — a reworded comment included — reddens their goldens until they
    are regenerated in the same change. One command per suite that pins
    THIS template:

      PYTHONPATH=src ./.venv/bin/python tests/templates/test_render_defaults_golden.py
      PYTHONPATH=src ./.venv/bin/python tests/templates/test_render_axis_shapes.py
-#}
{#- Both shared axes — this service's network membership with the file-level
    `networks:` stanza that matches it, and the host variables its `env:` key
    names — are rendered by the shared macros rather than spelled out here, so
    every service template states the same topology the same way. -#}
{%- import "services/_network_axis.j2" as net -%}
{%- import "services/_env_axis.j2" as hostenv -%}
# The archive service keeps an append-only copy of this deployment's agent
# record in the host directory var/archive/. It runs `osprey archive --watch`:
# one pass at start, then one every `services.archive.interval_seconds`. A pass
# copies what changed since the last one — web-terminal and dispatch
# transcripts, dispatch run records, artifact stores, plan-queue history, the
# audit ledger — and, when the deployment runs the telemetry store, every
# completed day of its tables and query log as Parquet. Every source is mounted
# read-only; the archive never deletes or rewrites a copy.
#
# It runs the PROJECT image (<project>:local) that `osprey up` builds from the
# project root, and overrides only its entrypoint. OSPREY_WORKER_IMAGE
# overrides with a prebuilt/published image. There is deliberately NO `build:`
# block: the project image is built once by `osprey up` before `docker compose
# up` runs, and a second `build:` for the same tag would race the sole builder.
{%- set svc = services.archive | default({}, true) %}
{%- set on_host = (svc.network | default('bridge', true)) == 'host' %}
{%- set src = osprey_archive %}

services:
  archive:
    image: ${OSPREY_WORKER_IMAGE:-{{ svc.image | default(osprey_images.worker) }}}
    # container_name is a HOST-GLOBAL docker identifier: namespace it
    # per-project so two OSPREY projects can run an archive on one host.
    container_name: {{ osprey_labels.project_name }}-archive
    # The image entrypoint always drops to the unprivileged `osprey` user
    # before it runs anything; this bypasses it on purpose. Container root is
    # the invoking user under rootless podman, so a 0700 archive root that user
    # owns is writable and every copy lands owned by that user; under rootful
    # docker the command hands what it writes to the archive root's owner. It
    # is also the only identity that can read every source volume — the Redis
    # files belong to the redis uid. The agent never runs in this container.
    entrypoint: ["osprey", "archive", "--watch"]
    user: "0:0"
    security_opt: ["no-new-privileges:true"]
    # DAC_OVERRIDE reads files other uids own; CHOWN and FOWNER hand created
    # files to the archive root's owner and set their modes.
    cap_drop: ["ALL"]
    cap_add: ["CHOWN", "DAC_OVERRIDE", "FOWNER"]
    labels:
      # Content fingerprint of the env chain (runtime_helper's
      # env_chain_digest, carried in by OSPREY_ENV_DIGEST). A changed chain
      # has to recreate this container.
      osprey.env.digest: "${OSPREY_ENV_DIGEST:-}"
{%- if 'telemetry_store' in (deployed_services | default([], true)) %}
      # The same trigger for the archive's own store account file.
      osprey.telemetry.cred.digest: "${OSPREY_TELEMETRY_DIGEST_ARCHIVE:-}"
{%- endif %}
    restart: unless-stopped
    # No `ports:` and no `healthcheck:`: this service opens no socket. Its
    # liveness is the `archive_last_pass` health row reading the archive's own
    # manifests, as `ariel_last_ingestion` is for the mirror.
{%- if src.workers or src.lanes %}

    # The owner of each worker and lane volume mounts it first, so a fresh
    # volume is initialized from the owner's image (the worker's agent-data
    # ownership, Redis's /data) and never from this container's empty mount
    # point. Terminal volumes are another slice's and cannot be ordered; the
    # web-terminal seeding chowns them host-side.
    depends_on:
{%- for worker in src.workers %}
      {{ worker.service }}:
        condition: service_started
{%- endfor %}
{%- for lane in src.lanes %}
      {{ lane.service }}:
        condition: service_started
{%- endfor %}
{%- endif %}
{%- if osprey_env_chain | default([]) or 'telemetry_store' in (deployed_services | default([], true)) %}

    # The deployment's env is a CHAIN of files at the repo root, in ASCENDING
    # precedence; a later entry wins on any key an earlier one also sets.
    # Credentials arrive this way — never on the command line, where the
    # process list would show them. Only files that exist at render time are
    # listed.
    env_file:
{%- for env_chain_file in osprey_env_chain | default([]) %}
      - {{ env_chain_file }}
{%- endfor %}
{%- if 'telemetry_store' in (deployed_services | default([], true)) %}
      # The archive's account on the telemetry store: its own file at the
      # repo root, listed whenever the store is deployed — `osprey build`
      # creates it before this file is rendered.
      - .env.telemetry-archive
{%- endif %}
{%- endif %}

    environment:
      OSPREY_ARCHIVE_SOURCES: /archive/sources
      OSPREY_ARCHIVE_DEST: /archive/dest
      OSPREY_ARCHIVE_INTERVAL_SECONDS: "{{ src.interval_seconds }}"
{%- if src.telemetry_store %}
      # The store's service name on the bridge; on the host namespace this
      # container's loopback IS the host's, so the port the store publishes.
      OSPREY_ARCHIVE_STORE_URL: "{{ src.store_url }}"
      OSPREY_ARCHIVE_STORE_BACKFILL_DAYS: "{{ src.store_backfill_days }}"
{%- endif %}
      TZ: {{ system.timezone }}
{{- hostenv.passthrough(svc) }}
    # Bind-mount sources are relative to the pinned compose project directory,
    # which is the deployment REPO ROOT. Every source is read-only; the one
    # writable mount is the archive root.
    volumes:
      - {{ src.dest_source }}:/archive/dest
      - {{ src.audit_source }}:/archive/sources/audit:ro
{%- for terminal in src.terminals %}
      - {{ terminal.volume }}:/archive/sources/terminals/{{ terminal.user }}:ro
      - {{ terminal.agent_data_volume }}:/archive/sources/terminal_agent_data/{{ terminal.user }}:ro
{%- endfor %}
{%- for worker in src.workers %}
      - {{ worker.volume }}:/archive/sources/dispatch/{{ worker.name }}:ro
{%- endfor %}
{%- for lane in src.lanes %}
      - {{ lane.volume }}:/archive/sources/bluesky/{{ lane.lane }}:ro
{%- endfor %}
{{- net.network(svc) }}
{%- if src.terminals %}

# The web terminals' volumes, declared under the same bare keys and with the
# same labels the web-terminal template declares. That template is rendered
# into the other slice of this compose project, so whichever slice creates a
# volume first creates the same one. The worker and lane volumes are declared
# once, by their owner, in this slice; the archive only references them. The
# archive creates no volume of its own and renames none.
volumes:
{%- for terminal in src.terminals %}
  {{ terminal.volume }}:
  {{ terminal.agent_data_volume }}:
{%- endfor %}
{%- endif %}
{{ net.network_declaration(svc) }}
