{%- import "services/_env_axis.j2" as hostenv -%}
# The history page: the across-users view of the agent record, served on the
# history page's origin under /history/. nginx asks the auth sidecar who the browser
# is (`/verify-history`), then forwards the request here with the person and
# the record viewer (all, own:<person> or reader:<name>) as X-Osprey-History-*
# headers, and with this service's gate secret. The page reads the agent record
# with its `history` login, naming that viewer on every read, so the record
# decides what a person sees.
#
# It is rendered exactly when the deployment's web terminals sign people in
# (password or oidc); it is never a `deployed_services` entry.
#
# It runs the PROJECT image (<project>:local) that `osprey up` builds from the
# project root, with the image's own entrypoint, which drops privileges before
# it runs the command. OSPREY_WORKER_IMAGE overrides with a prebuilt/published
# image. There is deliberately NO `build:` block: the project image is built
# once by `osprey up`, and a second `build:` for the same tag would race it.
{%- set svc = (services | default({}, true)).history | default({}, true) %}
{%- set page = osprey_history %}

services:
  history:
    image: ${OSPREY_WORKER_IMAGE:-{{ svc.image | default(osprey_images.worker) }}}
    # container_name is a HOST-GLOBAL docker identifier: namespace it
    # per-project so two OSPREY projects can serve a history page on one host.
    container_name: {{ osprey_labels.project_name }}-history
    command: ["osprey", "history", "--host", "0.0.0.0", "--port", "{{ page.container_port }}"]
    security_opt: ["no-new-privileges:true"]
    labels:
      # Recreates the container when its gate secret or its record login
      # changes: both files below are read once, at start.
      osprey.agent-record.cred.digest: "${OSPREY_AGENT_RECORD_DIGEST_HISTORY:-}"
    restart: unless-stopped
    # Two files at the repo root and nothing else: the agent record's
    # `history` login, and the gate secret nginx presents on every request it
    # forwards. `osprey build` creates both before this file is rendered.
    env_file:
      - .env.agent-record.login.history
      - .env.agent-record.history-gate
    environment:
      # The gate accepts the harvested OSPREY_TERMINAL_SECRET_HISTORY from the
      # gate file as an operator secret and names it `history`. There is no
      # OSPREY_TERMINAL_SECRET and no OSPREY_TERMINAL_BIND_HOST, so the
      # operator secret the gate mints for itself is held by nobody: only a
      # request nginx forwarded passes.
      OSPREY_TERMINAL_ACCEPT_ROSTER_SECRETS: "1"
      OSPREY_TERMINAL_ROSTER_OWNERS: "HISTORY=history"
      # The history page's origin, which browsers reach this page on.
      OSPREY_TERMINAL_EXTERNAL_ORIGIN: "{{ page.external_origin }}"
      # WHERE the page reads the agent record: its compose service on the
      # bridge network.
      OSPREY_AGENT_RECORD_URL: {{ osprey_agent_record_url }}
      # How far back the session list's "older" control steps: the
      # retention.
      OSPREY_HISTORY_MAX_DAYS: "{{ page.max_days }}"
      # WHO this page's records are written as (the web gate records every
      # refused request).
      OSPREY_AUDIT_IDENTITY: history
      # Its own spool and state directories, bound below; the image's
      # entrypoint joins their groups before it drops privileges.
      OSPREY_SPOOL_DIR: {{ osprey_container_spool_dir }}/history
      OSPREY_STATE_DIR: {{ osprey_container_state_dir }}/history
      TZ: {{ system.timezone }}
{{- hostenv.passthrough(svc) }}
    # Published on loopback only: the web tier's nginx runs on the host
    # network and reaches the page there; nothing else may.
    ports:
      - "127.0.0.1:{{ page.port }}:{{ page.container_port }}"
    # This page's spool and state subdirectories, and only its own.
    volumes:
      - {{ osprey_spool_mount_source }}/history:{{ osprey_container_spool_dir }}/history
      - {{ osprey_state_zone_mount_source }}/history:{{ osprey_container_state_dir }}/history
    # Always on the compose network: the page dials the agent record by its
    # service name, and nginx reaches it on the loopback port above.
    networks:
      - osprey-network
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:{{ page.container_port }}/health').status==200 else 1)\""]
      interval: 10s
      timeout: 5s
      retries: 5

networks:
  osprey-network:
