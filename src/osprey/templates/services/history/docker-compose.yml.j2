{%- import "services/_env_axis.j2" as hostenv -%}
# The history page: the across-users view of the agent record, served on the
# readers' origin under /history/. nginx asks the auth sidecar who the browser
# is (`/verify-history`), then forwards the request here with the person, the
# store view user and that user's tables as X-Osprey-History-* headers, and
# with this service's gate secret. The page runs every query on the telemetry
# store as `EXECUTE AS <view user>`, so the store's grants and row policies
# decide what a person sees.
#
# It is rendered exactly when the deployment runs the store and its web
# terminals sign people in (password or oidc); it is never a
# `deployed_services` entry.
#
# It runs the PROJECT image (<project>:local) that `osprey up` builds from the
# project root, with the image's own entrypoint, which drops privileges before
# it runs the command. OSPREY_WORKER_IMAGE overrides with a prebuilt/published
# image. There is deliberately NO `build:` block: the project image is built
# once by `osprey up`, and a second `build:` for the same tag would race it.
{%- set svc = services.history | default({}, true) %}
{%- set page = osprey_history %}

services:
  history:
    image: ${OSPREY_WORKER_IMAGE:-{{ svc.image | default(osprey_images.worker) }}}
    # container_name is a HOST-GLOBAL docker identifier: namespace it
    # per-project so two OSPREY projects can serve a history page on one host.
    container_name: {{ osprey_labels.project_name }}-history
    command: ["osprey", "history", "--host", "0.0.0.0", "--port", "{{ page.container_port }}"]
    security_opt: ["no-new-privileges:true"]
    labels:
      # Recreates the container when its store account or its gate secret
      # changes: both files below are read once, at start.
      osprey.telemetry.cred.digest: "${OSPREY_TELEMETRY_DIGEST_HISTORY:-}"
    restart: unless-stopped
    depends_on:
      telemetry_store:
        condition: service_started
    # Two files at the repo root and nothing else: the store password of the
    # `history` account, and the gate secret nginx presents on every request
    # it forwards. `osprey build` creates both before this file is rendered.
    env_file:
      - .env.telemetry-history
      - .env.telemetry-history-gate
    environment:
      # The gate accepts the harvested OSPREY_TERMINAL_SECRET_HISTORY from the
      # gate file as an operator secret and names it `history`. There is no
      # OSPREY_TERMINAL_SECRET and no OSPREY_TERMINAL_BIND_HOST, so the
      # operator secret the gate mints for itself is held by nobody: only a
      # request nginx forwarded passes.
      OSPREY_TERMINAL_ACCEPT_ROSTER_SECRETS: "1"
      OSPREY_TERMINAL_ROSTER_OWNERS: "HISTORY=history"
      # The readers' origin, which browsers reach this page on.
      OSPREY_TERMINAL_EXTERNAL_ORIGIN: "{{ page.external_origin }}"
      # The store's service name on the compose network.
      OSPREY_HISTORY_STORE_URL: "{{ page.store_url }}"
      # Whose preflight rows the page reads: the rendered queueservers.
      OSPREY_HISTORY_QUEUESERVERS: "{{ page.queueservers | join(',') }}"
      # How far back the session list's "older" control steps: the store's
      # retention.
      OSPREY_HISTORY_MAX_DAYS: "{{ page.max_days }}"
      # WHO this page's audit records are written as (the web gate records
      # every refused request), and the one directory it writes them to; the
      # image's entrypoint joins that directory's group before it drops
      # privileges.
      OSPREY_AUDIT_IDENTITY: history
      OSPREY_AUDIT_DIR: {{ osprey_container_audit_dir }}/history
      TZ: {{ system.timezone }}
{{- hostenv.passthrough(svc) }}
    # Published on loopback only: the web tier's nginx runs on the host
    # network and reaches the page there; nothing else may.
    ports:
      - "127.0.0.1:{{ page.port }}:{{ page.container_port }}"
    # This page's audit subdirectory, and only its own.
    volumes:
      - {{ osprey_audit_mount_source }}/history:{{ osprey_container_audit_dir }}/history
    # Always on the compose network: the page dials the store by its service
    # name, and nginx reaches it on the loopback port above.
    networks:
      - osprey-network
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:{{ page.container_port }}/health').status==200 else 1)\""]
      interval: 10s
      timeout: 5s
      retries: 5

networks:
  osprey-network:
