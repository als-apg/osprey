# The virtual-accelerator service owns the PyAT-backed EPICS soft-IOC (see
# src/osprey/services/virtual_accelerator/). `osprey deploy up` builds its
# image locally on first run; subsequent runs reuse the local tag. To use a
# prebuilt/published image instead, set OSPREY_VA_IMAGE (e.g.
# OSPREY_VA_IMAGE=my-registry/osprey-va:dev).
# Use `osprey deploy up --dev` to bake in your local osprey checkout (incl.
# unreleased code) via a wheel; otherwise the image installs osprey from PyPI.
#
# ARCHITECTURE: linux/amd64, and on Apple Silicon that means emulation.
#
# The image is amd64-only by construction — Dockerfile pins
# `FROM --platform=linux/amd64` and hard-fails any other build arch, because
# pcaspy (the Channel Access server behind the serving stack) publishes no
# linux/aarch64 wheel at any interpreter. An arm64 image would build cleanly
# and then have no CA server at all, so the pin is a correctness guard, not a
# packaging shortcut. Read that Dockerfile's header before touching it.
#
# `platform:` below states that out loud rather than leaving it implicit. It
# is what the build already produces; declaring it means compose stops warning
# "the requested image's platform (linux/amd64) does not match the detected
# host platform (linux/arm64/v8)" on every single `deploy up` from an arm64
# machine — a warning that read as a defect when it was in fact the design.
# The cost it names is real and unchanged: on Apple Silicon the virtual
# accelerator runs under QEMU emulation and is correspondingly slower.
#
# OSPREY_VA_PLATFORM overrides it, for the one case the pin would otherwise
# get wrong: a published multi-arch OSPREY_VA_IMAGE that does have a native
# arm64 variant worth resolving to (`OSPREY_VA_PLATFORM=linux/arm64`).

services:
  virtual-accelerator:
    image: ${OSPREY_VA_IMAGE:-{{ services.virtual_accelerator.image | default(osprey_labels.project_name ~ '-va:local') }}}
    platform: ${OSPREY_VA_PLATFORM:-linux/amd64}
    build:
      # With multiple `-f` compose files, ALL relative paths (build contexts and
      # bind mounts alike) resolve against the FIRST file's dir — the compose
      # project directory, build/services/ — not this file's own subdir. So the
      # context is ./virtual_accelerator, matching the volume-path convention below.
      context: ./virtual_accelerator
      dockerfile: Dockerfile
      args:
        OSPREY_VERSION: "{{ osprey_version | default('') }}"
        OSPREY_PROJECT_NAME: "{{ osprey_labels.project_name }}"
{% if dev_mode | default(false) %}
        OSPREY_DEV: "1"
{% endif %}
    # container_name is a HOST-GLOBAL docker identifier: namespace it per-project
    # so two OSPREY projects can deploy the VA on one host without colliding on
    # one name. In-network consumers reach this service by its compose service
    # key `virtual-accelerator` (EPICS_CA_NAME_SERVERS, depends_on) — unchanged
    # here — so unlike postgres this rename needs no network alias.
    container_name: {{ osprey_labels.project_name }}-virtual-accelerator
    labels:
      osprey.project.name: "{{ osprey_labels.project_name }}"
      osprey.project.root: "{{ osprey_labels.project_root }}"
      osprey.deployed.at: "{{ osprey_labels.deployed_at }}"
    restart: unless-stopped
    ports:
      - "{{ deployment.bind_address | default('127.0.0.1') }}:{{ (services.virtual_accelerator | default({})).port | default(5064) }}:{{ (services.virtual_accelerator | default({})).port | default(5064) }}/tcp"
    environment:
      # EPICS_CA_SERVER_PORT is the standard EPICS server-side CA port
      # override, read directly by the CA library at iocInit — no
      # entrypoint.py change needed to make services.virtual_accelerator.port
      # actually control what the IOC binds to.
      EPICS_CA_SERVER_PORT: "{{ (services.virtual_accelerator | default({})).port | default(5064) }}"
      # Build-time stuck-readback apply fault (entrypoint.py reads it): a
      # comma-separated list of :SP addresses whose readback is frozen (SP still
      # latches, RB never follows). Passthrough from the project .env; unset →
      # no fault. Quoted so a value is never YAML-coerced.
      VA_STUCK_SETPOINTS: "${VA_STUCK_SETPOINTS:-}"
      # FR4 physics-fault apply faults (entrypoint.py parses and bounds each):
      # a per-BPM readout error and per-corrector calibration gain.
      # Passthrough from the project .env; unset -> no fault.
      VA_BPM_ERRORS: "${VA_BPM_ERRORS:-}"
      VA_CORR_GAIN: "${VA_CORR_GAIN:-}"
      # Facility-neutral source configuration (entrypoint.py + Dockerfile CMD
      # read these; empty means default): the entrypoint module to run, the
      # file-backed channel manifest, and whether the PyAT lattice is
      # constructed. Passthrough from the project .env; unset -> the
      # historical built-in behavior.
      VA_ENTRYPOINT_MODULE: "${VA_ENTRYPOINT_MODULE:-}"
      VA_CHANNELS_FILE: "${VA_CHANNELS_FILE:-}"
      VA_LATTICE: "${VA_LATTICE:-}"
      # Where the IOC polls active_scenarios — the second mount below, not the
      # build-owned data dir.
      VA_STATE_DIR: /state/simulation
      TZ: {{ system.timezone }}
    # Bind-mount sources are relative to the compose project directory
    # (build/services/), not this file's own subdir — hence the ../../ prefix
    # to reach the project root (see entrypoint.py's run contract: the IOC
    # SystemExits without a machine.json in the data dir). Both read-only —
    # the IOC only ever reads.
    #
    # Two mounts because the two directories have different owners: the
    # simulation model in data/ is build-owned (re-rendered and checksummed
    # every build), while the active-scenario state under the agent-data root
    # is written at run time by `osprey sim apply` on the host and polled here.
    # That second source is rendered from agent_data.base_dir rather than
    # hardcoded, so it follows a project that relocates its agent-data root.
    volumes:
      - ../../data/simulation:/data/simulation:ro
      - {{ osprey_state_mount_source }}:/state/simulation:ro
    networks:
      - osprey-network
    healthcheck:
      # The IOC serves Channel Access on the configured port, not HTTP, so this
      # can't be an HTTP /health probe like the other services. A real `caget`
      # isn't available either: the CA server's base install pulls in
      # epicscorelibs/pvxslibs (C libraries only), not a Python CA *client*,
      # and adding one just for this probe would be exactly the kind of
      # extra-package drift the service's dependency set is meant to avoid.
      # So: a raw TCP
      # connect to the CA port — enough to prove the IOC's listener is up and
      # accepting connections, short of an actual PV read.
      test: ["CMD-SHELL", "python -c \"import socket,sys; s=socket.socket(); s.settimeout(3); r=s.connect_ex(('localhost', {{ (services.virtual_accelerator | default({})).port | default(5064) }})); sys.exit(0 if r == 0 else 1)\""]
      interval: 10s
      timeout: 5s
      retries: 5
      # Grace period before failed probes count — generous because a first-time
      # native-arch image build (source-compiling the native deps) plus boot
      # (PyAT lattice load + CA server startup) takes a few seconds longer
      # than the framework's other native-arch services.
      start_period: 20s

networks:
  osprey-network:
