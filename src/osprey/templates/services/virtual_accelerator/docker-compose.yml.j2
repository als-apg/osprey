{#- This file's RENDER is pinned byte for byte by the suites below. Any
    edit — a reworded comment included — reddens their goldens until they
    are regenerated in the same change. One command per suite that pins
    THIS template:

      PYTHONPATH=src ./.venv/bin/python tests/templates/test_render_defaults_golden.py
      PYTHONPATH=src ./.venv/bin/python tests/templates/test_render_axis_shapes.py
      PYTHONPATH=src ./.venv/bin/python tests/deployment/test_va_compose_instances.py
-#}
{#- The env passthrough axis — the host variables a service's `env:` key
    names — is rendered by the shared macro rather than hand-written per
    template, so every service hands a variable to its container the same
    way. With none declared it emits nothing and this file renders exactly
    as it did before the axis existed. -#}
{%- import "services/_env_axis.j2" as hostenv -%}
{#- The site's build settings — a proxy CA, pip's bypass list, an internal
    package index — are rendered by the shared macro rather than spelled out
    per template, so every image OSPREY builds is handed the same set. -#}
{%- import "services/_site_image_args.j2" as site -%}
{#- The INSTANCE axis. An instance is one soft-IOC container — one simulated
    machine, on its own Channel Access port — and this file renders one per
    instance.

    A project has ONE unless its build profile set
    `virtual_accelerator.live_standin`, in which case the build wrote a second
    `services.live_standin` block beside `services.virtual_accelerator` and
    appended it to `deployed_services`. Instance 1 keeps the historical
    `virtual_accelerator` key so a single-instance deployment renders
    byte-for-byte what it rendered before this axis existed; instance 2 is
    named for what it SERVES — it stands in for the `live` target, so that a
    deployment can rehearse against the live machine's shape without touching
    it — rather than for its index, because every reader of a rendered name (an
    operator at `docker ps`, the host-port preflight, the approval prompt)
    needs to know which machine the container is.

    The membership test is about the STAND-IN alone. Instance 1 is
    unconditional here because this fragment only reaches compose at all when
    the VA is deployed: `find_existing_compose_files` walks `deployed_services`
    and maps each name to its declared `path`'s compose file, so nothing renders
    from this template for a project that deploys no VA. The stand-in is read
    off `deployed_services` rather than off `services` so a block left in
    config.yml but not deployed cannot conjure a second container; that is the
    same membership rule every other service here is gated on. -#}
{%- set instance_keys = ['virtual_accelerator'] -%}
{%- if 'live_standin' in deployed_services %}{% set _ = instance_keys.append('live_standin') %}{% endif -%}
# The virtual-accelerator service owns the PyAT-backed EPICS soft-IOC (see
# src/osprey/services/virtual_accelerator/). Its image is built from the
# Dockerfile beside this file unless services.virtual_accelerator.image names a
# different image, which this file then runs as named with no build.
# OSPREY_VA_IMAGE names one for a single shell (e.g.
# OSPREY_VA_IMAGE=my-registry/osprey-va:dev), and a start that reads it builds
# nothing for this service.
# Use `osprey build --dev` to bake in your local osprey checkout (incl.
# unreleased code) via a wheel; otherwise the image installs osprey from PyPI.
#
# ARCHITECTURE: linux/amd64, and on Apple Silicon that means emulation.
#
# The image is amd64-only by construction — Dockerfile pins
# `FROM --platform=linux/amd64` and hard-fails any other build arch, because
# pcaspy (the Channel Access server behind the serving stack) publishes no
# linux/aarch64 wheel at any interpreter. An arm64 image would build cleanly
# and then have no CA server at all, so the pin is a correctness guard, not a
# packaging shortcut. Read that Dockerfile's header before touching it.
#
# `platform:` below states that out loud rather than leaving it implicit. It
# is what the build already produces; declaring it means compose stops warning
# "the requested image's platform (linux/amd64) does not match the detected
# host platform (linux/arm64/v8)" on every single `osprey up` from an arm64
# machine — a warning that read as a defect when it was in fact the design.
# The cost it names is real and unchanged: on Apple Silicon the virtual
# accelerator runs under QEMU emulation and is correspondingly slower.
#
# OSPREY_VA_PLATFORM overrides it, for the one case the pin would otherwise
# get wrong: a published multi-arch OSPREY_VA_IMAGE that does have a native
# arm64 variant worth resolving to (`OSPREY_VA_PLATFORM=linux/arm64`).
{%- if instance_keys | length > 1 %}
#
# THIS DEPLOYMENT RENDERS TWO INSTANCES. `virtual-accelerator` is the machine
# this project runs against; `live-standin` stands in for the live target, so
# a session can rehearse against that machine's shape without touching it. They
# run one image, built at most once, on distinct Channel Access ports, reading the same
# simulator view and the same active scenarios; each appends its model logs to
# its own directory.
{%- endif %}
{#- The BUILDER instance: the first, in render order, whose own image is the one
    OSPREY builds (unset, or equal to `osprey_images.va`). A null block reads
    as unset, so it keeps its build. None qualifies when every instance names
    another image, and then nothing here builds. -#}
{%- set builder = namespace(key=none) %}
{%- for candidate in instance_keys %}
{%- if builder.key is none and (not services[candidate].image or services[candidate].image == osprey_images.va) %}
{%- set builder.key = candidate %}
{%- endif %}
{%- endfor %}
{%- set builder_key = builder.key %}

services:
{%- for instance_key in instance_keys %}
{#- Everything below addresses the instance through these three names, so its
    spelling is decided once, here, instead of in a dozen interpolations.

    `instance` is the compose-safe form of the service key
    (`virtual-accelerator`, `live-standin`) and names both the compose service
    — which is how in-network consumers reach the IOC over Channel Access — and
    the container.

    `port` is the one name the instances deliberately DISAGREE about. Instance
    1 keeps the defaulting the single-instance template always had — a null or
    portless block still lands on 5064, because `svc.port` on either is
    undefined and the filter answers. (A block missing ENTIRELY has never
    rendered this file, since the image line below needs it too, so the shorter
    spelling gives up no tolerance the longer one had.)

    A LATER instance gets no default, and that is the whole point: 5064 is
    instance 1's port, so defaulting to it would render two containers
    publishing one host port and serving Channel Access on it — a document
    compose accepts, and docker then rejects at run time with a bind error
    naming neither the service nor the key that was missing. `| int` refuses
    at RENDER time instead, because `int()` of an undefined raises rather than
    falling back to its default; a real port passes through unchanged. -#}
{%- set svc = services[instance_key] %}
{%- set instance = instance_key | replace('_', '-') %}
{%- set port = svc.port | default(5064) if loop.first else svc.port | int %}
{#- `pva_port` is the pvAccess server port, the one the model surface is served
    on, and unlike `port` EVERY instance defaults it: it is published on the
    host for instance 1 alone (see `ports:` below), so two instances binding the
    same number, each inside its own container, collide nowhere. A null block
    lands on the default for the reason it does for `port`. The build writes
    `pva_port` onto instance 1's block from the profile's
    `virtual_accelerator.pva_port`, and only when it is set. -#}
{%- set pva_port = svc.pva_port | default(5075) %}
{%- set bind_address = deployment.bind_address | default('127.0.0.1') %}
{#- A blank line BETWEEN instances and none before the first: the rendered
    file is read and diffed by operators, and two hundred-line service
    definitions run together read as one. Nothing is emitted on a
    single-instance render. #}
{%- if not loop.first %}
{% endif %}
  {{ instance }}:
    image: ${OSPREY_VA_IMAGE:-{{ svc.image | default(osprey_images.va) }}}
    platform: ${OSPREY_VA_PLATFORM:-linux/amd64}
{#- ONE instance owns the build, the first whose own image is the one OSPREY
    builds: two services building one tag race each other. An instance naming
    any other image carries no build, so compose pulls and runs it as named
    instead of building this Dockerfile under a name the operator chose for
    something else. Compose builds every buildable service before it creates
    any container, so the other instance's image is on the host by the time it
    is needed. #}
{%- if instance_key == builder_key %}
    build:
      # EVERY relative path here resolves against the pinned compose project
      # directory — the deployment REPO ROOT (`--project-directory <repo>`, see
      # compose_generator.compose_base_cmd) — never this file's own subdir. So
      # render output is addressed under build/, and the repo's own zones by
      # their plain names (data/, .env).
      context: ./build/services/virtual_accelerator
      dockerfile: Dockerfile
      args:
        OSPREY_VERSION: "{{ osprey_version | default('') }}"
        OSPREY_PROJECT_NAME: "{{ osprey_labels.project_name }}"
{{- site.build_args(site_image_build_args | default({})) }}
{% if dev_mode | default(false) %}
        OSPREY_DEV: "1"
{% endif %}
{%- if osprey_pip_pre | default(false) %}
        OSPREY_PIP_PRE: "1"
{%- endif %}
{%- endif %}
{%- if loop.first %}
    # container_name is a HOST-GLOBAL docker identifier: namespace it per-project
    # so two OSPREY projects can deploy the VA on one host without colliding on
    # one name. In-network consumers reach this service by its compose service
    # key `virtual-accelerator` (EPICS_CA_NAME_SERVERS, depends_on) — unchanged
    # here — so unlike postgres this rename needs no network alias.
{%- else %}
    # Same host-global namespacing as instance 1 above, and for the same
    # reason: two OSPREY projects may each run a stand-in on one host. In-network
    # consumers reach this one by its compose service key `{{ instance }}`
    # (EPICS_CA_NAME_SERVERS, depends_on) — the name that says which of the two
    # machines they are addressing.
{%- endif %}
    container_name: {{ osprey_labels.project_name }}-{{ instance }}
    restart: unless-stopped
    ports:
      - "{{ bind_address }}:{{ port }}:{{ port }}/tcp"
{#- INSTANCE 1 ONLY publishes the pvAccess port. The model surface is bound to
    instance 1: whatever a session's control target, its model reads and writes
    address the `virtual_accelerator` instance. A stand-in publish would open a
    host port nothing reads — and, the two instances defaulting to one PVA port,
    publish that host port twice, which docker refuses at run time. -#}
{%- if instance_key == 'virtual_accelerator' %}
      # pvAccess, for the model surface. Clients reach it by name server
      # (EPICS_PVA_NAME_SERVERS=<host>:<port>), which is TCP, so TCP is all
      # that is published: there is no UDP search to answer.
      - "{{ bind_address }}:{{ pva_port }}:{{ pva_port }}/tcp"
{%- endif %}
    environment:
      # EPICS_CA_SERVER_PORT is the standard EPICS server-side CA port
      # override, read directly by the CA library at iocInit — no
      # entrypoint.py change needed to make services.{{ instance_key }}.port
      # actually control what the IOC binds to.
      EPICS_CA_SERVER_PORT: "{{ port }}"
      # EPICS_PVAS_SERVER_PORT is the standard server-side pvAccess port
      # override: the port this IOC's PVA server binds.
      EPICS_PVAS_SERVER_PORT: "{{ pva_port }}"
      # Which instance this IOC serves as; the entrypoint refuses a missing or
      # unknown value and writes this one into its log records and the model
      # RPC's status reply.
      VA_INSTANCE: "{{ instance_key }}"
{#- INSTANCE 1 ONLY carries the write token, for the reason it alone publishes
    the PVA port above: the model surface is instance 1's. A stand-in holding
    the credential would be a second machine able to accept model writes that
    nothing is meant to send it. -#}
{%- if instance_key == 'virtual_accelerator' %}
      # The credential a model write must present. Passthrough from the project
      # .env: compose resolves it, so the secret is never written into this file.
      VA_MODEL_WRITE_TOKEN: "${VA_MODEL_WRITE_TOKEN:-}"
{%- endif %}
      # How often the composite ticks, in seconds: the config key
      # `simulation.tick_s`, rendered here by compose_generator. Not a host
      # passthrough, so the tick is the one the config states.
      VA_POLL_INTERVAL_S: "{{ va_tick_s }}"
      # Where the IOC polls active_scenarios — the second mount below, not the
      # build-owned data dir.
      VA_STATE_DIR: /state/simulation
      TZ: {{ system.timezone }}
{{- hostenv.passthrough(svc) }}
    # Bind-mount sources are relative to the pinned compose project directory —
    # the deployment repo root — so each is spelled from there.
    #
    # The simulator view comes from the OUTPUT zone, `build/data`, and not from
    # a source `data/` tree: `osprey build` writes `simulator/addresses.json`
    # and `simulator/served_models.json` into the render, and the entrypoint
    # reads them under VA_DATA_DIR (default `/data`). Read-only: the IOC never
    # writes the view.
    #
    # The active-scenario state under the agent-data root is written at run
    # time by `osprey sim apply` on the host and polled here, read-only. Its
    # source is rendered from agent_data.base_dir rather than hardcoded, so it
    # follows a project that relocates its agent-data root.
    #
    # The model logs are the one directory the IOC writes: the composite
    # appends `<model>.log` under `/var/simulator`. The host directory is
    # provisioned setgid and group-writable before compose runs, so the agent
    # containers that mount it too can append to the same files.
{#- BOTH instances read the SAME view and the SAME scenario state: a scenario
    applied on the host is meant to be observable on every machine this
    deployment runs. Each writes its logs to its OWN directory, so a reader
    can tell which machine a record came from by where it sits. #}
    volumes:
      - ./build/data:/data:ro
      - {{ osprey_state_mount_source }}:/state/simulation:ro
      - {{ osprey_simulator_log_sources[instance_key] }}:/var/simulator
    networks:
      - osprey-network
    healthcheck:
      # The probe reads the health record the runner rewrites after every
      # publishing pass. It passes while the record is serving or degraded;
      # failed means more than failed_pass_tolerance consecutive passes
      # failed. A missing file or one that is not JSON fails the probe.
      test: ["CMD-SHELL", "python -c \"import json,sys; sys.exit(0 if json.load(open('/run/osprey-va/health.json'))['state'] in ('serving','degraded') else 1)\""]
      interval: 10s
      timeout: 5s
      retries: 5
      # Grace period before failed probes count — generous because a first-time
      # native-arch image build (source-compiling the native deps) plus boot
      # (PyAT lattice load + CA server startup) takes a few seconds longer
      # than the framework's other native-arch services.
      start_period: 20s
{%- endfor %}

networks:
  osprey-network:
