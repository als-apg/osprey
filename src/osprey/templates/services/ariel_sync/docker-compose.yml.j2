{#- Both shared axes — this service's network membership with the file-level
    `networks:` stanza that matches it, and the host variables its `env:` key
    names — are rendered by the shared macros rather than spelled out here, so
    every service template states the same topology the same way. -#}
{%- import "services/_network_axis.j2" as net -%}
{%- import "services/_env_axis.j2" as hostenv -%}
# The ariel-sync service keeps this deployment's ARIEL logbook mirror FRESH.
# It runs `osprey ariel sync --watch`: a startup sync (schema migration,
# incremental ingest, enhance cleanup) and then the ingestion loop, polling the
# facility logbook at `ariel.ingestion.poll_interval_seconds` and writing what
# it finds into the deployment's own ARIEL store.
#
# A DAEMON, not a one-shot, and that is the whole point of the service. A
# container that syncs once and exits leaves the mirror frozen at the last
# `osprey up`, so the panel goes stale between deploys while every health row
# still reads green. Hence `restart: unless-stopped` below — the mirror is
# meant to be moving whenever the deployment is up.
#
# THE RESTART POLICY OUTLIVES THE DAEMON'S OWN FAILURE CAP, deliberately, and
# an operator needs to know it. The ingestion loop backs off between failures
# and gives up after a run of consecutive ones, exiting non-zero; this policy
# then restarts the container and the whole sequence begins again. So "gave up"
# is never a durable state, and `docker ps` goes on reading `running` while the
# mirror advances by nothing. The two signals that tell the difference are the
# container's RESTART COUNT and the `ariel_last_ingestion` health row, which
# reads the store's newest ingestion row rather than the container's.
#
# It runs the PROJECT image (<project>:local) that `osprey up` builds from the
# project root — the same image the web terminals and the dispatch workers run,
# so the whole slice shares one image and one failure domain. It overrides only
# `command:`. OSPREY_WORKER_IMAGE overrides with a prebuilt/published image.
#
# There is deliberately NO `build:` block: the project image is built once by
# `osprey up` (deployment/container_lifecycle.py) before `docker compose up`
# runs, and a second `build:` for the same tag would race the sole builder.
{#- This service's own config block, resolved once. It may be absent entirely
    (a deploy that selects the service without authoring a block for it), so
    every read goes through the `default({}, true)` spelling rather than a bare
    attribute lookup, which would raise on the missing parent. #}
{%- set svc = services.ariel_sync | default({}, true) %}
{#- The network axis, read here as well as by the macros: the store's address
    below is a LITERAL, and which literal is right depends on which namespace
    this container ends up in. #}
{%- set on_host = (svc.network | default('bridge', true)) == 'host' %}
{#- Whether THIS deployment runs the ARIEL store. Read twice below — startup
    ordering and the store address — so the co-deployed and external cases
    cannot drift apart in this file. #}
{%- set postgres_deployed = 'postgresql' in (deployed_services | default([])) %}

services:
  ariel-sync:
    image: ${OSPREY_WORKER_IMAGE:-{{ svc.image | default(osprey_images.worker) }}}
    # container_name is a HOST-GLOBAL docker identifier: namespace it per-project
    # so two OSPREY projects can deploy a mirror on one host without colliding on
    # one name. Nothing reaches this service in-network (it only makes outbound
    # calls, to the logbook and to the store), so the rename needs no alias.
    container_name: {{ osprey_labels.project_name }}-ariel-sync
    # `--watch` is what makes this a mirror rather than a snapshot: the initial
    # sync runs first (so an empty store is filled and an external store is
    # migrated), then the process stays in the ingestion loop.
    command: ["osprey", "ariel", "sync", "--watch"]
    labels:
      osprey.project.name: "{{ osprey_labels.project_name }}"
      com.osprey.repo-id: "{{ osprey_labels.repo_id }}"
      osprey.project.root: "{{ osprey_labels.project_root }}"
      # Content fingerprint of the rendered config this deploy built
      # (runtime_helper's as_built_config_digest, carried in by
      # OSPREY_CONFIG_DIGEST). Compose recreates a container when the compose
      # DOCUMENT changes, and it never diffs a running container against the
      # files that container reads its settings from — so without this label an
      # `osprey set` that moves the poll interval would leave this daemon
      # running on the settings it parsed at startup, indefinitely. Empty when
      # the invocation did not set the variable (a hand-run `docker compose up`).
      osprey.config.digest: "${OSPREY_CONFIG_DIGEST:-}"
      # The same recreate trigger for the other file this container reads its
      # settings from: the env chain (runtime_helper's env_chain_digest, carried
      # in by OSPREY_ENV_DIGEST). Rotating the store password or a proxy
      # variable in the chain is a document change with this label and an
      # invisible one without it.
      osprey.env.digest: "${OSPREY_ENV_DIGEST:-}"
    restart: unless-stopped
    # No `ports:` and no `healthcheck:` — deliberately, and for the same reason
    # the archiver recorder has neither. This service opens no listening socket:
    # it dials the logbook and the store and is dialled by nothing, so it has
    # nothing to publish and nothing an HTTP or TCP probe could ask. Its
    # liveness question ("is the mirror still moving?") is answered where it
    # belongs, by the `ariel_last_ingestion` health probe reading the store's
    # newest ingestion row — a container that is up but no longer ingesting is
    # exactly the failure a container-level probe would report as healthy.
{%- if postgres_deployed %}

    # Only when the ARIEL store is co-deployed: the startup sync connects
    # immediately, and against a booting Postgres that is a failed migration
    # rather than a wait. Health-gated rather than start-gated because
    # "container started" is not "answering queries", and on a fresh volume
    # postgres's initdb makes that window seconds long. Guarded because a
    # `depends_on` naming a service the deployment does not run errors compose
    # outright — the same gate the archiver recorder applies to its IOC.
    depends_on:
      postgresql:
        condition: service_healthy
{%- endif %}
{%- if osprey_env_chain | default([]) %}

    # The deployment's env is a CHAIN of files at the repo root, listed here in
    # ASCENDING precedence — committed defaults (.env.shared) first, the local
    # secret file (.env) last — because compose lets a later entry win on any
    # key an earlier one also sets. That is the same order the invocation's own
    # `--env-file` flags carry, so what interpolates into this document and what
    # lands in the container agree.
    #
    # `env_file:` is read by the compose CLI on the HOST (as the file's owner),
    # so it works even though the repo's .env is deliberately 0600 and this
    # container runs as the unprivileged `osprey` user. The store password, the
    # provider key the enhance step calls with, and any site proxy variables all
    # arrive this way.
    #
    # Only files that EXIST at render time are listed: an entry naming a missing
    # path errors `compose up` outright. Every path is relative to the pinned
    # compose project directory, which is the deployment REPO ROOT.
    env_file:
{%- for env_chain_file in osprey_env_chain %}
      - {{ env_chain_file }}
{%- endfor %}
{%- endif %}

    environment:
      # The sync reads the `ariel:` block — source URL, credentials, poll
      # interval, enhancement modules — through the global config loader. CWD is
      # the image WORKDIR, not the project dir, so without CONFIG_FILE every
      # lookup falls back to a path that holds no project config. It points at
      # the STAGED config.yml bind-mounted below (the deploy-time config), not
      # the copy baked into the image.
      #
      # Under the project directory, in build/ — the same four-zone shape the
      # repo has, because this container runs the PROJECT image and anything it
      # renders against a project root expects that layout (the dispatch worker
      # carries the same note).
      CONFIG_FILE: /app/{{ osprey_labels.project_name }}/build/config.yml
      OSPREY_PROJECT_DIR: /app/{{ osprey_labels.project_name }}
      TZ: {{ system.timezone }}
{%- if postgres_deployed %}
{#- Address of the ARIEL store, by the same convention as the dispatch worker's
    OSPREY_ARCHIVER_MONGODB_HOST/PORT: whichever address is right from where
    this container actually runs. The `ariel.database` block in config.yml is
    written for the HOST side (`localhost` and the published `port_host`), which
    from inside a bridge-networked container names its own loopback.

    Gated on `deployed_services` membership, and for a sharper reason than
    symmetry: these two are a LITERAL address, not a fallback. `ariel-postgres`
    is a name that resolves only on a network where THIS deployment runs the
    store, so it is set only in that case — the one case where this file knows
    the store's address better than the config does.

    Inert under an authored `ariel.database.uri` either way: resolve_ariel_dsn
    applies these two in its DERIVED rung only, so an explicit URI (or the
    legacy alias) is returned verbatim and is never redirected here.

    Which is also what a deployment running this service against an EXTERNAL
    store has to rely on: that store must be NAMED, by `ariel.database.uri`
    (or the legacy alias), because it is the authored URI — not this file — that
    is correct from anywhere. Nothing enforces the pairing. Deploy this service
    with no co-deployed `postgresql` and no authored URI and resolve_ariel_dsn
    falls to its derived rung, whose default host is `localhost`: this
    container's own loopback on the bridge, where no store listens. The build
    advisory does not cover that shape either — it asks whether a remote
    logbook has an ingester, not whether an ingester has a store — so the
    failure surfaces at the first sync as a refused connection. #}
{%- if on_host %}
      # On the host namespace this container's loopback IS the host's, so the
      # store is reached where it PUBLISHES. `port_host` is spelled with the
      # same defaulting chain every other reader of this store uses: a config
      # that names the block but omits the key falls back to the layout value
      # for the deployment's own `deployment.port_base`, and `default({}, true)`
      # rescues an absent block, which a bare `| default(...)` on the attribute
      # could not.
      ARIEL_DATABASE_HOST: localhost
      ARIEL_DATABASE_PORT: "{{ (services.postgresql | default({}, true)).port_host | default(osprey_ports.postgres, true) }}"
{%- else %}
      # `ariel-postgres` is the store's network alias, pinned in the postgresql
      # template precisely so this name survives the per-project
      # container_name; 5432 is its CONTAINER port, never the host publish.
      ARIEL_DATABASE_HOST: ariel-postgres
      ARIEL_DATABASE_PORT: "5432"
{%- endif %}
{%- endif %}
{%- if osprey_ariel_mirror_source %}
      # The mirror mount's target, named to the image entrypoint: its root phase
      # is to join the group of each directory the render names here before
      # dropping privileges, and `group_add:` alone does not survive `gosu`. The
      # value is the CONTAINER path, never the host one — the entrypoint stats
      # the directory it can actually see. Gated on the same injected source as
      # the mount itself.
      OSPREY_ARIEL_MIRROR_DIR: {{ osprey_container_ariel_mirror_dir }}
{%- endif %}
{{- hostenv.passthrough(svc) }}
    # Bind-mount sources are relative to the pinned compose project directory,
    # which is the deployment REPO ROOT — hence the build/services/ prefix on
    # the render output below.
    volumes:
      # The staged runtime config overlays the config.yml baked into the image,
      # so the sync runs on the deploy-time settings rather than the image's
      # build-time snapshot.
      - ./build/services/ariel_sync/config.yml:/app/{{ osprey_labels.project_name }}/build/config.yml:ro
{%- if osprey_ariel_mirror_source %}
      # THE DEPLOYMENT'S ARIEL MIRROR, at the path this container's own exporter
      # writes. The `qmd_export` enhancement module runs inside THIS container —
      # an entry enhanced by the daemon is mirrored by the daemon's own process
      # — and it resolves `mirror_path` against the project root, which in here
      # is the container project dir. Without this bind the mirror it writes is
      # a directory in the container's writable layer: the qmd sidecar, which
      # indexes the HOST's mirror, never sees those entries, and the next
      # recreate discards them.
      #
      # ONE directory for every writer — the web terminals bind the same source,
      # so the sidecar's corpus is the union of everything any process enhanced.
      # Read-write, like the terminals' bind and unlike the sidecar's `:ro` one.
      #
      # Both halves are gated on the injected SOURCE rather than defaulted,
      # because the injector answers "no export writes a mirror" with None: a
      # `| default('')` here would render a mount with an empty host half, which
      # the render accepts and `compose up` rejects.
      - {{ osprey_ariel_mirror_source }}:{{ osprey_container_ariel_mirror_dir }}
{%- endif %}
{{- net.network(svc) }}
{{ net.network_declaration(svc) }}
