{#- The network axis — this service's network membership, its published ports
    and the file-level stanza that matches them — is rendered by the shared
    macro rather than spelled out here, so every service template states the
    same topology the same way instead of drifting into a set of
    near-identical dialects. With no `network:` declared the macros emit
    exactly the blocks this file carried before, byte for byte. -#}
{%- import "services/_network_axis.j2" as net -%}
{#- The one thing the macros cannot render for this service: the address the
    MCP server itself binds. Read once here so the mode is spelled the same
    way the macros spell it (unset means `bridge`), rather than repeated as a
    conditional beside the env var. -#}
{%- set on_host_network = (services.event_dispatcher.network | default('bridge', true)) == 'host' -%}
# The event-dispatcher runs a locally-built image (see ./Dockerfile).
# `osprey up` builds it on first run; subsequent runs reuse the local
# tag, which is project-prefixed ({{ osprey_labels.project_name }}-dispatch:local)
# so two OSPREY projects on one host never race to tag one shared image.
# To use a prebuilt/published image instead, set OSPREY_DISPATCH_IMAGE
# (e.g. OSPREY_DISPATCH_IMAGE=my-registry/osprey-dispatch:dev).
# Use `osprey build --dev` to bake in your local osprey checkout (incl.
# unreleased code) via a wheel; otherwise the image installs osprey from PyPI.

services:
  event-dispatcher:
    image: ${OSPREY_DISPATCH_IMAGE:-{{ services.event_dispatcher.image | default(osprey_images.dispatch) }}}
    build:
      # EVERY relative path in this file — build contexts and bind-mount sources
      # alike — resolves against the pinned compose project directory, which is
      # the deployment REPO ROOT (`--project-directory <repo>`, see
      # compose_generator.compose_base_cmd), never this file's own subdir. So
      # render output is addressed under build/, and the repo's own zones by
      # their plain names (data/, .env). Same convention in the volumes below.
      context: ./build/services/event_dispatcher
      dockerfile: Dockerfile
      args:
        OSPREY_VERSION: "{{ osprey_version | default('') }}"
        OSPREY_PROJECT_NAME: "{{ osprey_labels.project_name }}"
{% if dev_mode | default(false) %}
        OSPREY_DEV: "1"
{% endif %}
    # container_name is a HOST-GLOBAL docker identifier: namespace it per-project
    # so two OSPREY projects can deploy the dispatcher on one host without
    # colliding on one name. In-network consumers reach this service by its
    # compose service key `event-dispatcher` (the worker's depends_on) —
    # unchanged here — so this rename needs no network alias.
    container_name: {{ osprey_labels.project_name }}-event-dispatcher
    command: ["python", "-m", "osprey.dispatch"]
    labels:
      osprey.project.name: "{{ osprey_labels.project_name }}"
      com.osprey.repo-id: "{{ osprey_labels.repo_id }}"
      osprey.project.root: "{{ osprey_labels.project_root }}"
      # Content fingerprint of the rendered config this deploy built
      # (runtime_helper's as_built_config_digest, carried in by
      # OSPREY_CONFIG_DIGEST). The same recreate trigger as the env digest, for
      # the other file a container reads its settings from: this service mounts
      # the rendered config.yml, so `osprey set` changes a file the compose
      # document never mentions and compose would leave the container running on
      # the settings it parsed at startup. Empty when the invocation did not set
      # the variable (a hand-run `docker compose up`).
      osprey.config.digest: "${OSPREY_CONFIG_DIGEST:-}"
{#- Fingerprint of the env chain (`.env.shared` then `.env`) this deploy read,
    interpolated at compose time from the variable `runtime_env` injects. The
    container runtime does not diff a running container's environment against
    the env files it was built from, so without a label that moves with the
    chain's contents an edit to `.env` would leave the old values running. An
    empty value — no chain at all, or a caller that skipped the injection — is
    a valid label rather than an error. #}
      osprey.env.digest: "${OSPREY_ENV_DIGEST:-}"
    restart: unless-stopped
{#- Published ports, suppressed under `host`: the service then binds the host's
    own namespace directly and there is no port map left to publish. -#}
{{- net.ports(services.event_dispatcher, entries=[
      (deployment.bind_address | default('127.0.0.1'))
      ~ ':' ~ (services.event_dispatcher.port | default(8020))
      ~ ':' ~ (services.event_dispatcher.port | default(8020))
    ]) }}
    environment:
      # FastMCP reads transport/host/port from FASTMCP_* (env prefix "FASTMCP_").
      # `python -m osprey.dispatch` -> run_mcp_server -> server.run() honors these;
      # plain MCP_* vars are NOT read by the dispatcher entrypoint.
      FASTMCP_TRANSPORT: http
{#- On the compose network the server binds every interface: the only addresses
    that reach it are that network's own, and the published port is what decides
    host reachability. On the HOST network there is no such envelope — every
    interface means every interface the machine has — so the default narrows to
    loopback, and reaching the dispatcher from another machine becomes a
    deliberate `bind:` on the service's config block (which the deploy's
    exposure reconciliation then reads as exposed). #}
      FASTMCP_HOST: {{ services.event_dispatcher.bind | default('127.0.0.1' if on_host_network else '0.0.0.0', true) }}
      FASTMCP_PORT: "{{ services.event_dispatcher.port | default(8020) }}"
      # No :-default — an unset token must stay EMPTY so the server fails closed
      # (HTTP 503) rather than booting with a guessable secret. `osprey up`
      # auto-generates strong random tokens into the project .env when unset.
      EVENT_DISPATCHER_TOKEN: ${EVENT_DISPATCHER_TOKEN}
      DISPATCH_WORKER_TOKEN: ${DISPATCH_WORKER_TOKEN}
      TRIGGERS_YML: /app/triggers.yml
      OSPREY_FACILITY_NAME: "{{ services.event_dispatcher.facility_name | default('') }}"
      PV_STRIP_PREFIX: "{{ services.event_dispatcher.pv_strip_prefix | default('') }}"
{#- Deployment is decided by the top-level `deployed_services` list, NOT by the
    presence of a `services.openobserve` block: a store can be fully configured
    yet left out of the deploy, and gating on the config block alone would link
    to a container that was never started. Testing membership also sidesteps the
    empty-mapping trap — `services.openobserve` is falsy when the block exists
    but sets no keys, which would wrongly read as "not deployed".

    `claude_code is defined` must come FIRST in its chain: this environment raises
    on attribute access against an undefined name, so testing `claude_code.telemetry`
    on a config that omits the whole `claude_code:` block would fail the render
    rather than fall through to the off state. #}
{% if 'openobserve' in (deployed_services | default([])) and claude_code is defined and claude_code.telemetry is defined and claude_code.telemetry and claude_code.telemetry.enabled %}
      # Browser-reachable base URL of the telemetry store, so the dashboard can
      # link a run to its own OTEL records. Deliberately localhost-and-host-port,
      # NOT the `openobserve` compose DNS name the containers talk to: the value
      # is rendered into a link the OPERATOR's browser follows, and the browser
      # is outside the compose network. This mirrors how the store's UI is
      # reached today (the service binds to localhost by design).
      #
      # Emitted only when the store is deployed AND agent telemetry is on —
      # either being off leaves the var unset, which the dashboard reads as
      # "hide the link" rather than offering one that resolves to nothing.
      # Render-time gate: toggling telemetry in config.yml afterwards needs a
      # redeploy to take effect here, same as every other value in this block.
      OSPREY_TELEMETRY_URL: "http://localhost:{{ services.openobserve.port | default(5080) }}"
{% endif %}
      TZ: {{ system.timezone }}
    # Bind-mount sources are relative to the compose *project directory*
    # (build/services/), which is the first -f file's location — not this
    # service's subdir — so they must be prefixed with event_dispatcher/.
    volumes:
      - ./build/services/event_dispatcher/triggers.yml:/app/triggers.yml:ro
      - ./build/services/event_dispatcher/config.yml:/app/config.yml:ro
{{- net.network(services.event_dispatcher) }}
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:{{ services.event_dispatcher.port | default(8020) }}/health').status==200 else 1)\""]
      interval: 10s
      timeout: 5s
      retries: 5
      # Grace period before failed probes count — the first run also provisions
      # Claude artifacts and injects provider env, which takes a few seconds.
      start_period: 30s
{# A deliberate blank line precedes the file-level stanza, so this one call
   carries no left-trim marker (`{{-` would eat the blank line along with the
   newline it is meant to keep): the literal above ends its own line, the macro
   supplies the separating newline, and under `host` — where nothing is
   declared — the file simply ends after the healthcheck. -#}
{{ net.network_declaration(services.event_dispatcher) }}
