{#- This file's RENDER is pinned byte for byte by the suites below. Any
    edit — a reworded comment included — reddens their goldens until they
    are regenerated in the same change. One command per suite that pins
    THIS template:

      PYTHONPATH=src ./.venv/bin/python tests/templates/test_render_defaults_golden.py
-#}
{%- import "services/_env_axis.j2" as hostenv -%}
# agent-record: the one writer of this deployment's agent record. It ingests
# what every source appends to the spool, tails the Claude Code transcripts of
# every terminal and dispatch worker, and answers the record's read API. The
# host build's transcripts, which Claude Code writes for the host account
# alone, reach it through the spool: the host session forwards them. Every
# deployment runs it; it is never a `deployed_services` entry.
#
# It runs the PROJECT image (<project>:local) that `osprey up` builds from the
# project root, with the image's own entrypoint, which drops privileges before
# it runs the command. OSPREY_WORKER_IMAGE overrides with a prebuilt/published
# image. There is deliberately NO `build:` block: the project image is built
# once by `osprey up`, and a second `build:` for the same tag would race it.
{%- set svc = (services | default({}, true)).agent_record | default({}, true) %}
{%- set rec = osprey_agent_record %}

services:
  agent-record:
    image: ${OSPREY_WORKER_IMAGE:-{{ svc.image | default(osprey_images.worker) }}}
    # container_name is a HOST-GLOBAL docker identifier: namespace it
    # per-project so two OSPREY projects can run an agent record on one host.
    container_name: {{ osprey_labels.project_name }}-agent-record
    command: ["osprey", "agent-record", "serve", "--host", "0.0.0.0", "--port", "{{ rec.container_port }}"]
    security_opt: ["no-new-privileges:true"]
    labels:
      # Recreates the container when one of its credential files changes:
      # each is read once, at start.
      osprey.agent-record.cred.digest: "${OSPREY_AGENT_RECORD_DIGEST_AGENT_RECORD:-}"
    restart: unless-stopped
    # Its own credential files at the repo root and nothing else: the verifier
    # of every login and the set of secrets ingest scrubs, plus its store
    # account when the record lives in ClickHouse. `osprey build` and
    # `osprey up` write them before compose reads them. No credential file is
    # mounted.
    env_file:
{%- for env_file in rec.env_files %}
      - {{ env_file }}
{%- endfor %}
    environment:
      # The spool every source appends to, the embedded store's directory and
      # the archive the record exports its closed days into. The image's
      # entrypoint joins each directory's group and leaves its ownership alone.
      OSPREY_AGENT_RECORD_SPOOL_ROOT: {{ rec.spool_dir }}
      OSPREY_AGENT_RECORD_DIR: {{ rec.record_dir }}
      OSPREY_AGENT_RECORD_ARCHIVE_DIR: {{ rec.archive_dir }}
      # One transcript root per source below this directory, each named as
      # the record names it.
      OSPREY_AGENT_RECORD_TRANSCRIPTS_DIR: {{ rec.transcripts_dir }}
{%- if rec.clickhouse %}
      # The record's ClickHouse store, dialled over the bridge network: the
      # store publishes no host port.
      OSPREY_AGENT_RECORD_CLICKHOUSE_URL: {{ rec.clickhouse.url }}
{%- endif %}
      TZ: {{ (system | default({}, true)).timezone | default("UTC", true) }}
{{- hostenv.passthrough(svc) }}
    # Published on loopback only: readers on this host and the web tier reach
    # the read API there; nothing else may.
    ports:
      - "127.0.0.1:{{ rec.port }}:{{ rec.container_port }}"
    # The spool, the record directory and the archive are the three writable
    # mounts; the archive service is the only other container that mounts the
    # archive. Every transcripts volume is mounted whole and read-only; no
    # claude-config volume and no workspace is.
    volumes:
      - {{ rec.spool_source }}:{{ rec.spool_dir }}
      - {{ rec.record_source }}:{{ rec.record_dir }}
      - {{ rec.archive_source }}:{{ rec.archive_dir }}
{%- for root in rec.volume_roots %}
      - {{ root.volume }}:{{ rec.transcripts_dir }}/{{ root.root }}:ro
{%- endfor %}
    networks:
      - osprey-network
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:{{ rec.container_port }}/health').status==200 else 1)\""]
      interval: 10s
      timeout: 5s
      retries: 5
{%- if rec.clickhouse %}
{%- set store = rec.clickhouse %}

  # The record's ClickHouse store. `osprey up` starts it alone and applies the
  # schema and agent-record's account through `compose exec`, then starts
  # agent-record, which is the one service that dials it. It publishes no host
  # port, so agent-record's read API is the record's only read path.
  {{ store.service }}:
    image: {{ store.image }}
    # container_name is a HOST-GLOBAL docker identifier: namespace it
    # per-project so two OSPREY projects can run a record store on one host.
    container_name: {{ osprey_labels.project_name }}-agent-record-clickhouse
    labels:
      # Recreates the store when its admin credential file changes.
      osprey.agent-record.cred.digest: "${OSPREY_AGENT_RECORD_DIGEST_AGENT_RECORD_CLICKHOUSE:-}"
    restart: unless-stopped
    # The admin account, created by the image from this file and confined to
    # loopback inside the container by users.d/zz-osprey-admin.xml. It is the
    # store's only env_file, and no other container is handed it.
    env_file:
{%- for env_file in store.env_files %}
      - {{ env_file }}
{%- endfor %}
    mem_limit: {{ store.mem_limit }}
    volumes:
      - {{ store.volume }}:/var/lib/clickhouse
      - ./build/services/agent_record/osprey.xml:/etc/clickhouse-server/config.d/osprey.xml:ro
      - ./build/services/agent_record/osprey-defaults.xml:/etc/clickhouse-server/users.d/osprey-defaults.xml:ro
      - ./build/services/agent_record/zz-osprey-admin.xml:/etc/clickhouse-server/users.d/zz-osprey-admin.xml:ro
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:{{ store.container_port }}/ping | grep -q Ok"]
      interval: 5s
      timeout: 3s
      retries: 30
    networks:
      - osprey-network
{%- endif %}
{%- if rec.terminal_volumes %}

# The web terminals' transcripts volumes, declared under the same bare keys and
# with the same labels the web-terminal template declares. That template is
# rendered into the other slice of this compose project, so whichever slice
# creates a volume first creates the same one. A dispatch transcripts volume is
# declared once, by the dispatch worker, in this slice; it is only referenced
# here.
volumes:
{%- for volume in rec.terminal_volumes %}
  {{ volume }}:
{%- endfor %}
{%- elif rec.clickhouse %}

volumes:
{%- endif %}
{%- if rec.clickhouse %}
  # The record store's data. A plain `osprey reset` keeps it;
  # `osprey reset --purge-audit` removes it.
  {{ rec.clickhouse.volume }}:
{%- endif %}

networks:
  osprey-network:
