+/**
+ * Build an FTS5 query for a plain natural-language question, or return null
+ * when the query is not one.
+ *
+ * A question such as "how is the storage ring RF frequency tuned" read as
+ * keywords asks for every word, each as a prefix: no document holds them all,
+ * and the prefixes of short function words ("a"*, "the"*) match nearly every
+ * row, which makes the query both slow and empty. Read as a question, its
+ * content words are ORed without prefix expansion and bm25 ranks the
+ * documents by how many of them, and how rare, they hold.
+ *
+ * A query counts as a question when it contains a stopword or ends with "?",
+ * uses none of the explicit syntax (quoted phrases, -negation), and has at
+ * least one content word. Keyword queries ("rf feedback", "multi-agent
+ * memory") keep the AND-of-prefixes reading.
+ */
+function buildNaturalLanguageFTS5Query(query) {
+    const s = query.trim();
+    if (s.includes('"') || /(^|\s)-\S/.test(s))
+        return null;
+    const words = s.split(/\s+/)
+        .map(w => w.replace(/^[^\p{L}\p{N}]+|[^\p{L}\p{N}]+$/gu, ''))
+        .filter(w => w.length > 0);
+    const isQuestion = s.endsWith('?') || words.some(w => LEX_STOPWORDS.has(w.toLowerCase()));
+    if (!isQuestion)
+        return null;
+    const terms = [];
+    for (const word of words) {
+        if (LEX_STOPWORDS.has(word.toLowerCase()))
+            continue;
+        const sanitized = isHyphenatedToken(word)
+            ? sanitizeHyphenatedTerm(word)
+            : containsCjk(word) ? sanitizeFTS5Phrase(word) : sanitizeFTS5Term(word);
+        if (sanitized && !terms.includes(`"${sanitized}"`))
+            terms.push(`"${sanitized}"`);
+    }
+    return terms.length > 0 ? terms.join(' OR ') : null;
