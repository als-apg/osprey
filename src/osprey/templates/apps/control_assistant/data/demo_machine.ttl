    narad_p:facility "demo" ;
    narad_p:familyDescription "Vertical Corrector Magnets (VCM): Small dipole steering magnets for fine vertical (Y) beam position adjustments. Work with BPMs in feedback loops to maintain desired orbit. Bipolar power supplies allow positive and negative deflection." ;
    narad_p:hasBinding <https://narad.example.org/binding/narad_endpoint_demo_SR_VCM16_CURRENT_GOLDEN>,
        <https://narad.example.org/binding/narad_endpoint_demo_SR_VCM16_CURRENT_RB>,
        <https://narad.example.org/binding/narad_endpoint_demo_SR_VCM16_CURRENT_SP>,
        <https://narad.example.org/binding/narad_endpoint_demo_SR_VCM16_STATUS_ON>,
        <https://narad.example.org/binding/narad_endpoint_demo_SR_VCM16_STATUS_READY> ;
    narad_p:ordinalInFacility 373 ;
    narad_p:ordinalInSection 373 ;
    narad_p:rawType "VCM" ;
    narad_p:ringDescription "Storage Ring (SR): Main synchrotron light source. 12-sector electron storage ring operating at 2.0 GeV. Contains magnets, diagnostics, vacuum, and RF systems for stable beam circulation and photon production." ;
    narad_p:sPositionM 373.0 ;
    narad_p:sectionCode "SR" ;
    narad_p:sourceName "VCM16" ;
    narad_p:sourceSectionId "narad:section:demo:sr" ;
    narad_p:system "MAG" ;
    narad_p:systemDescription "Magnet System (MAG): Controls beam trajectory and focusing in the storage ring. Includes dipole bending magnets, quadrupole focusing magnets, sextupole magnets for chromaticity correction, and corrector magnets for precise beam steering. All magnets are powered by regulated power supplies and are critical for maintaining stable beam orbit and beam quality." .

