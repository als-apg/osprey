<https://narad.example.org/device/demo_SR_DIPOLE01> a narad_sem:Dipole ;
    narad_p:deviceId "narad:device:demo:SR:DIPOLE01" ;
    narad_p:facility "demo" ;
    narad_p:familyDescription "Dipole Bending Magnets: Main bending magnets that deflect the beam in a circular path to form the storage ring. Create uniform magnetic field perpendicular to beam. Numbered sequentially around the ring (e.g., B01, B02, ...). Critical for maintaining correct beam trajectory and energy." ;
    narad_p:hasBinding <https://narad.example.org/binding/narad_endpoint_demo_SR_DIPOLE01_CURRENT_GOLDEN>,
