    narad_p:ordinalInFacility 82 ;
    narad_p:ordinalInSection 82 ;
    narad_p:rawType "DIPOLE" ;
    narad_p:ringDescription "Storage Ring (SR): Main synchrotron light source. 12-sector electron storage ring operating at 2.0 GeV. Contains magnets, diagnostics, vacuum, and RF systems for stable beam circulation and photon production." ;
