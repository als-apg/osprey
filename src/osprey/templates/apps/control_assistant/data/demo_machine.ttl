<https://narad.example.org/binding/narad_endpoint_demo_SR_DIPOLE01_CURRENT_GOLDEN> a narad_sem:ChannelBinding ;
    narad_p:bindingId "narad:binding:narad:endpoint:demo:SR:DIPOLE01:CURRENT_GOLDEN" ;
    narad_p:confidence "high" ;
    narad_p:description "Storage ring dipole bending magnet 01 current golden setpoint" ;
    narad_p:fieldDescription "Magnet Excitation Current (Amperes): Current through dipole coil windings. Directly proportional to magnetic bending field via Ampere's law (B ∝ I). Typically 50-500A depending on ring energy. Tightly regulated by precision power supplies to maintain stable beam energy and trajectory." ;
    narad_p:fullPv "SR:MAG:DIPOLE:01:CURRENT:GOLDEN" ;
    narad_p:protocol "ca" ;
    narad_p:readsSignal narad_sem:dipole_current_golden ;
    narad_p:subfieldDescription "Golden Setpoint (read-only): Reference setpoint for optimal beam operation. Stored golden values represent known good operating conditions. Read-only - used for comparison and restore operations." .

<https://narad.example.org/binding/narad_endpoint_demo_SR_DIPOLE01_CURRENT_RB> a narad_sem:ChannelBinding ;
    narad_p:bindingId "narad:binding:narad:endpoint:demo:SR:DIPOLE01:CURRENT_RB" ;
    narad_p:confidence "high" ;
    narad_p:description "Storage ring dipole bending magnet 01 current readback" ;
    narad_p:fieldDescription "Magnet Excitation Current (Amperes): Current through dipole coil windings. Directly proportional to magnetic bending field via Ampere's law (B ∝ I). Typically 50-500A depending on ring energy. Tightly regulated by precision power supplies to maintain stable beam energy and trajectory." ;
    narad_p:fullPv "SR:MAG:DIPOLE:01:CURRENT:RB" ;
    narad_p:protocol "ca" ;
    narad_p:readsSignal narad_sem:dipole_current_rb ;
    narad_p:subfieldDescription "Current Readback (read-only): Actual measured dipole current from DCCT. High-accuracy measurement (±0.01%) essential for field reproducibility. Used in power supply feedback loop and archived for orbit analysis." .

