<https://narad.example.org/device/demo_SR_BPM01> a narad_sem:BeamPositionMonitor ;
    narad_p:deviceId "narad:device:demo:SR:BPM01" ;
    narad_p:facility "demo" ;
    narad_p:familyDescription "Beam Position Monitors: Measure transverse (X, Y) beam position at many locations around the ring. Typical resolution: 1-10 microns. Essential for orbit correction and feedback." ;
    narad_p:hasBinding <https://narad.example.org/binding/narad_endpoint_demo_SR_BPM01_GOLDEN_X>,
        <https://narad.example.org/binding/narad_endpoint_demo_SR_BPM01_GOLDEN_Y>,
        <https://narad.example.org/binding/narad_endpoint_demo_SR_BPM01_OFFSET_X>,
        <https://narad.example.org/binding/narad_endpoint_demo_SR_BPM01_OFFSET_Y>,
        <https://narad.example.org/binding/narad_endpoint_demo_SR_BPM01_POSITION_X>,
        <https://narad.example.org/binding/narad_endpoint_demo_SR_BPM01_POSITION_Y>,
        <https://narad.example.org/binding/narad_endpoint_demo_SR_BPM01_STATUS_CONNECTED>,
        <https://narad.example.org/binding/narad_endpoint_demo_SR_BPM01_STATUS_VALID> ;
    narad_p:ordinalInFacility 1 ;
    narad_p:ordinalInSection 1 ;
    narad_p:rawType "BPM" ;
    narad_p:ringDescription "Storage Ring (SR): Main synchrotron light source. 12-sector electron storage ring operating at 2.0 GeV. Contains magnets, diagnostics, vacuum, and RF systems for stable beam circulation and photon production." ;
    narad_p:sPositionM 1.0 ;
    narad_p:sectionCode "SR" ;
    narad_p:sourceName "BPM01" ;
    narad_p:sourceSectionId "narad:section:demo:sr" ;
    narad_p:system "DIAG" ;
    narad_p:systemDescription "Diagnostic System (DIAG): Beam measurement and monitoring instrumentation. Includes beam position monitors (BPMs) for orbit measurement, beam current monitors (DCCT), and radiation safety monitors." .

