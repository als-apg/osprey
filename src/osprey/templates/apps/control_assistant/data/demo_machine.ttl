    narad_p:confidence "high" ;
    narad_p:description "Storage ring beam position monitor 01 golden orbit horizontal" ;
    narad_p:fieldDescription "Golden Orbit Reference (meters): Stored reference orbit positions." ;
    narad_p:fullPv "SR:DIAG:BPM:01:GOLDEN:X" ;
    narad_p:protocol "ca" ;
    narad_p:readsSignal narad_sem:bpm_golden_x ;
    narad_p:subfieldDescription "Golden X Position (read-only): Reference horizontal position." .

