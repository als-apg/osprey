    {
      "tool": "correlation",
      "name": "RF thermal",
      "query": "x=SR:RF:CAVITY:01:TEMPERATURE:RB&y=SR:RF:CAVITY:01:POWER:REV&dt=1&n=1000&lookback=1h&view=scatter"
    },
    {
      "tool": "waveform",
      "name": "Septum pulse",
      "query": "pv=SR:MAG:SEPTUM:01:CURRENT:WAVEFORM&persist=10"
    }
  ],
  "updated": "2026-10-25T00:00:00+00:00"
}
