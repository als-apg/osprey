{
  "name": "Control assistant",
  "description": "The facility overview and orbit feedback screens with Orbit, RF thermal and Septum pulse each opened on its own view.",
  "default": true,
  "members": [
    {
      "screen": "library/facility/overview"
    },
    {
      "screen": "library/sr/orbit-feedback"
    },
    {
      "tool": "trace",
