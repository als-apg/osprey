# ============================================================
# {{ project_name }} Configuration
# ============================================================
# Accelerator Control System Assistant
# Based on ALS Assistant deployment (arXiv:2509.17255)
# Claude Code project configuration.
# ============================================================

# Project identity
project_name: "{{ project_name }}"

# Facility identity — one block, two keys:
#   name   — display name woven into the agent prompts (CLAUDE.md, subagents)
#            and the web-terminal landing page. Preferred spelling, and it
#            wins over a top-level `facility_name`, which is honored as a
#            fallback; with neither set, the project name is used.
#   prefix — short abbreviation the deployed web stack uses for container
#            names (`<prefix>-nginx`, `<prefix>-web-<user>`); must be a
#            non-empty valid Docker name start ([a-zA-Z0-9]).
# facility:
#   name: "Example Research Facility"
#   prefix: ex

build_dir: ./build

# Root directory (absolute path)
project_root: {{ project_root }}

# ============================================================
# API CONFIGURATION
# ============================================================
# API keys and endpoints for LLM providers
#
# Each entry takes `api_key`, `base_url`, and a `models` tier map (haiku /
# sonnet / opus -> the model IDs that provider serves).
#
# `base_url` is the endpoint the agent itself uses. For the built-in
# claude_code.provider names (anthropic, cborg, als-apg) a value set here
# overrides the URL the framework ships; omit it to keep the built-in one. A
# trailing `/v1` is stripped for the agent (it appends `/v1/messages`) but kept
# for the OpenAI translation proxy, so leave it on gateways that need it.
#
# A fourth key is read but shipped by no template:
#
#   api.providers.<name>.default_model_id: <a model ID that provider serves>
#
# It is consulted only when framework code calls the completion API with
# neither a model config nor an explicit model_id; without it, such a call
# fails with "Model ID required". It does not pick the agent's model (that is
# claude_code.default_model) and it never overrides the tier map above.

api:
  providers:
    cborg:
      api_key: ${CBORG_API_KEY}
      base_url: https://api.cborg.lbl.gov/v1
      models:                        # Model IDs as named by this provider
        haiku: claude-haiku-4-5
        sonnet: claude-sonnet-4-6
        opus: claude-opus-4-7
    amsc-i2:
      api_key: ${AMSC_I2_API_KEY}
      base_url: https://api.i2-core.american-science-cloud.org/v1
      models:                        # Model IDs as named by this provider
        haiku: claude-haiku
        sonnet: claude-sonnet
        opus: claude-opus
    stanford:
      api_key: ${STANFORD_API_KEY}
      base_url: https://aiapi-prod.stanford.edu/v1
      models:                        # Gateway serves no Opus-class model; o3-mini is the strongest
        haiku: gpt-4o-mini
        sonnet: gpt-4o
        opus: o3-mini
    openai:
      api_key: ${OPENAI_API_KEY}
      base_url: https://api.openai.com/v1
      models:                        # GPT-5 sizes mapped onto the standard tiers
        haiku: gpt-5-nano
        sonnet: gpt-5-mini
        opus: gpt-5
    anthropic:
      api_key: ${ANTHROPIC_API_KEY}
      base_url: https://api.anthropic.com
      models:
        haiku: claude-haiku-4-5-20251001
        sonnet: claude-sonnet-4-5-20250929
        opus: claude-opus-4-6
    google:
      api_key: ${GOOGLE_API_KEY}
      base_url: https://generativelanguage.googleapis.com/v1beta
      models:                        # Gemini 2.5 sizes mapped onto the standard tiers
        haiku: gemini-2.5-flash-lite
        sonnet: gemini-2.5-flash
        opus: gemini-2.5-pro
    ollama:
      api_key: ollama
      base_url: ${OLLAMA_HOST:-http://localhost:11434}
      models:                        # Local models — `ollama pull` each one before use
        haiku: mistral:7b
        sonnet: gpt-oss:20b
        opus: gpt-oss:120b
    argo:
      api_key: ${ARGO_API_KEY}
      base_url: ${ARGO_BASE_URL:-https://apps.inside.anl.gov/argoapi/v1}
      models:                        # Argo spells its model IDs without punctuation
        haiku: claudehaiku45
        sonnet: claudesonnet45
        opus: claudeopus41
    als-apg:
      api_key: ${ALS_APG_API_KEY}
      base_url: ${ALS_APG_BASE_URL:-https://llm.gianlucamartino.com/v1}
      models:
        haiku: claude-haiku-4-5-20251001
        sonnet: claude-sonnet-4-6
        opus: claude-opus-4-6
    # DwarfStar (ds4) — local DeepSeek V4 server (https://github.com/antirez/ds4)
    # No API key required. If the server runs on a remote host, forward the port:
    #   ssh -L 8000:127.0.0.1:8000 <host>
    ds4:
      api_key: EMPTY                  # ds4 ignores auth; any non-empty string works
      base_url: http://127.0.0.1:8000/v1
      # ds4 serves two model sizes; mapped onto the standard tiers so ds4 is a
      # drop-in (flash = fast/cheap tier, pro = capable tiers).
      models:
        haiku: deepseek-v4-flash
        sonnet: deepseek-v4-pro
        opus: deepseek-v4-pro

# ============================================================
# ENVIRONMENT VARIABLES
# ============================================================
# Set these in your .env file (see .env.example for the full provider list):
#
#   CBORG_API_KEY=your-cborg-key
#   AMSC_I2_API_KEY=your-amsc-key
#   STANFORD_API_KEY=...
#   ARGO_API_KEY=your-argo-key
#   ALS_APG_API_KEY=your-als-apg-key
#   OPENAI_API_KEY=sk-...
#   ANTHROPIC_API_KEY=sk-ant-...
#   GOOGLE_API_KEY=...
#
# Optional (for advanced use cases):
#   PROJECT_ROOT=/path/to/override  # Override project_root from config
#   LOCAL_PYTHON_VENV=/path/to/venv/bin/python  # Override Python environment

# ============================================================
# CONTAINER RUNTIME
# ============================================================
# Container runtime selection for deployment
# Options: auto (default), docker, podman
# - auto: Tries Docker first, then Podman
# - docker: Use Docker Desktop (recommended for macOS/Windows)
# - podman: Use Podman (recommended for Linux/security-focused)
# Can also override via CONTAINER_RUNTIME environment variable

container_runtime: auto

# ── Deployment ──────────────────────────────────────────────────────
# Host interface the deployed services publish their ports on. The default
# (127.0.0.1, applied when this block is absent) keeps every service
# loopback-only — the safe state. Binding 0.0.0.0 exposes every deployed
# service port to the network; review credentials first.
# deployment:
#   bind_address: 127.0.0.1

# ============================================================
# SERVICE CONFIGURATION
# ============================================================
# PostgreSQL backs ARIEL logbook search; OpenObserve is the local telemetry
# store. Declare a service here and add its name to `deployed_services:` to
# launch it with `osprey up`.

{% if deploy_services | default(true) %}
services:
  postgresql:
    path: ./services/postgresql
    database_name: ariel
    username: ariel
    # No password key: the Postgres password lives in the project .env as
    # ARIEL_DB_PASSWORD (minted by `osprey up`), read by both the
    # container and the agent's ARIEL DSN — which is derived from the keys in
    # this block rather than written out, so this is the single source of
    # truth for both. Mirrors the openobserve credentials convention.
    port_host: 5432

  # Local telemetry backend for the OSPREY agent — a single-binary OTLP
  # logs/metrics store (see docs/how-to/monitor-agent.rst). This reference
  # facility ships it LIVE: it is deployed below and the agent emits to it (see
  # the `telemetry:` block under `claude_code:`), so `osprey up` +
  # `osprey web` gives you a working, production-shaped observability wiring to
  # copy. `osprey up` mints a strong ZO_ROOT_USER_PASSWORD into .env.
  openobserve:
    path: ./services/openobserve
    port: 5080          # Host port for the OpenObserve UI + OTLP ingest
    retention_days: 14  # Growth bound: drop telemetry older than N days. A named
                        # volume has no hard size cap, so age-based retention is
                        # the "size" knob (min 3; OpenObserve default is ~10y).
                        # `osprey health` reports this and warns if the backing
                        # disk fills.

  # Semantic-search sidecar. It indexes the deployment's markdown corpora — the
  # facility-knowledge bundle at `facility_knowledge.bundle_path`, and the ARIEL
  # mirror that `ariel.enhancement_modules.qmd_export` writes — and answers
  # hybrid keyword+semantic queries over HTTP. It is what backs ranked KNOWLEDGE
  # search and the `hybrid` ARIEL search mode, and it is self-contained: its
  # language models are baked into the image, so unlike the `semantic` search
  # mode it needs no Ollama on the host.
  #
  # Deployed by default. The image is built locally on the first `osprey up`
  # (never pulled; the ~2.1 GB of baked-in models make that first build long —
  # later runs reuse the local tag), and this project's example corpus indexes
  # in seconds. To run without the sidecar, comment out this block, the `- qmd`
  # line below, and the two consumers that feed and query it
  # (`ariel.enhancement_modules.qmd_export`, `ariel.search_modules.hybrid`):
  # KNOWLEDGE search then degrades to substring matching and hybrid logbook
  # search reports itself down.
  qmd:
    path: ./services/qmd
    port: 8180      # Host port clients talk to. Deliberately NOT qmd's own
                    # 8181: the daemon binds IPv6 loopback only, hardcoded, so
                    # the container runs it on an internal 8181 and fronts it
                    # with a forwarder that owns this port.
                    #
                    # There is no per-service bind_address, on purpose. Like
                    # every service here this one publishes on the
                    # project-wide `deployment.bind_address` (default
                    # 127.0.0.1), and that default is load-bearing: the
                    # endpoint carries no token and no TLS, so an interface
                    # other than loopback exposes the whole indexed corpus to
                    # anything that can route to it.
    interval: 30    # Fallback corpus-sweep period, in seconds. The bundle's
                    # `.qmd-touch` marker is the primary re-index trigger, so
                    # this is the ceiling on staleness, not the usual lag.
                    # Raise it on a large corpus, where a no-op sweep is not
                    # free.

# Services to deploy with `osprey up`
deployed_services:
  - postgresql
  - openobserve
  - qmd             # Comment out together with the `qmd:` block above.
{% else %}
# Attached project (deploy_services: false): this project connects to a
# services stack another OSPREY project deployed on the same host, so it
# scaffolds no services of its own. The empty `deployed_services` list is
# explicit so `osprey up` finds it and launches nothing.
services: {}

deployed_services: []
{% endif %}

# ============================================================
# SAFETY CONTROLS
# ============================================================

# Approval workflow for sensitive operations
# Policies: always (prompt every time), selective (content-aware for `execute`
#   only — under `selective` every other tool is treated as `always`), skip (no
#   approval).
# Scope: these policies are applied by the osprey_approval PreToolUse hook, so
# they reach only tools whose matcher runs that hook. A tool with no approval
# hook — the health check, channel-finder queries, most workspace tools — never
# consults this block; what gates those is the rendered settings.json
# permissions.
approval:
  enabled: true
  default_policy: "always"        # Fail-closed for hook-wired tools not listed below
  tools:
    channel_write: always          # Always prompt for hardware writes
    channel_read: skip             # Read-only, no approval needed
    archiver_read: skip            # Historical data, no approval needed
    execute: selective             # Content-aware: checks write patterns + exec mode
    setup_patch: always            # Config mutation needs approval
    entry_create: always           # ARIEL logbook write

# ── Hook observability ──────────────────────────────────────────────
# Shipped ON. This drives three things, not just a debug print:
#   1. one line per hook call to stderr, visible in the terminal that launched
#      the agent;
#   2. an append-only <project>/.claude/hooks/hook_debug.jsonl — never rotated
#      and never size-capped, so prune it yourself on a long-lived deployment;
#   3. the web terminal's Safety-panel hook-activity feed, which reads that
#      file and shows nothing new for as long as this is false (it keeps
#      displaying whatever was already logged).
# The OSPREY_HOOK_DEBUG environment variable forces it on regardless of this key.
hooks:
  debug: true

# ============================================================
# CONTROL SYSTEM & ARCHIVER CONFIGURATION
# ============================================================
# Configuration for control systems and archivers.
# Supports mock mode (development) and production mode (EPICS, etc.)
#
# Development Mode: Works with any channel names (no hardware required)
# Production Mode: Connects to real control system and archiver
# Switch modes by changing 'type' field

control_system:
  # Control system type - determines which runtime connector to use
  # Note: Pattern detection is control-system-agnostic (same for all types)
  # Options (three-state switch):
  #   - mock: Development mode (accepts any channel names, no hardware) — DEFAULT
  #   - virtual_accelerator: Containerized PyAT-backed soft-IOC over real EPICS
  #     Channel Access. Requires the VA service running first — add
  #     virtual_accelerator to deployed_services and run `osprey up`
  #     (see the "Use the Virtual Accelerator" how-to in the OSPREY docs).
  #   - epics: Production EPICS control system (ALS values below)
  type: mock  # <-- Change to 'virtual_accelerator' or 'epics' for other modes

  # Write Access Control - Master safety switch for hardware control
  # This is OPERATOR-LEVEL authorization (always hard-stops if false)
  writes_enabled: true  # Presets and personas pin this value when they are applied,
                        # and this comment is preserved verbatim when they do — so
                        # trust the value on this line, never the comment beside it.
                        # For production: carefully review hardware implications before enabling
                        # If disabled, ALL writes are blocked (non-configurable hard error)

  # Additional tools blocked by the writes kill switch. Framework servers'
  # write-gated tools are added automatically; list custom server tools here so
  # `writes_enabled: false` refuses them too (the same list also drives the
  # headless read-only disallow set).
  # write_tools:
  #   - "mcp__my_server__dangerous_write"

  # Runtime Channel Limits Checking
  limits_checking:
    enabled: true
    database_path: "data/channel_limits.json"
    allow_unlisted_channels: true  # Permissive mode for tutorial

  # Write Verification Configuration
  # How the connector confirms a write took effect. The level below applies only when
  # the caller does not name one: osprey.runtime.write_channel scripts and direct
  # connector calls. The channel_write MCP tool, multi-channel writes, and Bluesky
  # device writes pass an explicit level ("callback"); for those, only a per-channel
  # "verification" entry in channel_limits.json changes the level, and only on
  # single-channel tool writes.
  # A failed verification is not a hard stop. The channel_write MCP tool reports it in
  # its result (verification.verified: false); osprey.runtime.write_channel discards it
  # (a readback mismatch is logged at debug level only); only write_channel_checked
  # raises (plans, which write through the Bluesky bridge's connector-backed
  # devices). A write the CA layer could not deliver at all - for example a PV that
  # never connects - is different: it sets success: false, which does raise from
  # osprey.runtime.write_channel and shows up as a failed write in the MCP tool.
  write_verification:
    default_level: callback  # Options: none, callback, readback
                            # - none: Fast write, no verification (off, on the paths above)
                            # - callback: Control system confirms processing (e.g., EPICS IOC callback)
                            # - readback: Full verification with readback comparison
    default_tolerance_percent: 0.1  # Default tolerance: 0.1% (one per mil)
                                    # Only used for "readback" verification level
                                    # Can be overridden per-channel in channel_limits.json

  # Channel-read response size
  # Array channels (waveforms, camera frames) can be far larger than an agent's
  # context can hold. channel_read returns an array inline only while it fits the
  # budget below; anything larger is saved as an artifact and reported as a
  # summary (shape, dtype, element count, numeric stats) plus a handle to the
  # stored data. Strings and scalars are always inline, whatever their length.
  #
  # The default matches the repo's calibrated inline-plot budget
  # (DEFAULT_MAX_POINTS = 2000 in the Bluesky bridge figure builder): ordinary
  # waveforms and orbit vectors stay inline, camera frames take the artifact path.
  read_inline_max_elements: 2000  # Per-value element count (arrays only).
                                  # One channel_read call also inlines at most 4x
                                  # this many elements in TOTAL across the channels
                                  # it was asked for, consumed in request order;
                                  # channels past that aggregate budget take the
                                  # artifact path even when individually small, and
                                  # say so (artifact_reason: aggregate_budget), so
                                  # re-reading fewer channels inlines them.

  # Per-channel rolling window for those read artifacts: only the newest N
  # UNPINNED entries per channel are kept, older ones are pruned when a new one
  # is saved. Pinned entries never count against the window and are never pruned,
  # so pinning a frame keeps it for good. 0 = keep everything, which lets an
  # unattended polling loop grow the gallery without bound.
  channel_read_artifact_retention: 20

  # Pattern Detection (Layer 1 - Security)
  # Purpose: Detect ALL control system operations in generated code for approval workflows
  #
  # SECURITY: Catches both approved API usage AND circumvention attempts
  # The framework automatically detects:
  #   - Approved: osprey.runtime API (write_channel, read_channel) - has all safety features
  #   - Security: Direct library calls (epics.caput, tango.DeviceProxy, etc.) - bypasses safety
  #   - Future: Other control systems (LabVIEW, custom) - comprehensive detection
  #
  # This ensures LLM-generated code cannot bypass connector safety features (limits, verification)
  # by directly importing control system libraries.
  #
  # Advanced: Extend patterns for custom control system libraries (rarely needed)
  #
  # `mode` decides what your lists do to the framework set above:
  #   extend (default) — your patterns are merged on top of the framework's.
  #   override         — the framework list is REPLACED by exactly what you
  #                      list here. That drops the circumvention detection
  #                      (epics.caput, tango.DeviceProxy, .put(), ...), so the
  #                      guarantee promised above no longer holds: direct
  #                      library calls in generated code stop being flagged for
  #                      approval. Only use it if your lists reproduce that
  #                      coverage themselves.
  #
  # Uncomment and add to customize:
  # patterns:
  #   mode: extend    # extend (default) | override
  #   write:
  #     - 'my_custom_cs_lib\.write\('
  #   read:
  #     - 'my_custom_cs_lib\.read\('

  # Runtime Connectors (Layer 2)
  # Used by: Capabilities (channel_read, channel_write, archiver_retrieval)
  #          and osprey.runtime API (read_channel, write_channel)
  # Purpose: Actual I/O operations to control systems with built-in safety features
  connector:
    # Mock connector (development mode) — driven by the data-driven simulation
    # machine model below. Switch scenarios with `osprey sim apply NAME...`
    # (composes self-contained scenario bundles under data/simulation/scenarios/
    # and seeds their logbook entries; see the sim-scenarios skill).
    # Advanced users can also configure: response_delay_ms, noise_level
    mock:
      simulation_file: data/simulation/machine.json

    # Virtual Accelerator connector (middle rung of the three-state switch) —
    # a containerized PyAT-backed soft-IOC reached over real EPICS Channel
    # Access via VirtualAcceleratorConnector (an EPICSConnector subclass, so
    # the gateway shape below is identical to the `epics` block's). Requires
    # the VA service running first: add virtual_accelerator to
    # deployed_services and run `osprey up` (see the "Use the Virtual
    # Accelerator" how-to in the OSPREY docs).
    #
    # simulation_file: same simulation machine model as the mock connector
    # above, so `osprey sim apply NAME...` stays type-aware and consistent
    # whether you're running mock or virtual_accelerator.
    #
    # Gateway config is CA name-server/TCP mode against localhost — the one
    # host<->container CA configuration confirmed to work across container
    # runtimes (broadcast discovery does not reliably cross the
    # macOS<->container VM boundary). See
    # scripts/va/probe_pcaspy/README.md for the empirical finding.
    #
    # The gateway port is deliberately not written out: with it unset the
    # connector follows services.virtual_accelerator.port, so moving the
    # deployed soft-IOC's port is a one-place edit. Set `port:` on a gateway
    # only to reach a VA this project does not deploy — one on another host,
    # or a container published on a host port different from the one it
    # serves on.
    virtual_accelerator:
      timeout: 5.0
      simulation_file: data/simulation/machine.json
      gateways:
        read_only:
          address: localhost
          # port: 5074
          use_name_server: true
        write_access:
          address: localhost
          # port: 5074
          use_name_server: true

    # EPICS connector (production mode) — ALS production values.
    #
    # PVAccess (PVA) read routing: addresses matching any glob in `pva_channels`
    # are read through the p4p client — the transport NTNDArray camera frames
    # arrive on — and every other address stays on Channel Access. Absent or
    # empty (the default) means pure CA, exactly as before. Addresses stay raw:
    # no pva:// prefixes anywhere, so channel limits, the :SP writability
    # contract and audit records keep matching the same strings. PVA is
    # read-only here — a write to a matching address is refused before any
    # network operation.
    #
    # `pva_gateway` is ONE flat block, not the read_only/write_access pair the
    # CA `gateways` below uses, precisely because there is no PVA write path.
    # It is read only when pva_channels is non-empty, and maps to
    # EPICS_PVA_ADDR_LIST — or to EPICS_PVA_NAME_SERVERS when use_name_server is
    # true (TCP instead of UDP search: what SSH tunnels need). Whenever the block
    # is present, EPICS_PVA_AUTO_ADDR_LIST is forced to "NO", mirroring the
    # EPICS_CA_AUTO_ADDR_LIST containment the CA path applies: a deployment
    # deliberately pinned to a gateway must not also broadcast-discover servers
    # on its local subnet.
    epics:
      timeout: 5.0
      # pva_channels:
      #   - "*:IMAGE*"
      #   - "*:ARRAY*"
      # pva_gateway:
      #   address: your-pva-gateway.example.com  # Replace with your PVA gateway
      #   port: 5075
      #   use_name_server: false  # Set true for SSH tunnels
      gateways:
        read_only:
          address: cagw-alsdmz.als.lbl.gov
          port: 5064
          # use_name_server: Set to true for SSH tunnels (uses EPICS_CA_NAME_SERVERS)
          #                 Set to false for direct gateway (uses EPICS_CA_ADDR_LIST)
          #                 Defaults to false. Can be overridden via environment variable.
          use_name_server: false
        write_access:
          address: cagw-alsdmz.als.lbl.gov
          port: 5084
          use_name_server: false

# Archiver Configuration
archiver:
  # Archiver type determines which connector to use
  # Options:
  #   - mock_archiver: Development mode (generates synthetic data)
  #   - epics_archiver: EPICS Archiver Appliance
  #   - mongodb_archiver: MongoDB time-series collection. Reads a store this
  #     project deploys, seeds and records into — real recorded history, which
  #     is what the control-assistant PRESET selects, because it also declares
  #     the `va_archiver:` block that deploys the store.
  #
  # The default here stays mock_archiver, and deliberately: a project built from
  # this template WITHOUT a `va_archiver:` block deploys no store, so naming a
  # store-backed connector would leave it pointing at something that does not
  # exist and failing at connect. A mock is the honest answer for a project with
  # no archive — it synthesizes, and says so. The flip to a real archive travels
  # with the block that makes the archive exist, which is the preset's job and
  # arrives as an `archiver.type` override at build time.
  type: mock_archiver  # <-- 'epics_archiver' for production

  # Mock archiver (development mode) — synthesizes history from the same
  # simulation machine model as the control-system connector above, so live
  # reads and archiver data stay consistent. The machine file is derived from
  # `control_system.connector.<type>.simulation_file` rather than repeated
  # here. Switch scenarios with `osprey sim apply NAME...` (see the
  # sim-scenarios skill).
  #
  # Uncomment to override: an explicit `simulation_file` wins, and the
  # divergence from the control-system model is logged. Advanced users can
  # also set sample_rate_hz here. `noise_level` is accepted but applies only
  # to channels absent from the simulation machine model — every channel the
  # model serves carries its own per-channel noise, so under the shipped
  # machine.json it changes nothing.
  # mock_archiver:
  #   simulation_file: data/simulation/machine.json

  # EPICS Archiver Appliance (production mode)
  epics_archiver:
    url: https://archiver.als.lbl.gov:8443
    timeout: 60              # Timeout for archiver requests in seconds

  # MongoDB archiver. Its client ships with OSPREY, so there is nothing extra to
  # install. Every key here except port and timeout is required; the connector raises on
  # the first one missing. The password itself is never stored here — it is read
  # at connect time from the environment variable named by password_env, which
  # `osprey up` mints into the project's .env.
  #
  # A project whose build profile declares a `va_archiver:` block has these
  # written from it at build time, so they describe the store this project
  # deploys. Edit them to point at a store someone else runs; edit the profile
  # block instead if this project deploys its own, or the next build overwrites
  # what you wrote here.
  mongodb_archiver:
    host: localhost
    port: 27017             # Optional, defaults to 27017
    name: osprey_archiver
    collection: pv_history
    auth: admin             # Authentication database
    username: osprey
    password_env: MONGO_ROOT_PASSWORD
    timeout: 5              # Optional, defaults to 60 seconds

# ============================================================
# SCAN PLANS (BLUESKY BRIDGE)
# ============================================================
# `bluesky.plan_dirs` adds directories to the plan catalog the Bluesky
# bridge discovers plans from. Read this before using it — the trust it grants
# is not obvious from the key name:
#
#   Plans found through it load at the `preset` trust tier. The three
#   operator-supplied tiers — shipped, preset, facility — are exec'd on
#   discovery unconditionally: no validation gate, no review record. Only the
#   agent-authored `session` tier is hash-checked against a passing validation
#   record before its files are exec'd. A directory listed here is code you are
#   choosing to run, not data you are choosing to read.
#
# Trust order, ascending: shipped < preset < facility < session < unreviewed.
# On a same-name collision a strictly higher tier overrides and a strictly
# lower one is refused; equal tiers let the later-scanned file win.
# BLUESKY_PLAN_DIRS (env, set per bridge instance) is the higher `facility`
# tier, so it outranks this key.
#
# Paths are resolved by the process running the plan loader. The deployed
# bridge is a container with this config.yml mounted at
# /app/project/config.yml, so entries here must be IN-CONTAINER paths. To
# publish a directory from the host instead, use the build profile's
# `bluesky.plan_dir` — the build mounts it read-only and exports
# BLUESKY_PLAN_DIRS for you (at the `facility` tier).
# bluesky:
#   plan_dirs:
#     - /app/project/extra_plans

# Migration from tutorial to production. Every key named below is a field INSIDE
# its section — edit `type:` under `control_system:`, not a new top-level
# `control_system.type:` line. This file is read as nested sections, so a dotted
# line added at the top level configures nothing and is silently ignored.
# 1. Change `type:` under `control_system:` to 'epics' and fill in the epics
#    block above
# 2. Change `type:` under `archiver:` to 'epics_archiver' and point
#    epics_archiver.url at your Archiver Appliance. If you came from the
#    control-assistant preset, that field reads 'mongodb_archiver': the preset
#    both DEPLOYS a store and selects it, so that history is real — but it is a
#    simulated machine's history, which is not what you want against hardware.
# 3. Test with: osprey health
# Your code doesn't need to change!
#
# One thing not to do: hand-flipping the archiver to a store-backed connector
# without deploying a store. Nothing would be writing the archive you just named,
# so it reads as empty rather than as broken — it fails at connect, which is at
# least an error you can act on.
#
# The opposite pairing is refused outright, in all three places it can appear: a
# 'virtual_accelerator' control system whose archiver is 'mock_archiver' — or
# unset, which the connector factory resolves to the mock — is rejected by
# `osprey build`, by `osprey up`, and by the MCP server at startup. A
# simulated machine whose history is synthesized at read time reports a past that
# never happened, and nothing can catch it. Each refusal names the way out:
# declare a `va_archiver:` block and select 'mongodb_archiver' (what this project
# does), point the archiver at a store you run yourself, or set the control
# system to 'mock' for an honestly storeless deployment.

# ============================================================
# CHANNEL FINDER CONFIGURATION
# ============================================================
# Natural language channel finding service configuration
# Pipeline mode: {{ channel_finder_mode }}

channel_finder:
  # Active pipeline mode
  pipeline_mode: {{ default_pipeline }}  # "in_context", "hierarchical", or "middle_layer"

  # osprey:panel-port channel_finder
  # CHANNELS tab: the channel-finder UI is a web server of its own, configured
  # under this section. It launches when `channel-finder` is in the panel list
  # under `web:` below AND this `channel_finder:` section exists — it does, so
  # 8092 is bound by default. Uncomment to move or disable it. (See the
  # COMPANION WEB SERVERS map further down for the resolution order.)
  # web:
  #   host: "127.0.0.1"
  #   port: 8092
  #   auto_launch: true

  # Descriptive names for channels that belong to no device family, generated
  # offline by `osprey channel-finder build-database --use-llm`. That flag
  # hard-fails unless `provider` below is set — it has no fallback to
  # claude_code.provider or any other provider key — so uncomment this block
  # before using it. `model_id` is a tier (haiku | sonnet | opus) resolved
  # through api.providers[provider].models; a non-tier value is passed to the
  # provider unchanged. Build-time only: nothing reads it at run time.
  # channel_name_generation:
  #   llm_model:
  #     provider: {{ default_provider }}
  #     model_id: haiku
  #     max_tokens: 1000
  #   llm_batch_size: 10

  # Pipeline-specific configurations
  pipelines:
{% if enable_in_context %}
    # In-Context Pipeline (Semantic Search)
    # Best for: few hundred channels (example from UCSB FEL)
    in_context:
      database:
        type: template                # Database type: "template" (with device family expansion) or "flat" (simple list)
        path: data/channel_databases/in_context.json
        presentation_mode: template    # Preview rendering only — how `osprey channel-finder
                                      # preview` displays device families. The MCP server and the
                                      # web UI build their own prompt text and never consult it, so
                                      # changing it does not change what the model sees.
                                      # "explicit" - list all expanded channel names (StorageRing_BPM_01_Position_X, StorageRing_BPM_02_Position_X, ...)
                                      # "template" - use pattern notation (StorageRing_BPM_{01-10}_Position_{X,Y})

      # Inner LLM model for the ask_channels subagent tool (set per benchmark cell at runtime)
      subagent_model: null
{% endif %}
{% if enable_hierarchical %}
    # Hierarchical Pipeline (Structured Navigation)
    # Best for: >1,000 channels with clean naming convention
    hierarchical:
      database:
        type: hierarchical            # Always "hierarchical" for this pipeline mode
        path: data/channel_databases/hierarchical.json
                                      # Database must follow nested structure: system → family → device → field → subfield

      # Feedback loop: records successful navigation paths for identical future queries
      # Injects prior paths as hints so the LLM can resolve repeated queries faster
      feedback:
        enabled: true
        store_path: var/agent_data/feedback/hierarchical_feedback.json
                                      # Written at run time, so it lives under
                                      # the var/ STATE zone alongside
                                      # agent_data.base_dir — everything in
                                      # data/ is rebuilt from the profile and
                                      # checksummed into the manifest, and
                                      # every build clears build/.
{% endif %}
{% if enable_middle_layer %}
    # Middle Layer Pipeline (React Agent with MML Database)
    # Best for: MATLAB Middle Layer (MML) style databases, functional hierarchy (System→Family→Field), device/sector filtering
    middle_layer:
      database:
        type: middle_layer            # Always "middle_layer" for this pipeline mode
        path: data/channel_databases/middle_layer.json
                                      # Database must follow MML structure: System → Family → Field → ChannelNames
                                      # Supports optional _description fields and device/sector filtering via DeviceList
        # duckdb_path gates the `run_sql` SQL/FTS tool: with it unset
        # that one tool returns `not_configured` and the other middle-layer
        # tools carry on working. Nothing in build, scaffold or deploy creates
        # the file — build it from the JSON above yourself:
        #   python -m osprey.services.channel_finder.databases.duckdb_import \
        #     --json data/channel_databases/middle_layer.json \
        #     --output data/channel_databases/middle_layer.duckdb
        # A relative path resolves against this config file's directory.
        # duckdb_path: data/channel_databases/middle_layer.duckdb
{% endif %}

  # Benchmarking configuration
  # All paradigms share a single benchmark query set, tier-resolved at build
  # time per channel_finder_mode (in_context → tier 1, hierarchical/middle_layer
  # → tier 3; override with `osprey set tier=N`, then rebuild).  Query file is
  # materialized to data/benchmarks/queries.json by the scaffolder.
  benchmark:
    # Single source of truth — all paradigms read the same query set.
    dataset_path: data/benchmarks/queries.json

# ============================================================
# EXECUTION INFRASTRUCTURE
# ============================================================

# Python execution configuration
execution:
  execution_method: "subprocess"         # Agent Python runs as a host subprocess

  # The environment declaration this project was built from, recorded so the
  # build can be reproduced. Nothing reads it at run time, and editing it here
  # changes nothing — rebuild the project to change the environment.
  #   python           base interpreter the build profile declared. null means
  #                    the build used its own interpreter; its installed
  #                    packages are deliberately not carried over.
  #   packages         extra requirements installed on top of the base.
  #   inherit_exclude  distributions left out when a declared venv base is frozen.
  # No interpreter path is recorded: agent Python runs in this project's own
  # .venv when it has one, resolved at run time.
  environment:
    python: {{ environment_python | default(none) | tojson }}
    packages: {{ environment_packages | default([]) | tojson }}
    inherit_exclude: {{ environment_inherit_exclude | default([]) | tojson }}


# ============================================================
# CLI CONFIGURATION
# ============================================================
# Customize the command-line interface appearance

cli:
  # Theme selection - Options: default | custom
  theme: "default"

  # Custom theme colors (only used when theme: custom)
  # Uncomment and modify to create your own color scheme
  # custom_theme:
  #   primary: "#C75F71"     # Main brand color
  #   success: "#9988A1"     # Success messages
  #   accent: "#F0B8B8"      # Interactive elements
  #   command: "#9988A1"     # Shell commands
  #   path: "#A2AE9D"        # File paths
  #   info: "#9988A1"        # Info messages

  # Custom ASCII banner (optional)
  # Uncomment to override the default Osprey banner
  # banner: |
  #   Your custom ASCII art here


# ============================================================
# SYSTEM CONFIGURATION
# ============================================================

system:
  # Facility timezone: how the agent interprets operator-provided times
  # (parsed as facility-local) and renders all timestamps (with an explicit
  # offset). Pinned to UTC for reproducibility — set your real facility zone
  # (e.g. America/Los_Angeles) in production. Avoid ${TZ:-...}: inheriting the
  # host $TZ makes archiver queries and simulated events non-deterministic.
  timezone: UTC

# Subdirectory names within the agent data directory (see `agent_data:` below).
file_paths:
  api_calls_dir: api_calls
  registry_exports_dir: registry_exports

# ============================================================
# ARIEL - Electronic Logbook Search
# ============================================================
# ARIEL provides semantic search over electronic logbooks.
# Configure the logbook source and search/embedding options below.
#
# Provider credentials are defined in api.providers section above.
# ARIEL references providers by name (e.g., "ollama", "cborg").

ariel:
  # No `database.uri`: the DSN is derived from the `services.postgresql` block
  # above (username, database_name, port_host), so moving the database port or
  # renaming the database stays a one-place edit. Password reads
  # ARIEL_DB_PASSWORD from the project .env — the SAME value the postgresql
  # compose service reads as POSTGRES_PASSWORD, so container and agent auth
  # stay in sync (single source of truth). `osprey up` mints a strong
  # ARIEL_DB_PASSWORD into .env; the fallback password `ariel` keeps the agent
  # launchable before the first deploy. NOTE: an existing Postgres data volume
  # keeps the password it was initialized with — see the postgresql compose
  # template.
  #
  # To point ARIEL at a database this project does not run (an existing
  # facility Postgres, say), set the DSN explicitly — an explicit uri wins over
  # the derived one:
  # database:
  #   uri: postgresql://ariel:${ARIEL_DB_PASSWORD}@logbook-db.example.org:5432/ariel

  # No `ingestion` block: this preset seeds the logbook from its simulation
  # scenario bundles via `osprey sim apply NAME...`, which composes the active
  # scenarios and seeds their logbook entries into Postgres (see the
  # sim-scenarios skill). For production, add an `ingestion` block pointing at
  # your logbook system (adapter + source_url) and use `osprey ariel ingest`.

  # osprey:panel-port ariel
  # ARIEL tab: the search UI is a web server of its own, configured under this
  # section rather than a top-level one. It launches when `ariel` is in the
  # panel list under `web:` below — this section existing is not required, so
  # 8085 is bound by default. Uncomment to move or disable it. (See the
  # COMPANION WEB SERVERS map further down for the resolution order.)
  # web:
  #   host: "127.0.0.1"
  #   port: 8085
  #   auto_launch: true

  # Search modules (leaf-level search functions)
  # provider: references api.providers for credentials (api_key, base_url)
  # Both keyword and semantic are enabled by default.
  # If Ollama/pgvector are unavailable, ARIEL degrades gracefully to keyword-only.
  # NOTE: entries seeded by `osprey sim apply` are keyword-only. Seeding skips
  # the enhancement passes AND drops the embedding tables outright, so
  # recovering semantic search takes two steps: `osprey ariel migrate` to
  # recreate the tables, then `osprey ariel enhance` to fill them. (`osprey
  # ariel sync` is not a shortcut here: it migrates, but then polls an
  # ingestion adapter this preset has none of, and fails before it enhances.)
  # Until then a semantic query disables itself at runtime and returns a notice
  # telling you to use keyword search — it does not silently return zero hits,
  # and it does not run the keyword search for you.
  search_modules:
    keyword:
      enabled: true
    semantic:
      enabled: true      # Degrades gracefully if Ollama/pgvector unavailable
      provider: ollama    # References api.providers.ollama
      model: nomic-embed-text

    # Hybrid keyword+semantic search answered by the qmd sidecar instead of
    # Postgres — the best-ranked retrieval this project ships, and the only
    # semantic-quality mode that needs nothing on the host (the sidecar bakes
    # its models into its image; `semantic` above needs Ollama). Unlike
    # semantic search it does not degrade — a query against a sidecar that is
    # not there is reported as "search is down", on purpose, so that the agent
    # cannot mistake an outage for "nothing matched". It depends on the
    # `services.qmd` sidecar AND the `qmd_export` enhancement below, which
    # writes the markdown mirror the sidecar indexes — disable all three
    # together or not at all.
    hybrid:
      enabled: true
      # These knobs MUST stay under `settings:`. The search-config loader keeps
      # only `enabled`, `provider`, `model` and `settings` and drops every
      # other key without a word, so a knob written as a sibling of `enabled`
      # is silently inert — no error, no warning, just the defaults forever.
      settings:
        rerank: true          # qmd's LLM reranker. Costs roughly 4x the query
                              # latency and its cost barely grows with corpus
                              # size, so no logbook is small enough to outrun
                              # it. This is an agent tool with no interactive
                              # budget to blow, so it keeps the quality path;
                              # set false for the fast one.
        candidate_limit: 40   # Candidates the reranker considers. Lowering it
                              # trades recall for latency.

  # Enhancement modules
  # provider: references api.providers for credentials
  enhancement_modules:
    # Semantic processor: LLM-based keyword extraction and summarization
    # Enables better keyword search quality
    semantic_processor:
      enabled: false  # Requires LLM API calls. Enable for better search quality.
      provider: {{ default_provider }}  # References api.providers; required (no default)
      model:
        model_id: {{ default_model }}
        max_tokens: 256

    # Text embedding: Vector embeddings for semantic search
    # Degrades gracefully if Ollama or pgvector is unavailable
    text_embedding:
      enabled: true   # Degrades gracefully if Ollama/pgvector unavailable
      provider: ollama  # References api.providers.ollama
      models:
        - name: nomic-embed-text
          dimension: 768

    # qmd export: writes one markdown file per entry into a mirror tree that
    # the qmd sidecar indexes. It is what makes `search_modules.hybrid` above
    # able to answer, and it is on for the same reason that one is. An enabled
    # export with no `mirror_path` is refused at startup rather than skipped —
    # a mirror nobody writes reads as "search returns nothing", which is far
    # harder to diagnose than a config error.
    qmd_export:
      enabled: true
      settings:
        # Resolved against the directory holding this file, like every other
        # config-relative path here (`facility_knowledge.bundle_path` follows
        # the same rule). It belongs under var/, the durable STATE zone: the
        # mirror is machine-written from Postgres, is as large as the logbook,
        # and the repo's .gitignore keeps var/ out of git — a path under data/
        # would commit a generated corpus. The compose generator binds this
        # same value into the sidecar read-only, so moving the mirror stays a
        # one-place edit.
        mirror_path: var/ariel_mirror

  # Default provider for EMBEDDING modules that name none of their own. It is
  # not a general fallback: the semantic_processor LLM module above requires
  # its own explicit `provider`.
  embedding:
    provider: ollama

# ============================================================
# LOGBOOK COMPOSITION
# ============================================================
# LLM settings for the logbook compose panel in the artifact gallery.
# provider: references api.providers for credentials (api_key, base_url).
#   Omit it and composition uses claude_code.provider; with neither set the
#   compose panel reports that logbook.composition.provider is unconfigured.
# default_tier: which model tier to use when the operator doesn't choose one.
# The operator can override the tier (haiku/sonnet/opus) from the UI; the tier
# is mapped to a model ID via api.providers[provider].models — there is no
# model_id key here. Add one only for a provider whose models mapping has no
# entry for the tier you use; otherwise composition fails naming the gap.

logbook:
  composition:
    provider: {{ default_provider }}
    default_tier: haiku   # Options: haiku | sonnet | opus

# ============================================================
# FACILITY KNOWLEDGE
# ============================================================
# OKF bundle providing deep facility knowledge (subsystems, devices,
# procedures, physics notes, references) to the facility_knowledge
# MCP server.  Resolved relative to this config file's directory
# (project root).  Replace with the absolute path to your own bundle
# once you have customised the example content.

facility_knowledge:
  bundle_path: data/facility_knowledge

  # osprey:panel-port okf
  # KNOWLEDGE tab. This section has two jobs: `bundle_path` above feeds the
  # facility-knowledge MCP server, `osprey knowledge`, and the OKF panel server
  # itself (the launcher passes the resolved path into the panel app), while
  # the three keys below configure that panel's web server. It launches when
  # `okf` is in the panel list under `web:` below and this section exists —
  # which it does, so this project binds 8093 by default. Uncomment to move or
  # disable it.
  # host: "127.0.0.1"
  # port: 8093
  # auto_launch: true

# ============================================================
# AGENT DATA & ARTIFACT GALLERY
# ============================================================
# Working directory for artifacts, data context, screenshots, etc.
# Resolved relative to `project_root` above — the deployment repo's root, not
# this file's directory. It belongs under var/, the durable STATE zone: build/
# is wiped and re-rendered by every build, and the repo's .gitignore keeps var/
# out of git. A path outside var/ would land the agent's memory in the tracked
# source zone and dirty `git status` on first run.

agent_data:
  base_dir: "var/agent_data"

# ============================================================
# COMPANION WEB SERVERS (PANEL PORTS)
# ============================================================
# Every panel tab in `osprey web` is served by its own small web server, and
# each one takes host/port/auto_launch from its own config section. These six
# are the complete set — artifact_server is the only one this file writes a
# stanza for, and the other five run at their defaults, so this is the map:
#
#   tab        keys live under        default port   port env var
#   WORKSPACE  artifact_server        8086           OSPREY_ARTIFACT_SERVER_PORT
#   ARIEL      ariel.web              8085           OSPREY_ARIEL_PORT
#   CHANNELS   channel_finder.web     8092           OSPREY_CHANNEL_FINDER_PORT
#   LATTICE    lattice_dashboard      8097           OSPREY_LATTICE_DASHBOARD_PORT
#   KNOWLEDGE  facility_knowledge     8093           OSPREY_FACILITY_KNOWLEDGE_PORT
#   SYSTEM     health.web             8094           OSPREY_HEALTH_PORT
#
# The stanza for each lives in the section named above; all six carry a
# machine-readable marker comment so they can be found by name.
#
# Resolution order in every case: the env var above wins, then this config's
# `port`, then the built-in default. Multi-user deployments export the env var
# per user (the per-user containers share one network namespace), which is why
# config alone is never the last word. `host` has no env override and defaults
# to 127.0.0.1. The launcher resolves host/port through one shared function;
# for WORKSPACE the web terminal uses that same function, but for the other
# five it computes the panel's URL separately and the two are kept in step by
# hand — so an env override must be set consistently.
#
# What actually starts a server: `auto_launch` (default true) AND — for every
# panel except WORKSPACE — the panel being listed under `web:` at the bottom of
# this file. CHANNELS, LATTICE and KNOWLEDGE additionally need their top-level
# section to exist at all — with no section they never launch, whatever the
# panel list says.

# osprey:panel-port artifact
# WORKSPACE tab. Universal: under `osprey web` it is launched at startup
# regardless of the panel list (headless runs instead start it on the first
# artifact save), so `auto_launch: false` is the only thing that stops it — and
# when it does, the tab is reported unavailable rather than serving a dead
# iframe.
artifact_server:
  host: "127.0.0.1"
  port: 8086
  auto_launch: true

# osprey:panel-port lattice_dashboard
# LATTICE tab. No `lattice_dashboard:` section ships here, so the dashboard
# never auto-launches in this project. Uncomment to turn it on, and add
# `lattice` to the panel list under `web:` below.
# lattice_dashboard:
#   host: "127.0.0.1"
#   port: 8097
#   auto_launch: true

# osprey:panel-port system_health
# SYSTEM tab. Unlike LATTICE and KNOWLEDGE it needs no section of its own — the
# health framework has usable defaults — so with `system-health` in the panel
# list it binds 8094 without appearing anywhere in this file. Uncomment only to
# move it or to switch it off.
# health:
#   web:
#     host: "127.0.0.1"
#     port: 8094
#     auto_launch: true

# ============================================================
# CLAUDE CODE INTEGRATION
# ============================================================
# Controls which MCP servers and agents `osprey build` generates.
#
# Auto-derived servers (always present unless disabled):
#   controls               (core)
#   python                 (core)
#   workspace              (core)
#   ariel                  (core)
#
# Auto-derived from config sections (present when section exists):
#   channel_finder: section → channel-finder MCP server + channel-finder agent
#
# Auto-derived agents (always present unless disabled):
#   logbook-search, logbook-deep-research
#
claude_code:
  # servers:                 # Override server settings
  #   my-server:             # Add a custom MCP server
  #     command: "node"
  #     args: ["my-server.js"]
  #     env:
  #       MY_VAR: "value"
  # agents:                  # Override agent settings
  #   literature-search:
  #     enabled: false       # Disable an agent
  #
  # ── Model Provider ──────────────────────────────────────────
  # Which provider serves Claude models. Must support Anthropic Messages API.
  # Built-in: anthropic (direct), cborg (LBNL proxy), als-apg (ALS AWS proxy)
  # Custom proxy: any name defined under api.providers below
  #   (must have base_url set; uses ANTHROPIC_AUTH_TOKEN + provider model IDs)
  #   Only the three built-ins above are recognised as Anthropic-native by
  #   name. Every other provider is assumed to speak OpenAI protocol and is
  #   routed through the translation proxy to /chat/completions. If yours is
  #   Anthropic-native, add `api_protocol: anthropic` to its api.providers
  #   entry to skip that hop:
  #     api.providers.my-proxy.api_protocol: anthropic
  # When set, `osprey build` injects env vars into .claude/settings.json.
  # permissions:              # Override Claude Code permission policies
  #   allow: []               # Additional tools to auto-allow
  #   deny: []                # Additional tools to deny
  #   ask: []                 # Additional tools requiring human approval
  #   remove_deny:            # Remove tools from default deny list
  #     - Bash                # Example: allow Bash for trusted facility
  provider: {{ default_provider }}
  default_model: {{ default_model | default("haiku") }}   # Options: haiku, sonnet, opus
  #
  # Override model IDs per tier (optional):
  # models:
  #   haiku: anthropic/claude-haiku-alt
  #
  # Override model tier per agent (optional):
  # agent_models:
  #   logbook-search: haiku
  #   logbook-deep-research: sonnet
  #
  # ── Telemetry / Observability (on by default, local + loopback-bound) ──
  # Like every OSPREY template, this facility ships telemetry ON: `osprey up`
  # + `osprey web` produces a working, production-shaped wiring where the
  # agent emits OTLP logs + metrics to the co-deployed OpenObserve store
  # (declared in `services:` and listed in `deployed_services:` above; UI at
  # http://localhost:5080). On by default: the underlying harness already records
  # every prompt, response, and API body to disk, so this adds no new exposure —
  # it just makes that data queryable in a local store you own. To turn it off,
  # set `enabled: false`. Tracing and OTEL_LOG_TOOL_CONTENT are intentionally NOT
  # wired. See docs/how-to/monitor-agent.rst.
  telemetry:
    enabled: true                        # Master switch (on for this reference facility)
    backend: openobserve                 # openobserve | generic
    protocol: http/protobuf              # http/protobuf | grpc — grpc requires an explicit `endpoint:` below; it is refused against the auto-derived openobserve endpoint (HTTP only)
    # backend: openobserve auto-derives the endpoint per network context —
    # http://localhost:5080/api/<org> on the host, http://openobserve:5080/api/<org>
    # inside the deploy network — so `endpoint` is intentionally OMITTED here.
    # (Hardcoding localhost would make the in-container dispatch worker emit to
    # its own loopback and silently drop everything.)
    #
    # OpenObserve auth + org routing. user/password read the OpenObserve root
    # credentials from the project .env — the SAME values the openobserve
    # service reads — so container and agent auth stay in sync (single source of
    # truth). `osprey up` mints a strong ZO_ROOT_USER_PASSWORD into .env;
    # the ${VAR:-default} fallbacks (mirroring the openobserve compose defaults)
    # keep the agent launchable before the first deploy.
    openobserve:
      user: ${ZO_ROOT_USER_EMAIL:-root@example.com}
      password: ${ZO_ROOT_USER_PASSWORD:-Complexpass#123}
      org: default
    # Content gates — all default ON. This store captures full transcripts; it
    # is local and air-gapped, so full capture is the default posture. Set any
    # to false to suppress that category from emitted telemetry.
    log_user_prompts: true               # Operator chat prompts
    log_assistant_responses: true        # Agent replies
    log_tool_details: true               # Tool names + arguments
    log_raw_api_bodies: true             # Raw provider request/response bodies

# ============================================================
# WEB TERMINAL
# ============================================================
# The terminal process itself (`osprey web`) — a different section from `web:`
# below, which configures the panel tabs it renders. Both are read; no
# `web_terminal:` block is written out here, so every key is at its default.
# web_terminal:
#   host: "127.0.0.1"    # Bind address. A deployment that DECLARES
#                        # OSPREY_TERMINAL_BIND_HOST — the multi-user compose
#                        # sets it on every per-user container so nginx is the
#                        # only off-host path — overrides both this key and
#                        # --host, so this cannot punch through that chokepoint.
#   port: 8087           # Likewise outranked by OSPREY_TERMINAL_WEB_PORT.
#   shell: /path/to/claude
#                        # argv spawned in every PTY. Setting it REPLACES the
#                        # launcher, so it also defeats the
#                        # claude_code.cli_version pin above.
#   max_background_sessions: 5
#   watch_dir: var/agent_data
#                        # Directory the Workspace file watcher follows.
#                        # Unset, it falls back to `agent_data.base_dir`
#                        # anchored on `project_root` — the same directory
#                        # this config already names — so set it only to
#                        # watch somewhere else deliberately.

# ============================================================
# WEB PANEL CONFIGURATION
# ============================================================
# Controls the web terminal UI (osprey web): its theme and which panel tabs
# appear. The Workspace panel is always shown; the Activity log is a separate
# page, not a tab. Domain-specific panels are listed here — remove or disable
# as needed.

web:
  # Default web UI theme. Two forms, and the difference matters:
  #   - a theme FAMILY ("main", "desy", "high-contrast", "retro") sets the
  #     palette and leaves light/dark to each viewer's OS preference;
  #   - a concrete theme id ("desy-light", "high-contrast-light") additionally
  #     PINS light or dark as this deployment's default.
  # A user's in-browser choice (display menu, ?theme=, localStorage) always
  # overrides this default; an unknown value warns and falls back to "main",
  # which is also what applies while this stays commented. In a multi-user
  # deployment, a roster entry's `theme:` (rendered as OSPREY_WEB_THEME)
  # overrides this per user. Independent of `cli.theme` above (console-only) —
  # the two never share a value.
  # theme: main
{%- set _BUILTIN_PANELS = builtin_panels | default(["ariel", "channel-finder"]) %}
{%- set _enabled_builtin_panels = selected_web_panels | select("in", _BUILTIN_PANELS) | list %}
{%- if default_panel is defined and default_panel %}
  # Tab focused on cold load. Falls back to "artifacts" (Workspace) when unset.
  default_panel: {{ default_panel }}
{%- endif %}
{%- if _enabled_builtin_panels %}
  panels:
{%- for panel in _enabled_builtin_panels %}
    {{ panel }}:
      enabled: true
{%- endfor %}
    # Custom panels are declared via `config:` dotted overrides, e.g.:
    # config:
    #   web.panels.my-grafana.label: "GRAFANA"
    #   web.panels.my-grafana.url: "http://grafana.local:3000"
    #   web.panels.my-grafana.health_endpoint: "/api/health"
    #   web.panels.my-grafana.path: "/"
    #   web.panels.my-grafana.hidden: true   # launch the panel but keep its tab hidden until the agent shows it
    #   web.panels.my-grafana.rewrite_json_paths: ["/config.json"]
    #     Panels are served through the terminal's reverse proxy, which
    #     rewrites root-absolute paths in HTML/JS/CSS but passes JSON through
    #     untouched (rewriting arbitrary API payloads would corrupt data). Some
    #     backends bootstrap their UI from a JSON config endpoint carrying an
    #     API base path — proxied, that UI then calls the browser's origin and
    #     silently breaks. List those endpoints' path suffixes here to opt them
    #     into the same rewrite.
    #
    # (The dotted keys above are build-profile `config:` override syntax, which
    # is expanded into nested YAML at build time. Inside this file use the
    # nested form — config.yml is never flattened; a dotted key written here
    # is stored verbatim and read by nothing.)
{%- else %}
  panels: {}  # No builtin panels enabled; custom panels (if any) added via config overrides
{%- endif %}
  # Runtime panel control by the agent (optional; OFF by default). These sit at
  # the `web:` level, NOT under `panels:`:
  # allow_runtime_panels: true                       # let the agent register ad-hoc URL panels at runtime
  # runtime_panel_allowlist: ["grafana.local:3000"]  # restrict registration targets to these host[:port]

  # Channel-name typeahead in the web panels. `osprey build` reads this
  # project's channel-finder database and writes the channel names it holds
  # next to the generated config, so a form field asking for a channel can
  # complete what an operator types. The suggestions come from that snapshot
  # alone: no control-system traffic, no round trip to the agent, and nothing
  # to keep in sync at run time. It is on by default because the database is
  # already built; the snapshot is only written when a `channel_finder:`
  # section is configured above.
  #
  # `max_channels` guards the browser, not the build: every panel load fetches
  # the whole snapshot, so a database with more channels than this limit is
  # skipped instead of shipped, the build says which limit it hit, and the
  # panels simply offer no suggestions — fields still accept any name typed in
  # full. Raise the limit to cover a larger facility, or set `enabled: false`
  # to turn the feature off and write no snapshot at all. Both keys fall back
  # to the values shown here if removed. A build profile overrides them from
  # its `config:` block in the dotted form, e.g.
  # `web.channel_suggestions.max_channels: 200000`.
  channel_suggestions:
    enabled: true
    max_channels: 50000
{%- if panel_presets is defined and panel_presets %}
  # Panel layouts ("Layouts"): named sets of panels a human applies in one click
  # from the web terminal "+" popover. The key is the menu label; the value is
  # the exact set of panels to show (non-member panels close). Members must be
  # enabled built-in or custom panel ids.
  presets:
{%- for preset_name, preset_panels in panel_presets.items() %}
    {{ preset_name | tojson }}: [{{ preset_panels | join(", ") }}]
{%- endfor %}
{%- else %}
  # Panel layouts ("Layouts"): named sets of panels a human applies in one click
  # from the "+" popover (non-member panels close). Uncomment to define some:
  # presets:
  #   "Machine setup": [channel-finder, lattice, artifacts, okf]
  #   "Logbook review": [ariel, artifacts]
{%- endif %}

# ──────────────────────────────────────────────────────────────────────
# User-Owned Build Artifacts
# ──────────────────────────────────────────────────────────────────────
# Claim framework-managed build artifacts for in-place editing.
# A rebuild skips user-owned files, preserving your customizations.
# Run `osprey scaffold list` to see all available artifacts.
# Run `osprey scaffold claim <name>` to claim an artifact for editing.
#
# scaffold:
#   user_owned:
#     - rules/facility    # Auto-claimed on init — edit .claude/rules/facility.md

# ──────────────────────────────────────────────────────────────────────
# Multi-user web terminals (optional)
# ──────────────────────────────────────────────────────────────────────
# Set by the multi-user presets, not by hand — documented here so the values
# `osprey build` appends land in a named section instead of a bare tail.
#
#   facility.name / facility.prefix
#       Display name, and the container-name prefix for the web stack
#       (`<prefix>-nginx`, `<prefix>-web-<user>`). The only rule enforced is
#       non-emptiness — an empty prefix renders `-nginx`, which Docker
#       rejects, so `osprey build` lints for it. Beyond that the value must be
#       a valid Docker name start ([a-zA-Z0-9]); the shipped presets follow a
#       short lowercase convention (`ca`, `mu`). Also documented at the top of
#       this file.
#   deploy.fqdn
#       Browser-reachable origin for the landing page. The render REFUSES to
#       build the landing URL without it once any user is configured.
#   modules.web_terminals
#       The per-user terminal stack: enabled, image_source, nginx_port, the
#       per-user port families, and the user list. Per-user containers share
#       the host network namespace, so each companion panel needs its own port
#       family; families left unset fall back to the registry defaults.
#
# See docs/how-to/web-terminal/multi-user.rst for the full schema. The build
# interview (/osprey-build-interview) fills these in when you tell it the
# deployment serves several operators.
