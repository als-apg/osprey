  --database data/channel_databases/{{ channel_finder_mode }}.json

# Preview database contents
uv run osprey channel-finder preview \
  --database data/channel_databases/{{ channel_finder_mode }}.json
```

### Benchmark Runner

Evaluate channel finder performance:

```bash
# Run all benchmarks
uv run python -m {{ package_name }}.services.channel_finder.benchmarks.cli

# Run subset of queries
uv run python -m {{ package_name }}.services.channel_finder.benchmarks.cli --queries 0:10

# Override model
uv run python -m {{ package_name }}.services.channel_finder.benchmarks.cli --model anthropic/claude-sonnet

# Show detailed logs
uv run python -m {{ package_name }}.services.channel_finder.benchmarks.cli --verbose
```

