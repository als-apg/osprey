# ============================================================
# {{ project_name }} Configuration — Channel Finder Standalone
# ============================================================
# Natural-language channel/PV address finding, on its own. No control-system
# runtime, no archiver, no logbook (ARIEL), no Python executor, no hardware
# writes. This bundle ships only the channel-finder pipeline + its interactive
# web panel, backed by a bundled demo channel database.
# ============================================================

# Project identity
project_name: "{{ project_name }}"

# Facility identity — one block, two keys:
#   name   — display name woven into the agent prompts (CLAUDE.md, subagents)
#            and the web-terminal landing page. Keep it in sync with
#            .claude/rules/facility.md. A top-level `facility_name` is
#            honored as a fallback, but this is the canonical spelling and
#            wins over it.
#   prefix — short abbreviation the deployed web stack uses for container
#            names (`<prefix>-nginx`, `<prefix>-web-<user>`); must be a
#            non-empty valid Docker name start ([a-zA-Z0-9]). Only the
#            multi-user web-terminal stack reads it, so it stays commented
#            here.
facility:
  name: "Example Research Facility"
  # prefix: ex

build_dir: ./build

# Root directory (absolute path)
project_root: {{ project_root }}

# ============================================================
# API CONFIGURATION
# ============================================================
# API keys and endpoints for LLM providers. The channel-finder subagent
# references the provider by name (e.g. "{{ default_provider }}") for the
# reasoning loop that resolves user descriptions to real addresses.

api:
  providers:
    cborg:
      api_key: ${CBORG_API_KEY}
      base_url: https://api.cborg.lbl.gov/v1
      models:
        haiku: claude-haiku-4-5
        sonnet: claude-sonnet-4-6
        opus: claude-opus-4-7
    openai:
      api_key: ${OPENAI_API_KEY}
      base_url: https://api.openai.com/v1
      models:                        # GPT-5 sizes mapped onto the standard tiers
        haiku: gpt-5-nano
        sonnet: gpt-5-mini
        opus: gpt-5
    anthropic:
      api_key: ${ANTHROPIC_API_KEY}
      base_url: https://api.anthropic.com
      models:
        haiku: claude-haiku-4-5-20251001
        sonnet: claude-sonnet-4-5-20250929
        opus: claude-opus-4-6
    google:
      api_key: ${GOOGLE_API_KEY}
      base_url: https://generativelanguage.googleapis.com/v1beta
      models:                        # Gemini 2.5 sizes mapped onto the standard tiers
        haiku: gemini-2.5-flash-lite
        sonnet: gemini-2.5-flash
        opus: gemini-2.5-pro
    ollama:
      api_key: ollama
      base_url: ${OLLAMA_HOST:-http://localhost:11434}
      models:                        # Local models — `ollama pull` each one before use
        haiku: mistral:7b
        sonnet: gpt-oss:20b
        opus: gpt-oss:120b
    als-apg:
      api_key: ${ALS_APG_API_KEY}
      base_url: ${ALS_APG_BASE_URL:-https://llm.gianlucamartino.com/v1}
      models:
        haiku: claude-haiku-4-5-20251001
        sonnet: claude-sonnet-4-6
        opus: claude-opus-4-6

# ============================================================
# ENVIRONMENT VARIABLES
# ============================================================
# Set these in your .env file:
#
#   ANTHROPIC_API_KEY=sk-ant-...    # or CBORG_API_KEY for the LBL proxy
#

# ============================================================
# CONTAINER RUNTIME
# ============================================================
# Container runtime selection for deployment
# Options: auto (default), docker, podman
container_runtime: auto

# ============================================================
# SYSTEM CONFIGURATION
# ============================================================
system:
  # Facility timezone — timestamps rendered in this zone. Pinned to UTC for
  # reproducibility; set your real facility zone (e.g. America/Los_Angeles).
  timezone: UTC

# ============================================================
# SERVICES
# ============================================================
# The channel finder is file-backed (a channel database read directly by the
# panel server and the MCP tools); it needs no Postgres, Typesense, or other
# standing service. `osprey web` runs it with zero `osprey up`.
deployed_services: []

# ============================================================
# SAFETY CONTROLS
# ============================================================
# Approval workflow. The channel finder is read-only (it returns addresses,
# never writes), so no write tools are gated here.
# Scope: these policies are applied by the osprey_approval PreToolUse hook and
# reach only tools whose matcher runs it. The channel-finder server wires no
# such matcher, so NO channel-finder query ever consults this block — in this
# app the only tool it governs is the workspace setup_patch tool. Everything
# else is gated by the rendered settings.json permissions.
approval:
  enabled: true
  default_policy: "always"        # Fail-closed for hook-wired tools not listed below

# ── Hook observability ──────────────────────────────────────────────
# Shipped ON. This drives three things, not just a debug print: one line per
# hook call to stderr; an append-only <project>/.claude/hooks/hook_debug.jsonl
# that is never rotated or size-capped (prune it yourself on a long-lived
# deployment); and the web terminal's Safety-panel hook-activity feed, which
# reads that file and shows nothing new while this is false. The OSPREY_HOOK_DEBUG
# environment variable forces it on regardless of this key.
hooks:
  debug: true

# ============================================================
# CHANNEL FINDER CONFIGURATION
# ============================================================
# Natural language channel finding service. Pipeline mode: {{ channel_finder_mode }}
# The active pipeline and its enable flags are derived at build time from the
# profile's `channel_finder_mode` (in_context | hierarchical | middle_layer).

channel_finder:
  # Active pipeline mode
  pipeline_mode: {{ default_pipeline }}

  # osprey:panel-port channel_finder
  # CHANNELS tab: the channel-finder UI is a web server of its own, configured
  # under this section. It launches when `channel-finder` is in the panel list
  # under `web:` below AND this `channel_finder:` section exists — it does, so
  # 8092 is bound by default. Resolution order: OSPREY_CHANNEL_FINDER_PORT wins
  # (multi-user deployments export it per user), then `port` here, then the
  # built-in 8092; `host` has no env override. The launcher resolves host/port
  # through one shared function; the web terminal computes this panel's URL
  # separately and is kept in step by hand, so an env override must be set
  # consistently. Uncomment to move or disable it.
  # web:
  #   host: "127.0.0.1"
  #   port: 8092
  #   auto_launch: true

  # Descriptive names for channels that belong to no device family, generated
  # offline by `osprey channel-finder build-database --use-llm`. That flag
  # hard-fails unless `provider` below is set — it has no fallback to
  # claude_code.provider or any other provider key — so uncomment this block
  # before using it. `model_id` is a tier (haiku | sonnet | opus) resolved
  # through api.providers[provider].models; a non-tier value is passed to the
  # provider unchanged. Build-time only: nothing reads it at run time.
  # channel_name_generation:
  #   llm_model:
  #     provider: {{ default_provider }}
  #     model_id: haiku
  #     max_tokens: 1000
  #   llm_batch_size: 10

  # Pipeline-specific configurations
  pipelines:
{% if enable_in_context %}
    # In-Context Pipeline (Semantic Search) — best for a few hundred channels.
    in_context:
      database:
        type: template                # "template" (device-family expansion) or "flat"
        path: data/channel_databases/in_context.json
        presentation_mode: template   # "explicit" (list all names) or "template" (pattern notation).
                                      # Preview rendering only — `osprey channel-finder preview`
                                      # honours it; the MCP server and the web UI build their own
                                      # prompt text and never consult it.
      subagent_model: null
{% endif %}
{% if enable_hierarchical %}
    # Hierarchical Pipeline (Structured Navigation) — best for >1,000 channels
    # with a clean naming convention.
    hierarchical:
      database:
        type: hierarchical            # Always "hierarchical" for this pipeline mode
        path: data/channel_databases/hierarchical.json
                                      # Nested: system -> family -> device -> field -> subfield
      # Feedback loop: records successful navigation paths for identical queries.
      feedback:
        enabled: true
        store_path: var/agent_data/feedback/hierarchical_feedback.json
                                      # Runtime state, so it sits in the var/
                                      # STATE zone alongside
                                      # agent_data.base_dir — data/ is
                                      # build-owned and every build clears
                                      # build/.
{% endif %}
{% if enable_middle_layer %}
    # Middle Layer Pipeline (React Agent with MML Database) — best for
    # MATLAB Middle Layer style databases (System -> Family -> Field).
    middle_layer:
      database:
        type: middle_layer            # Always "middle_layer" for this pipeline mode
        path: data/channel_databases/middle_layer.json
                                      # MML structure: System -> Family -> Field -> ChannelNames
        # duckdb_path gates the `query_channels` SQL/FTS tool: with it unset
        # that one tool returns `not_configured` and the other middle-layer
        # tools carry on working. Nothing in build, scaffold or deploy creates
        # the file — build it from the JSON above yourself:
        #   python -m osprey.services.channel_finder.databases.duckdb_import \
        #     --json data/channel_databases/middle_layer.json \
        #     --output data/channel_databases/middle_layer.duckdb
        # A relative path resolves against this config file's directory.
        # duckdb_path: data/channel_databases/middle_layer.duckdb
{% endif %}

  # No `benchmark:` block: the scored query corpus ships with the
  # control-assistant bundle only, so there is no query file here for a
  # dataset_path to point at. `osprey channel-finder benchmark` still runs in
  # this project — bring your own query set with `--queries-path FILE`. To make
  # it the default instead, add the file and name it here:
  # benchmark:
  #   dataset_path: data/benchmarks/queries.json

# ============================================================
# AGENT DATA & ARTIFACT GALLERY
# ============================================================
# Resolved relative to `project_root` above — the deployment repo's root, not
# this file's directory. It belongs under var/, the durable STATE zone: build/
# is wiped and re-rendered by every build, and the repo's .gitignore keeps var/
# out of git. A path outside var/ would land the agent's memory in the tracked
# source zone and dirty `git status` on first run.
agent_data:
  base_dir: "var/agent_data"

# Subdirectory names within the agent data directory above. A subdirectory key
# absent from this block falls back to the key's own name, so without it the
# registry export lands in `<agent_data.base_dir>/registry_exports_dir/`.
file_paths:
  api_calls_dir: api_calls
  registry_exports_dir: registry_exports

# osprey:panel-port artifact
# WORKSPACE tab. Universal: under `osprey web` it is launched at startup
# whatever panels are listed under `web:` below (headless runs instead start it
# on the first artifact save), so `auto_launch: false` is the only thing that
# stops it — and when it does, the tab is reported unavailable rather than
# serving a dead iframe. Port resolution is the one shared function every launcher and URL
# builder uses: OSPREY_ARTIFACT_SERVER_PORT wins (multi-user deployments export
# it per user), then `port` here, then the built-in 8086. `host` has no env
# override.
artifact_server:
  host: "127.0.0.1"
  port: 8086
  auto_launch: true

# ============================================================
# CLAUDE CODE INTEGRATION
# ============================================================
# The channel-finder subagent (auto-derived from the `channel_finder:` section
# above) owns the indexed hierarchy traversal. Every other framework MCP server
# is disabled: no control-system or python sandbox (no hardware reads/writes),
# no ariel (no logbook here), no facility-knowledge (no OKF bundle here). Only
# osprey_workspace (artifact handoff) and channel-finder remain.

claude_code:
  servers:
    controls:
      enabled: false
    python:
      enabled: false
    ariel:
      enabled: false
    osprey_facility_knowledge:
      enabled: false

  provider: {{ default_provider }}
  default_model: {{ default_model | default("haiku") }}   # Options: haiku, sonnet, opus

  # ── Telemetry / Observability ──
  # Off by default here: the standalone channel finder ships with no OpenObserve
  # service, so telemetry has nowhere local to land. Enable it (and add the
  # openobserve service) if you want a queryable local store.
  telemetry:
    enabled: false

# ============================================================
# WEB PANEL CONFIGURATION
# ============================================================
# Controls which panel tabs appear in the web terminal (osprey web).
# The Workspace panel is always shown; the Activity log is a separate page,
# not a tab.

web:
{%- set _BUILTIN_PANELS = builtin_panels | default(["ariel", "channel-finder"]) %}
{%- set _enabled_builtin_panels = selected_web_panels | select("in", _BUILTIN_PANELS) | list %}
{%- if default_panel is defined and default_panel %}
  # Tab focused on cold load. Falls back to "artifacts" (Workspace) when unset.
  default_panel: {{ default_panel }}
{%- endif %}
{%- if _enabled_builtin_panels %}
  panels:
{%- for panel in _enabled_builtin_panels %}
    {{ panel }}:
      enabled: true
{%- endfor %}
{%- else %}
  panels: {}
{%- endif %}
  # Optional panel controls (off by default; uncomment to use). These are
  # nested keys under `web:` — config.yml is never flattened, so a dotted
  # key like `web.allow_runtime_panels` written here is stored verbatim and
  # read by nothing. The dotted spelling belongs only in a build profile's
  # `config:` block, which is expanded into nested YAML at build time.
  # panels:
  #   <id>:
  #     hidden: true                          # launch the panel but keep its tab hidden until shown
  # allow_runtime_panels: true                # let the agent register ad-hoc URL panels at runtime
  # runtime_panel_allowlist: ["dashboard.local:3000"]  # restrict registration targets to these host[:port]
  # presets:                                  # named "Layouts" a human applies from the "+" popover
  #   "Channel work": [channel-finder, artifacts]
