# ============================================================
# {{ project_name }} Configuration
# ============================================================
# Hello World — one MCP server, a mock control system, and the full
# write-safety chain. Nothing in this file needs hardware, and no
# containers are involved until `osprey up` (see SERVICE CONFIGURATION).
#
# This file is GENERATED by `osprey build` from your profile.yml. Make
# lasting changes in the profile's `config:` block (one dotted key per
# line) and rebuild — edits made here are overwritten by the next build,
# and a session-start check warns when the build has gone stale.
# ============================================================

# Project identity
project_name: "{{ project_name }}"

# Facility identity — one block, two keys:
#   name   — display name woven into the agent prompts (CLAUDE.md, subagents)
#            and the web-terminal landing page. Preferred spelling, and it
#            wins over a top-level `facility_name`, which is honored as a
#            fallback; with neither set, the project name is used.
#   prefix — short abbreviation the deployed web stack uses for container
#            names (`<prefix>-nginx`, `<prefix>-web-<user>`); must be a
#            non-empty valid Docker name start ([a-zA-Z0-9]).
# facility:
#   name: "Example Research Facility"
#   prefix: ex

build_dir: ./build

# Root directory (absolute path)
project_root: {{ project_root }}

# ============================================================
# API CONFIGURATION
# ============================================================
# API keys and endpoints for LLM providers

api:
  providers:
    cborg:
      api_key: ${CBORG_API_KEY}
      base_url: https://api.cborg.lbl.gov/v1
      models:                        # Model IDs as named by this provider
        haiku: claude-haiku-4-5
        sonnet: claude-sonnet-4-6
        opus: claude-opus-4-7
    amsc-i2:
      api_key: ${AMSC_I2_API_KEY}
      base_url: https://api.i2-core.american-science-cloud.org/v1
      models:                        # Model IDs as named by this provider
        haiku: claude-haiku
        sonnet: claude-sonnet
        opus: claude-opus
    stanford:
      api_key: ${STANFORD_API_KEY}
      base_url: https://aiapi-prod.stanford.edu/v1
      models:                        # Gateway serves no Opus-class model; o3-mini is the strongest
        haiku: gpt-4o-mini
        sonnet: gpt-4o
        opus: o3-mini
    openai:
      api_key: ${OPENAI_API_KEY}
      base_url: https://api.openai.com/v1
      models:                        # GPT-5 sizes mapped onto the standard tiers
        haiku: gpt-5-nano
        sonnet: gpt-5-mini
        opus: gpt-5
    anthropic:
      api_key: ${ANTHROPIC_API_KEY}
      base_url: https://api.anthropic.com
      models:
        haiku: claude-haiku-4-5-20251001
        sonnet: claude-sonnet-4-5-20250929
        opus: claude-opus-4-6
    google:
      api_key: ${GOOGLE_API_KEY}
      base_url: https://generativelanguage.googleapis.com/v1beta
      models:                        # Gemini 2.5 sizes mapped onto the standard tiers
        haiku: gemini-2.5-flash-lite
        sonnet: gemini-2.5-flash
        opus: gemini-2.5-pro
    ollama:
      api_key: ollama
      base_url: ${OLLAMA_HOST:-http://localhost:11434}
      models:                        # Local models — `ollama pull` each one before use
        haiku: mistral:7b
        sonnet: gpt-oss:20b
        opus: gpt-oss:120b
    argo:
      api_key: ${ARGO_API_KEY}
      base_url: ${ARGO_BASE_URL:-https://apps.inside.anl.gov/argoapi/v1}
      models:                        # Argo spells its model IDs without punctuation
        haiku: claudehaiku45
        sonnet: claudesonnet45
        opus: claudeopus41
    als-apg:
      api_key: ${ALS_APG_API_KEY}
      base_url: ${ALS_APG_BASE_URL:-https://llm.gianlucamartino.com/v1}
      models:
        haiku: claude-haiku-4-5-20251001
        sonnet: claude-sonnet-4-6
        opus: claude-opus-4-6
    # DwarfStar (ds4) — local DeepSeek V4 server (https://github.com/antirez/ds4)
    # No API key required. If the server runs on a remote host, forward the port:
    #   ssh -L 8000:127.0.0.1:8000 <host>
    ds4:
      api_key: EMPTY                  # ds4 ignores auth; any non-empty string works
      base_url: http://127.0.0.1:8000/v1
      # ds4 serves two model sizes; mapped onto the standard tiers so ds4 is a
      # drop-in (flash = fast/cheap tier, pro = capable tiers).
      models:
        haiku: deepseek-v4-flash
        sonnet: deepseek-v4-pro
        opus: deepseek-v4-pro

# ============================================================
# ENVIRONMENT VARIABLES
# ============================================================
# API keys live in your repo's .env file, never in this one. Only the
# provider selected under `claude_code.provider` below needs its key:
#
#   ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# CONTROL SYSTEM CONFIGURATION
# ============================================================
# type: mock — the connector invents channel values in-process, so the
# agent can read ANY channel name without hardware. That is the whole
# trick behind the five-minute first session: ask for SR:BEAM:CURRENT
# (or anything else) and a plausible value comes back.
#
# Ready for real hardware? This minimal preset stays mock-only; the
# control-assistant preset ships the full EPICS connector configuration
# (gateway addresses, timeouts) — your agent's code never changes, only
# the connector behind it.

control_system:
  type: mock

  # Master write switch — the FIRST guard in the write-safety chain.
  # While false, every hardware write is refused outright, before the
  # limits check or approval prompt is even consulted. To try the full
  # write flow: uncomment `control_system.writes_enabled: true` in your
  # profile.yml `config:` block and rebuild.
  writes_enabled: false

  # Additional tools blocked by the writes kill switch. Framework servers'
  # write-gated tools are added automatically; list custom server tools here so
  # `writes_enabled: false` refuses them too (the same list also drives the
  # headless read-only disallow set).
  # write_tools:
  #   - "mcp__my_server__dangerous_write"

  # Channel limits — the SECOND guard. Every write is checked against
  # data/channel_limits.json (relative to this file's directory) —
  # per-channel min/max values and writable flags. That file is a build
  # copy: edit the one beside profile.yml and rebuild to change it.
  # allow_unlisted_channels keeps channels missing from that file usable,
  # which the mock's invented channels need; a production config sets it
  # false so an unknown channel fails closed instead.
  limits_checking:
    enabled: true
    database_path: "data/channel_limits.json"
    allow_unlisted_channels: true

  # How much of an array channel comes back inline. Waveforms and camera frames
  # can be far larger than the agent's context, so channel_read inlines an array
  # only while it fits the budget below and saves anything larger as an artifact,
  # reporting a summary plus a handle instead. Strings and scalars always inline.
  # 2000 is the same inline budget the plotting path uses. One channel_read call
  # inlines at most 4x that many elements in total across the channels asked for.
  read_inline_max_elements: 2000
  # Newest N UNPINNED read artifacts per channel are kept; older ones are pruned
  # on save. Pinned entries are never pruned. 0 = keep everything.
  channel_read_artifact_retention: 20
  # Reading arrays over PVAccess (the `pva_channels` / `pva_gateway` keys under
  # control_system.connector.epics) needs the EPICS connector, which this
  # mock-only preset does not ship — the control-assistant preset shows it.

# Archiver — historical channel data behind the archiver_read tool.
# mock_archiver generates synthetic history, so "plot the beam current
# over the last hour" works out of the box. A real deployment points
# this at an EPICS Archiver Appliance instead (`type: epics_archiver`
# plus an `epics_archiver.url` — the control-assistant preset shows it).
archiver:
  type: mock_archiver

# ============================================================
# HUMAN-IN-THE-LOOP APPROVAL
# ============================================================
# The THIRD guard in the write-safety chain: a write that got past the
# master switch and the limits check still pauses for a yes/no prompt.
# Per-tool policies enforced by the osprey_approval PreToolUse hook.
# default_policy is fail-closed ("always"): any hook-wired tool not listed here
# requires approval, so reads need an explicit "skip" entry. The policies reach
# only tools whose matcher runs the approval hook — a tool with no approval hook
# (the health check, most workspace tools) is gated by the rendered
# settings.json permissions instead, not by this block.
# "selective" is content-aware for `execute` only; every other tool under
# "selective" is treated as "always".

approval:
  enabled: true
  default_policy: "always"        # Fail-closed for hook-wired tools not listed below
  tools:
    channel_write: always          # Always prompt for hardware writes
    channel_read: skip             # Read-only, no approval needed
    archiver_read: skip            # Historical data, no approval needed
    execute: selective             # Content-aware: checks write patterns + exec mode
    setup_patch: always            # Config mutation needs approval
    entry_create: always           # ARIEL logbook write (inert here: the
                                   # ariel server is disabled below)

# ── Hook observability ──────────────────────────────────────────────
# Shipped OFF here (the readers default to false when the section is absent).
# Turning it on drives three things, not just a debug print: one line per hook
# call to stderr; an append-only <project>/.claude/hooks/hook_debug.jsonl that
# is never rotated or size-capped (prune it yourself on a long-lived
# deployment); and the web terminal's Safety-panel hook-activity feed, which
# reads that file and shows nothing new while this is false. The
# OSPREY_HOOK_DEBUG environment variable forces it on regardless of this key,
# and the Safety panel's own toggle writes this key back into config.yml —
# creating the section even though the template ships none.
# hooks:
#   debug: true

# ============================================================
# EXECUTION INFRASTRUCTURE
# ============================================================

execution:
  execution_method: "subprocess"

  # Build provenance: the environment declaration this project was built from.
  # Nothing reads it at run time — agent Python runs in this project's own .venv
  # when it has one, resolved at run time, so no interpreter path is recorded.
  environment:
    python: {{ environment_python | default(none) | tojson }}
    packages: {{ environment_packages | default([]) | tojson }}
    inherit_exclude: {{ environment_inherit_exclude | default([]) | tojson }}

# ============================================================
# SYSTEM CONFIGURATION
# ============================================================

system:
  # Pinned to UTC for reproducibility — set your real facility zone in
  # production. Avoid ${TZ:-...}: inheriting the host $TZ makes archiver
  # queries and simulated events non-deterministic. Governs how the agent
  # interprets operator times and renders all timestamps.
  timezone: UTC

# Subdirectory names within the agent data directory (see `agent_data:` below).
file_paths:
  api_calls_dir: api_calls
  registry_exports_dir: registry_exports

# ============================================================
# AGENT DATA & ARTIFACT GALLERY
# ============================================================
# Working directory for artifacts, data context, screenshots, etc.
# Resolved relative to `project_root` above — the deployment repo's root, not
# this file's directory. It belongs under var/, the durable STATE zone: build/
# is wiped and re-rendered by every build, and the repo's .gitignore keeps var/
# out of git. A path outside var/ would land the agent's memory in the tracked
# source zone and dirty `git status` on first run.

agent_data:
  base_dir: "var/agent_data"

# osprey:panel-port artifact
# WORKSPACE tab. Universal: under `osprey web` it is launched at startup
# whether or not any panels are configured (headless runs instead start it on
# the first artifact save), so `auto_launch: false` is the only thing that stops
# it — and when it does, the tab is reported unavailable rather than serving a
# dead iframe. Port resolution is the one shared function every launcher and
# URL builder uses: OSPREY_ARTIFACT_SERVER_PORT wins (multi-user deployments
# export it per user), then `port` here, then the built-in 8086. `host` has no
# env override.
artifact_server:
  host: "127.0.0.1"
  port: 8086
  auto_launch: true

# ============================================================
# CONTAINER RUNTIME
# ============================================================
# Everything above runs container-free. A container runtime is consulted
# only by `osprey up`, which deploys the services below.
# Options: auto (default), docker, podman
# Can also override via CONTAINER_RUNTIME environment variable
container_runtime: auto

# ============================================================
# SERVICE CONFIGURATION
# ============================================================
# Containerized companion services — the one part of this project that
# uses Docker/podman. Declare a service under `services:` (so
# `osprey health` recognizes it) and add its name to `deployed_services:` to
# actually launch it with `osprey up`. This preset deploys exactly one.

# ── Deployment ──────────────────────────────────────────────────────
# Host interface the deployed services publish their ports on. The default
# (127.0.0.1, applied when this block is absent) keeps every service
# loopback-only — the safe state. Binding 0.0.0.0 exposes every deployed
# service port to the network; review credentials first.
# deployment:
#   bind_address: 127.0.0.1

{% if deploy_services | default(true) %}
services:
  # Local telemetry backend for the OSPREY agent — a single-binary OTLP
  # logs/metrics store (see the `telemetry:` block under `claude_code:` below
  # and docs/how-to/monitor-agent.rst). Deployed by default: the agent emits its
  # telemetry here, so `osprey up` + `osprey web` gives you a working,
  # queryable observability store out of the box. Bound to localhost. This is the
  # only container this minimal template deploys, so `osprey up` needs a
  # container runtime (Docker/podman) running.
  openobserve:
    path: ./services/openobserve
    port: 5080          # Host port for the OpenObserve UI + OTLP ingest
    retention_days: 14  # Growth bound: drop data older than N days (min 3). A
                        # named volume has no size cap, so age is the size knob.

# Services to deploy with `osprey up`
deployed_services:
  - openobserve
{% else %}
# Attached project (deploy_services: false): connects to a services stack
# another OSPREY project deployed on the same host, so it scaffolds nothing.
services: {}

deployed_services: []
{% endif %}

# ============================================================
# CLAUDE CODE INTEGRATION
# ============================================================
# Which MCP servers and subagents `osprey build` wires into the agent.
# Only the controls server is on: channel reads, writes, and archiver
# queries. The logbook (ariel) and channel-finder servers stay off until
# there is a logbook or channel database to back them — the
# control-assistant preset shows them enabled.

claude_code:
  servers:
    controls: {enabled: true}
    ariel: {enabled: false}
    channel-finder: {enabled: false}
  agents:
    logbook-search: {enabled: false}
    logbook-deep-research: {enabled: false}
  provider: {{ default_provider }}
  default_model: {{ default_model | default("haiku") }}

  # ── Telemetry / Observability (on by default, local + loopback-bound) ──
  # The agent emits OTLP logs + metrics to the co-deployed OpenObserve store
  # (declared in `services:` and listed in `deployed_services:` above; UI at
  # http://localhost:5080). On by default: the underlying harness already records
  # every prompt, response, and API body to disk, so this adds no new exposure —
  # it just makes that data queryable in a local store you own. To turn it off,
  # set `enabled: false`. Tracing and OTEL_LOG_TOOL_CONTENT are intentionally
  # NOT wired. See docs/how-to/monitor-agent.rst.
  telemetry:
    enabled: true                        # Master switch
    backend: openobserve                 # openobserve | generic
    protocol: http/protobuf              # http/protobuf | grpc — grpc requires an explicit `endpoint:` below; it is refused against the auto-derived openobserve endpoint (HTTP only)
    # backend: openobserve auto-derives the endpoint per network context, so
    # `endpoint` is intentionally OMITTED. OpenObserve auth reads the root
    # credentials from the project .env — the SAME values the openobserve service
    # reads — so container and agent auth stay in sync. `osprey up` mints a
    # strong ZO_ROOT_USER_PASSWORD into .env; the ${VAR:-default} fallbacks keep
    # the agent launchable before the first deploy.
    openobserve:
      user: ${ZO_ROOT_USER_EMAIL:-root@example.com}
      password: ${ZO_ROOT_USER_PASSWORD:-Complexpass#123}
      org: default
    # Content gates — all default ON. The store is local and loopback-bound, so
    # full capture is the default posture; set any to false to suppress that
    # category.
    log_user_prompts: true               # Operator chat prompts
    log_assistant_responses: true        # Agent replies
    log_tool_details: true               # Tool names + arguments
    log_raw_api_bodies: true             # Raw provider request/response bodies
