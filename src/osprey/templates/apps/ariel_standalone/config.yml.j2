# ============================================================
# {{ project_name }} Configuration — ARIEL Standalone
# ============================================================
# Logbook search and research deployment. No control-system runtime;
# no channel finding, no archiver, no Python executor.
# This bundle ships Postgres+pgvector and the ARIEL web/MCP/search stack.
# ============================================================

# Project identity
project_name: "{{ project_name }}"

# Facility identity — one block, two keys:
#   name   — display name woven into the agent prompts (CLAUDE.md, subagents)
#            and the web-terminal landing page. Keep it in sync with
#            .claude/rules/facility.md. A top-level `facility_name` is
#            honored as a fallback, but this is the canonical spelling and
#            wins over it.
#   prefix — short abbreviation the deployed web stack uses for container
#            names (`<prefix>-nginx`, `<prefix>-web-<user>`); must be a
#            non-empty valid Docker name start ([a-zA-Z0-9]). Only the
#            multi-user web-terminal stack reads it, so it stays commented
#            here.
facility:
  name: "Example Research Facility"
  # prefix: ex

build_dir: ./build

# Root directory (absolute path)
project_root: {{ project_root }}

# ============================================================
# API CONFIGURATION
# ============================================================
# API keys and endpoints for LLM providers. ARIEL references providers
# by name (e.g. "ollama" for embeddings, "{{ default_provider }}" for
# enhancement / composition).

api:
  providers:
    cborg:
      api_key: ${CBORG_API_KEY}
      base_url: https://api.cborg.lbl.gov/v1
      models:
        haiku: claude-haiku-4-5
        sonnet: claude-sonnet-4-6
        opus: claude-opus-4-7
    openai:
      api_key: ${OPENAI_API_KEY}
      base_url: https://api.openai.com/v1
      models:                        # GPT-5 sizes mapped onto the standard tiers
        haiku: gpt-5-nano
        sonnet: gpt-5-mini
        opus: gpt-5
    anthropic:
      api_key: ${ANTHROPIC_API_KEY}
      base_url: https://api.anthropic.com
      models:
        haiku: claude-haiku-4-5-20251001
        sonnet: claude-sonnet-4-5-20250929
        opus: claude-opus-4-6
    google:
      api_key: ${GOOGLE_API_KEY}
      base_url: https://generativelanguage.googleapis.com/v1beta
      models:                        # Gemini 2.5 sizes mapped onto the standard tiers
        haiku: gemini-2.5-flash-lite
        sonnet: gemini-2.5-flash
        opus: gemini-2.5-pro
    ollama:
      api_key: ollama
      base_url: ${OLLAMA_HOST:-http://localhost:11434}
      models:                        # Local models — `ollama pull` each one before use
        haiku: mistral:7b
        sonnet: gpt-oss:20b
        opus: gpt-oss:120b
    als-apg:
      api_key: ${ALS_APG_API_KEY}
      base_url: ${ALS_APG_BASE_URL:-https://llm.gianlucamartino.com/v1}
      models:
        haiku: claude-haiku-4-5-20251001
        sonnet: claude-sonnet-4-6
        opus: claude-opus-4-6

# ============================================================
# ENVIRONMENT VARIABLES
# ============================================================
# Set these in your .env file:
#
#   ANTHROPIC_API_KEY=sk-ant-...    # or CBORG_API_KEY for the LBL proxy
#   OLLAMA_HOST=http://localhost:11434  # optional: semantic search embeddings
#

# ============================================================
# CONTAINER RUNTIME
# ============================================================
# Container runtime selection for deployment
# Options: auto (default), docker, podman
container_runtime: auto

# ── Deployment ──────────────────────────────────────────────────────
# Host interface the deployed services publish their ports on. The default
# (127.0.0.1, applied when this block is absent) keeps every service
# loopback-only — the safe state. Binding 0.0.0.0 exposes every deployed
# service port to the network; review credentials first.
# deployment:
#   bind_address: 127.0.0.1

# ============================================================
# SYSTEM CONFIGURATION
# ============================================================
system:
  # Facility timezone: ARIEL parses operator-provided times as facility-local
  # and renders all logbook timestamps in this zone (with an explicit offset).
  # Pinned to UTC for reproducibility — set your real facility zone
  # (e.g. America/Los_Angeles) in production. Avoid ${TZ:-...}: inheriting the
  # host $TZ makes logbook queries and rendered timestamps non-deterministic.
  timezone: UTC

# ============================================================
# SERVICE CONFIGURATION
# ============================================================
# PostgreSQL backs ARIEL logbook search; OpenObserve is the local telemetry
# store. Declare a service here and add its name to `deployed_services:` to
# launch it with `osprey up`.

{% if deploy_services | default(true) %}
services:
  postgresql:
    path: ./services/postgresql
    database_name: ariel
    username: ariel
    # No password key: the Postgres password lives in the project .env as
    # ARIEL_DB_PASSWORD (minted by `osprey up`), read by both the
    # container and the agent's ARIEL DSN — which is derived from the keys in
    # this block rather than written out, so this is the single source of
    # truth for both. Mirrors the openobserve credentials convention.
    port_host: 5432

  # Local telemetry backend for the OSPREY agent — a single-binary OTLP
  # logs/metrics store (see the `telemetry:` block under `claude_code:` below
  # and docs/how-to/monitor-agent.rst). Deployed by default: the agent emits its
  # telemetry here, so `osprey up` + `osprey web` gives you a working,
  # queryable observability store out of the box. Bound to localhost.
  openobserve:
    path: ./services/openobserve
    port: 5080          # Host port for the OpenObserve UI + OTLP ingest
    retention_days: 14  # Growth bound: drop data older than N days (min 3). A
                        # named volume has no size cap, so age is the size knob.

  # Semantic-search sidecar. It indexes the deployment's markdown corpora — the
  # ARIEL mirror that `ariel.enhancement_modules.qmd_export` writes, and a
  # facility-knowledge bundle if one is configured — and answers hybrid
  # keyword+semantic queries over HTTP. It backs the `hybrid` ARIEL search
  # mode, and it is self-contained: its language models are baked into the
  # image, so unlike the `semantic` search mode it needs no Ollama on the host.
  #
  # Deployed by default, together with the two ARIEL blocks that feed and
  # query it (`ariel.enhancement_modules.qmd_export`,
  # `ariel.search_modules.hybrid`) — disable all three together or not at all.
  # The image is built locally on the first `osprey up` (never pulled; the
  # ~2.1 GB of baked-in models make that first build long).
  #
  # SIZE WARNING: the first index pass scans the whole mirror before the
  # sidecar opens its port — measured at ~41 minutes for a 135,000-entry
  # logbook. `osprey health` shows the container as starting until then; a
  # deployment attaching a large existing logbook should expect that one-time
  # cost, and raise `interval` (see below) once it is up.
  qmd:
    path: ./services/qmd
    port: 8180      # Host port clients talk to. Deliberately NOT qmd's own
                    # 8181: the daemon binds IPv6 loopback only, hardcoded, so
                    # the container runs it on an internal 8181 and fronts it
                    # with a forwarder that owns this port.
                    #
                    # There is no per-service bind_address, on purpose. Like
                    # every service here this one publishes on the
                    # project-wide `deployment.bind_address` (default
                    # 127.0.0.1), and that default is load-bearing: the
                    # endpoint carries no token and no TLS, so an interface
                    # other than loopback exposes the whole indexed corpus to
                    # anything that can route to it.
    interval: 30    # Fallback corpus-sweep period, in seconds. The bundle's
                    # `.qmd-touch` marker is the primary re-index trigger, so
                    # this is the ceiling on staleness, not the usual lag.
                    # Raise it on a large corpus, where a no-op sweep is not
                    # free (~12.5 s at 135,000 entries).

# Services to deploy with `osprey up`
deployed_services:
  - postgresql
  - openobserve
  - qmd             # Comment out together with the `qmd:` block above.
{% else %}
# Attached project (deploy_services: false): connects to a services stack
# another OSPREY project deployed on the same host, so it scaffolds nothing.
services: {}

deployed_services: []
{% endif %}

# ============================================================
# SAFETY CONTROLS
# ============================================================

# Approval workflow for sensitive operations
# Policies: always (prompt every time), selective (content-aware for `execute`
#   only — under `selective` every other tool is treated as `always`), skip (no
#   approval).
# Scope: applied by the osprey_approval PreToolUse hook, so these policies reach
# only tools whose matcher runs that hook — in this app exactly three: ARIEL
# `entry_create`, workspace `setup_patch`, and facility-knowledge
# `draft_concept`. Everything else is gated by the rendered settings.json
# permissions instead.
approval:
  enabled: true
  default_policy: "always"        # Fail-closed for hook-wired tools not listed below
  tools:
    entry_create: always           # ARIEL logbook entry creation requires approval

# ── Hook observability ──────────────────────────────────────────────
# Shipped ON. This drives three things, not just a debug print: one line per
# hook call to stderr; an append-only <project>/.claude/hooks/hook_debug.jsonl
# that is never rotated or size-capped (prune it yourself on a long-lived
# deployment); and the web terminal's Safety-panel hook-activity feed, which
# reads that file and shows nothing new while this is false. The OSPREY_HOOK_DEBUG
# environment variable forces it on regardless of this key.
hooks:
  debug: true

# ============================================================
# ARIEL CONFIGURATION
# ============================================================
# Logbook search service: keyword + semantic search + entry retrieval.
# Higher-level reasoning is owned by the Osprey agent layer; ARIEL itself
# exposes raw search and entry lookup over MCP/HTTP.

ariel:
  # No `database.uri`: the DSN is derived from the `services.postgresql` block
  # above (username, database_name, port_host), so moving the database port or
  # renaming the database stays a one-place edit. Password reads
  # ARIEL_DB_PASSWORD from the project .env — the SAME value the postgresql
  # compose service reads as POSTGRES_PASSWORD (single source of truth).
  # `osprey up` mints a strong value into .env; the fallback password
  # `ariel` keeps the service launchable before the first deploy. An existing
  # Postgres data volume keeps the password it was initialized with — see the
  # postgresql compose template.
  #
  # To point ARIEL at a database this project does not run (an existing
  # facility Postgres, say), set the DSN explicitly — an explicit uri wins over
  # the derived one:
  # database:
  #   uri: postgresql://ariel:${ARIEL_DB_PASSWORD}@logbook-db.example.org:5432/ariel

  # osprey:panel-port ariel
  # ARIEL tab: the search UI is a web server of its own, configured under this
  # section rather than a top-level one. It launches when `ariel` is in the
  # panel list under `web:` below; this section existing is not required, so
  # 8085 is bound by default. Resolution order: OSPREY_ARIEL_PORT wins
  # (multi-user deployments export it per user), then `port` here, then the
  # built-in 8085; `host` has no env override. The launcher resolves host/port
  # through one shared function; the web terminal computes this panel's URL
  # separately and is kept in step by hand, so an env override must be set
  # consistently. Uncomment to move or disable it.
  # web:
  #   host: "127.0.0.1"
  #   port: 8085
  #   auto_launch: true

  # Ingestion - demo logbook data (bundled with template)
  # For production: change adapter and source_url to your logbook system
  ingestion:
    adapter: generic_json
    source_url: data/logbook_seed/demo_logbook.json

  # Which module answers a search that names no mode — the web interface's
  # opening tab, `osprey ariel search` without `--mode`, and the service API.
  # Naming a module that is not enabled below is refused at startup rather
  # than quietly answered by a different one. Unset, this resolves to `hybrid`
  # where that module is enabled and `keyword` everywhere else.
  default_search_mode: hybrid

  # Facility vocabulary: the shorthand operators type ("t/s the bpm offset"),
  # mapped to the words the logbook prose actually contains ("troubleshoot",
  # "beam position monitor"). Stemming cannot bridge those two spellings, so
  # without it a search typed in control-room shorthand misses the entries that
  # describe exactly what it asked about. Expansion is plain dictionary
  # matching — no model, no network call — and every rewrite comes back as
  # `expanded_terms`, so a surprising hit arrives with its reason.
  #
  # OFF here, because a vocabulary is facility content and this template ships
  # none: shorthand is only worth expanding when it is YOUR control room's.
  # Write a `vocabulary.yml` (the `control-assistant` app template ships a
  # twenty-concept example and a format walkthrough under `data/ariel/`),
  # uncomment the path below and flip `enabled` to true.
  #
  # The file is read ONCE, when this config is parsed — not lazily on the first
  # search — so a broken file fails loudly at startup rather than quietly
  # halving your recall: the ARIEL panel comes up in CONFIGURATION INVALID mode
  # with the errors and the fix on screen, search returns 503 naming
  # `ariel.vocabulary.path`, and the MCP server refuses to start. Validate
  # before you deploy with `osprey ariel vocab-check <file>`; the recovery is to
  # set `enabled: false` or repoint `path`, then restart.
  vocabulary:
    enabled: false

    # Resolved against the directory holding this file, like every other
    # config-relative path here (`qmd_export.mirror_path` below follows the
    # same rule).
    # path: data/ariel/vocabulary.yml

    # Whether a search that expresses no preference gets expansion. The
    # per-request `expand_query` argument overrides it in both directions.
    expand_by_default: true

    # The two direction gates, deliberately asymmetric. Matching a form and
    # adding its canonical is always on (`bpm` finds "beam position monitor").
    # These control the REVERSE: spelling a canonical out and also searching
    # the short form. For an acronym that is free recall — an initialism means
    # one thing. For ordinary words it is not: expanding "calibration" into
    # "cal" drags in far more noise than it recovers.
    canonical_to_acronym: true
    canonical_to_shorthand: false

    # No `expand_modes` key: unset means every enabled search module expands,
    # which is what a facility wants until proven otherwise, and a shipped list
    # would rot the moment a module is toggled. The key exists as one specific
    # knob — hybrid search feeds the expanded query to the qmd sidecar's LLM
    # reranker, so a facility whose reranked ordering degrades under expansion
    # sets `expand_modes: [keyword, semantic]` here to drop `hybrid` alone
    # without giving up expansion everywhere else.

  # Search modules (leaf-level search functions)
  # Both keyword and semantic are enabled out of the box.
  # If Ollama/pgvector are unavailable, ARIEL degrades gracefully to keyword-only.
  search_modules:
    keyword:
      enabled: true
      # These knobs MUST stay under `settings:`. The search-config loader keeps
      # only `enabled`, `provider`, `model` and `settings` and drops every
      # other key without a word, so a knob written as a sibling of `enabled`
      # is silently inert — no error, just the defaults forever.
      settings:
        # Pattern tokens in a keyword query: `*` globs (`SR01C___BPM*`, with
        # `?` as a single-character wildcard inside a glob) and explicit
        # `/regex/` tokens, run as case-insensitive matches against the entry
        # text — a glob is additionally anchored to word boundaries, an
        # explicit `/regex/` is matched exactly as written. Both need at
        # least 3 consecutive literal characters to be indexable; below that
        # the token is searched as ordinary text and the search says so in
        # its diagnostics. Set false to make `*` and `/…/` plain words again.
        patterns_enabled: true
        # The wall-clock envelope a pattern search runs under. Applied only to
        # a query that actually emitted a pattern predicate, so an ordinary
        # keyword search is untouched by it. A pattern that cannot use the
        # index scans the whole logbook; this returns a timeout diagnostic
        # instead of holding the caller open, so a slow query is
        # distinguishable from an empty one.
        pattern_timeout_seconds: 10.0
    semantic:
      enabled: true      # Degrades gracefully if Ollama/pgvector unavailable
      provider: ollama   # References api.providers.ollama
      model: nomic-embed-text

    # Hybrid keyword+semantic search answered by the qmd sidecar instead of
    # Postgres — the best-ranked retrieval this project ships, and the only
    # semantic-quality mode that needs nothing on the host (the sidecar bakes
    # its models into its image; `semantic` above needs Ollama). It needs two
    # other things running: the `services.qmd` sidecar, and the markdown
    # mirror that the `qmd_export` enhancement below writes for it to index.
    # All three are on by default — disable them together or not at all:
    # enabled without the others, the mode is advertised to the agent and then
    # fails every call with "search is down".
    hybrid:
      enabled: true
      # These knobs MUST stay under `settings:`. The search-config loader keeps
      # only `enabled`, `provider`, `model` and `settings` and drops every
      # other key without a word, so a knob written as a sibling of `enabled`
      # is silently inert — no error, just the defaults forever.
      settings:
        rerank: true          # qmd's LLM reranker. Costs roughly 4x the query
                              # latency and its cost barely grows with corpus
                              # size. This is an agent tool with no interactive
                              # budget to blow, so it keeps the quality path;
                              # set false for the fast one.
        candidate_limit: 40   # Candidates the reranker considers. Lowering it
                              # trades recall for latency.

  # Enhancement modules — run during ingestion
  enhancement_modules:
    # Semantic processor: LLM-based keyword extraction and summarization
    semantic_processor:
      enabled: false                          # Requires LLM API calls
      provider: {{ default_provider }}         # Required (no default)
      model:
        model_id: {{ default_model }}
        max_tokens: 256

    # Text embedding: Vector embeddings for semantic search
    text_embedding:
      enabled: true                           # Degrades gracefully if Ollama/pgvector unavailable
      provider: ollama
      models:
        - name: nomic-embed-text
          dimension: 768

    # qmd export: writes one markdown file per entry into a mirror tree that
    # the qmd sidecar indexes. It is what makes `search_modules.hybrid` above
    # able to answer, and it is on for the same reason that one is.
    qmd_export:
      enabled: true
      settings:
        # Resolved against the directory holding this file, like every other
        # config-relative path here. It belongs under var/, the durable STATE
        # zone: the mirror is machine-written from Postgres, is as large as the
        # logbook, and the repo's .gitignore keeps var/ out of git. The compose
        # generator binds this same path into the sidecar read-only, so moving
        # it stays a one-place edit.
        mirror_path: var/ariel_mirror

  # Default provider for EMBEDDING modules that name none of their own. It is
  # not a general fallback: the semantic_processor LLM module above requires
  # its own explicit `provider`.
  embedding:
    provider: ollama

# ============================================================
# LOGBOOK COMPOSITION
# ============================================================
# LLM settings for the logbook compose panel in the artifact gallery.
# provider falls back to claude_code.provider when omitted; default_tier is
# mapped to a model ID via api.providers[provider].models, so no model_id key
# is needed unless that mapping has no entry for the tier.

logbook:
  composition:
    provider: {{ default_provider }}
    default_tier: haiku   # Options: haiku | sonnet | opus

# ============================================================
# AGENT DATA & ARTIFACT GALLERY
# ============================================================
# Resolved relative to `project_root` above — the deployment repo's root, not
# this file's directory. It belongs under var/, the durable STATE zone: build/
# is wiped and re-rendered by every build, and the repo's .gitignore keeps var/
# out of git. A path outside var/ would land the agent's memory in the tracked
# source zone and dirty `git status` on first run.

agent_data:
  base_dir: "var/agent_data"

# Subdirectory names within the agent data directory above. A subdirectory key
# absent from this block falls back to the key's own name, so without it the
# registry export lands in `<agent_data.base_dir>/registry_exports_dir/`.
file_paths:
  api_calls_dir: api_calls
  registry_exports_dir: registry_exports

# osprey:panel-port artifact
# WORKSPACE tab. Universal: under `osprey web` it is launched at startup
# whatever panels are listed under `web:` below (headless runs instead start it
# on the first artifact save), so `auto_launch: false` is the only thing that
# stops it — and when it does, the tab is reported unavailable rather than
# serving a dead iframe. Port resolution is the one shared function every launcher and URL
# builder uses: OSPREY_ARTIFACT_SERVER_PORT wins (multi-user deployments export
# it per user), then `port` here, then the built-in 8086. `host` has no env
# override.
artifact_server:
  host: "127.0.0.1"
  port: 8086
  auto_launch: true

# ============================================================
# CLAUDE CODE INTEGRATION
# ============================================================
# In this preset, Claude Code is configured as the logbook-research
# assistant: ARIEL MCP server + workspace MCP server + the
# logbook-deep-research subagent. No control-system MCP servers.

claude_code:
  # Disable the control-system and python-executor MCP servers — this is an
  # ARIEL-only deployment, no hardware writes, no in-process Python sandbox.
  # osprey_workspace and ariel stay enabled (osprey_workspace is required
  # by the logbook-deep-research subagent for artifact handoff).
  servers:
    controls:
      enabled: false
    python:
      enabled: false

  provider: {{ default_provider }}
  default_model: {{ default_model | default("haiku") }}   # Options: haiku, sonnet, opus
  #
  # Override model IDs per tier (optional):
  # models:
  #   haiku: anthropic/claude-haiku-alt
  #
  # Override model tier per agent (optional):
  # agent_models:
  #   logbook-deep-research: sonnet

  # ── Telemetry / Observability (on by default, local + loopback-bound) ──
  # The agent emits OTLP logs + metrics to the co-deployed OpenObserve store
  # (declared in `services:` and listed in `deployed_services:` above; UI at
  # http://localhost:5080). On by default: the underlying harness already records
  # every prompt, response, and API body to disk, so this adds no new exposure —
  # it just makes that data queryable in a local store you own. To turn it off,
  # set `enabled: false`. Tracing and OTEL_LOG_TOOL_CONTENT are intentionally
  # NOT wired. See docs/how-to/monitor-agent.rst.
  telemetry:
    enabled: true                        # Master switch
    backend: openobserve                 # openobserve | generic
    protocol: http/protobuf              # http/protobuf | grpc — grpc requires an explicit `endpoint:` below; it is refused against the auto-derived openobserve endpoint (HTTP only)
    # backend: openobserve auto-derives the endpoint per network context —
    # http://localhost:5080/api/<org> on the host, http://openobserve:5080/api/<org>
    # inside the deploy network — so `endpoint` is intentionally OMITTED here.
    # (Hardcoding localhost would make the in-container dispatch worker emit to
    # its own loopback and silently drop everything.)
    #
    # OpenObserve auth + org routing. These are the store's dedicated INGEST
    # account, not its root credentials: `osprey up` creates a service account
    # named ZO_INGEST_USER_EMAIL and writes the token the store issues for it
    # to the project .env as ZO_INGEST_SA_TOKEN. The store itself still
    # initializes from ZO_ROOT_USER_* — that stays in the compose file, and the
    # root password never reaches the agent's config.
    # The token reference carries NO ${VAR:-default} on purpose: a literal
    # default would be a published credential, and there is nothing to fall
    # back to before the first deploy provisions the account.
    openobserve:
      user: ${ZO_INGEST_USER_EMAIL:-ingest@example.com}
      password: ${ZO_INGEST_SA_TOKEN}
      org: default
    # Content gates — all default ON. The store is local and loopback-bound, so
    # full capture is the default posture; set any to false to suppress that
    # category. (If you rebind the store off localhost, change the default
    # password first — these records include raw API bodies.)
    log_user_prompts: true               # Operator chat prompts
    log_assistant_responses: true        # Agent replies
    log_tool_details: true               # Tool names + arguments
    log_raw_api_bodies: true             # Raw provider request/response bodies

# ============================================================
# WEB PANEL CONFIGURATION
# ============================================================
# Controls the web terminal UI (osprey web): its Documentation and Feedback
# controls, and which panel tabs appear. The Workspace panel is always shown;
# the Activity log is a separate page, not a tab.

web:
  # Target of the Documentation button in the web terminal's utility cluster.
  # Point it at a locally hosted copy of the docs when the control room has no
  # route to the public site.
  docs_url: https://als-apg.github.io/osprey

  # Whether the web terminal's Config panel may edit this deployment's own
  # config.yml and .claude/ setup files. `false` withdraws the panel's whole
  # SERVER surface, not just its tab: /api/config and /api/claude-setup refuse
  # every verb with 403, and GET /api/panels stops advertising the panel. That
  # is the difference that matters — these files are what the agent's
  # permission surface is rendered from, so hiding the tab alone would leave
  # anyone who types the URL able to re-render the agent that runs here.
  # Leave it true for a single-user deployment: the panel is that operator's
  # own config editor. Set it false for the read-only tiers of a multi-user
  # deployment, where a separate admin persona owns configuration.
  config_panel:
    enabled: true

  # Whether this deployment's Scaffold gallery may WRITE. `false` closes the
  # gallery's whole server surface for writes — create, claim, save, reset,
  # register and delete all answer 403 — while every read stays open, so a
  # read-only tier can still see exactly what the agent is running. This is a
  # privilege boundary, not a UI preference: what the gallery authors is
  # .claude/rules, .claude/skills and .claude/agents content, which the agent
  # loads at project scope and obeys on every turn. Hiding the buttons alone
  # would leave anyone who types the URL able to author what the agent reads.
  # Leave it true for a single-user deployment: the gallery is that operator's
  # own editor. Set it false for the read-only tiers of a multi-user
  # deployment, where a separate admin persona owns the agent's setup.
  scaffold_gallery:
    write_enabled: true

  # Where the Feedback dialog's two outbound channels send a user. Nothing is
  # ever posted for them: the browser opens a prefilled GitHub issue form or a
  # prefilled mail draft, and the user decides whether to send it. Every
  # submission is also recorded on this deployment, readable with
  # `osprey feedback list` / `osprey feedback export`.
  feedback:
    # owner/repo whose new-issue form the GitHub channel prefills. Point it at
    # the repository your users' reports should land in.
    github_repo: als-apg/osprey
    # Recipient of the prefilled mailto: draft the Email channel opens.
    email: thellert@lbl.gov
    # Ceiling in bytes on the on-disk feedback store (256 MB). Above it the
    # OLDEST saved session contexts are deleted; the small submission headers
    # are always kept, so the submission history stays complete.
    max_store_bytes: 268435456
{%- set _BUILTIN_PANELS = builtin_panels | default(["ariel", "channel-finder"]) %}
{%- set _enabled_builtin_panels = selected_web_panels | select("in", _BUILTIN_PANELS) | list %}
{%- if default_panel is defined and default_panel %}
  # Tab focused on cold load. Falls back to "artifacts" (Workspace) when unset.
  default_panel: {{ default_panel }}
{%- endif %}
{%- if _enabled_builtin_panels %}
  panels:
{%- for panel in _enabled_builtin_panels %}
    {{ panel }}:
      enabled: true
{%- endfor %}
{%- else %}
  panels: {}
{%- endif %}
{%- if panel_presets is defined and panel_presets %}
  # Panel layouts ("Layouts"): named sets of panels a human applies in one click
  # from the web terminal "+" popover. The key is the menu label; the value is
  # the exact set of panels to show (non-member panels close).
  presets:
{%- for preset_name, preset_panels in panel_presets.items() %}
    {{ preset_name | tojson }}: [{{ preset_panels | join(", ") }}]
{%- endfor %}
{%- endif %}
  # Optional panel controls (off by default; uncomment to use). These are
  # nested keys under `web:` — config.yml is never flattened, so a dotted
  # key like `web.allow_runtime_panels` written here is stored verbatim and
  # read by nothing. The dotted spelling belongs only in a build profile's
  # `config:` block, which is expanded into nested YAML at build time.
  # panels:
  #   <id>:
  #     hidden: true                          # launch the panel but keep its tab hidden until shown
  # allow_runtime_panels: true                # let the agent register ad-hoc URL panels at runtime
  # runtime_panel_allowlist: ["dashboard.local:3000"]  # restrict registration targets to these host[:port]
  # presets:                                  # named "Layouts" a human applies from the "+" popover
  #   "Logbook review": [ariel, artifacts]

