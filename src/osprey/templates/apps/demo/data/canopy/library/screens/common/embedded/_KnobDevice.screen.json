{
  "schemaVersion": "1.1",
  "kind": "screen",
  "id": "common/embedded/_KnobDevice",
  "metadata": {
    "title": "_KnobDevice",
    "source": {
      "type": "bob-converter"
    },
    "size": {
      "width": 81,
      "height": 70
    }
  },
  "macros": [
    {
      "name": "CNTL_PV",
      "default": ""
    },
    {
      "name": "COLOR_CODE",
      "default": ""
    },
    {
      "name": "COLOR_PV",
      "default": ""
    },
    {
      "name": "DESC",
      "default": ""
    },
    {
      "name": "MON_PV",
      "default": ""
    }
  ],
  "root": {
    "id": "w-001",
    "type": "absolute-canvas",
    "props": {
      "width": 81,
      "height": 70,
      "backgroundColor": {
        "$role": "Transparent",
        "fallback": "#ffffff00"
      }
    },
    "geometry": {
      "x": 0,
      "y": 0,
      "width": 81,
      "height": 70
    },
    "children": [
      {
        "id": "w-002",
        "type": "group",
        "props": {
          "layoutMode": "absolute"
        },
        "geometry": {
          "x": 0,
          "y": 0,
          "width": 72,
          "height": 62
        },
        "children": [
          {
            "id": "w-trigger",
            "type": "pv-label",
            "props": {
              "pv": "loc://testtriggercolorcode?type=int&init=1",
              "precision": 0
            },
            "geometry": {
              "x": 0,
              "y": 0,
              "width": 0,
              "height": 0
            }
          },
          {
            "id": "w-tile",
            "type": "rectangle",
            "props": {
              "lineColor": {
                "$role": "Grid",
                "fallback": "#d8d9da",
                "fallbackDark": "#2c3235"
              },
              "lineWidth": 1,
              "fill": true,
              "fillColor": {
                "$role": "Tile_Background",
                "fallback": "#ffffff",
                "fallbackDark": "#22252b"
              },
              "cornerRadius": 5
            },
            "geometry": {
              "x": 0,
              "y": 0,
              "width": 72,
              "height": 62
            },
            "rules": [
              {
                "id": "r-off-frame",
                "name": "Supply off frame",
                "targetProperty": "lineColor",
                "pvs": [
                  {
                    "name": "${COLOR_PV}",
                    "trigger": true
                  }
                ],
                "conditions": [
                  {
                    "expression": "{0} == 0",
                    "value": {
                      "$role": "STOP",
                      "fallback": "#c4162a",
                      "fallbackDark": "#e05454"
                    }
                  }
                ],
                "default": {
                  "$role": "Grid",
                  "fallback": "#d8d9da",
                  "fallbackDark": "#2c3235"
                }
              },
              {
                "id": "r-off-width",
                "name": "Supply off frame width",
                "targetProperty": "lineWidth",
                "pvs": [
                  {
                    "name": "${COLOR_PV}",
                    "trigger": true
                  }
                ],
                "conditions": [
                  {
                    "expression": "{0} == 0",
                    "value": 2
                  }
                ],
                "default": 1
              }
            ]
          },
          {
            "id": "w-stripe",
            "type": "rectangle",
            "props": {
              "lineColor": {
                "$role": "Transparent",
                "fallback": "#ffffff00"
              },
              "lineWidth": 0,
              "fill": true,
              "fillColor": {
                "$role": "Family_Other",
                "fallback": "#6e6e77",
                "fallbackDark": "#8e8e9a"
              },
              "cornerRadius": 2
            },
            "geometry": {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 62
            },
            "rules": [
              {
                "id": "r-family",
                "name": "Family colour",
                "targetProperty": "fillColor",
                "pvs": [
                  {
                    "name": "loc://testtriggercolorcode",
                    "trigger": true
                  }
                ],
                "conditions": [
                  {
                    "expression": "${COLOR_CODE} == 0",
                    "value": {
                      "$role": "Family_VCM",
                      "fallback": "#1a9fb0",
                      "fallbackDark": "#4cc3d4"
                    }
                  },
                  {
                    "expression": "${COLOR_CODE} == 1",
                    "value": {
                      "$role": "Family_Other",
                      "fallback": "#6e6e77",
                      "fallbackDark": "#8e8e9a"
                    }
                  },
                  {
                    "expression": "${COLOR_CODE} == 2",
                    "value": {
                      "$role": "Family_HCM",
                      "fallback": "#6f4fc2",
                      "fallbackDark": "#9d82e6"
                    }
                  },
                  {
                    "expression": "${COLOR_CODE} == 3",
                    "value": {
                      "$role": "Family_Quad",
                      "fallback": "#2f62c4",
                      "fallbackDark": "#7b9cff"
                    }
                  },
                  {
                    "expression": "${COLOR_CODE} == 4",
                    "value": {
                      "$role": "Family_Septum",
                      "fallback": "#8b8f99",
                      "fallbackDark": "#a7abb5"
                    }
                  },
                  {
                    "expression": "${COLOR_CODE} == 5",
                    "value": {
                      "$role": "Family_Dipole",
                      "fallback": "#d9822b",
                      "fallbackDark": "#f0a252"
                    }
                  }
                ],
                "default": {
                  "$role": "Family_Other",
                  "fallback": "#6e6e77",
                  "fallbackDark": "#8e8e9a"
                }
              }
            ]
          },
          {
            "id": "w-caption",
            "type": "text-label",
            "props": {
              "text": "${DESC}",
              "align": "left",
              "foregroundColor": {
                "$role": "Text_Muted",
                "fallback": "#6e6e77",
                "fallbackDark": "#8e8e9a"
              },
              "fontSize": 10
            },
            "geometry": {
              "x": 8,
              "y": 2,
              "width": 60,
              "height": 14
            }
          },
          {
            "id": "w-off",
            "type": "text-label",
            "props": {
              "text": "OFF",
              "align": "right",
              "foregroundColor": {
                "$role": "STOP",
                "fallback": "#c4162a",
                "fallbackDark": "#e05454"
              },
              "fontSize": 9
            },
            "geometry": {
              "x": 44,
              "y": 2,
              "width": 24,
              "height": 14
            },
            "rules": [
              {
                "id": "r-off-badge",
                "name": "Show OFF",
                "targetProperty": "visible",
                "pvs": [
                  {
                    "name": "${COLOR_PV}",
                    "trigger": true
                  }
                ],
                "conditions": [
                  {
                    "expression": "{0} == 0",
                    "value": true
                  }
                ],
                "default": false
              }
            ]
          },
          {
            "id": "w-sp",
            "type": "pv-text-input",
            "props": {
              "pv": "${CNTL_PV}",
              "kind": "number",
              "writeOnEnter": true,
              "fontSize": 11.5,
              "align": "right",
              "precision": 3,
              "precisionFromPV": false
            },
            "geometry": {
              "x": 5,
              "y": 17,
              "width": 64,
              "height": 21
            }
          },
          {
            "id": "w-rb",
            "type": "pv-label",
            "props": {
              "pv": "${MON_PV}",
              "precision": 3,
              "precisionFromPV": false,
              "showUnits": false,
              "foregroundColor": {
                "$role": "Text_Muted",
                "fallback": "#6e6e77",
                "fallbackDark": "#8e8e9a"
              },
              "backgroundColor": {
                "$role": "Transparent",
                "fallback": "#ffffff00"
              },
              "fontSize": 11.5,
              "align": "right"
            },
            "geometry": {
              "x": 5,
              "y": 40,
              "width": 60,
              "height": 19
            },
            "rules": [
              {
                "id": "r-rb",
                "name": "Readback state",
                "targetProperty": "foregroundColor",
                "pvs": [
                  {
                    "name": "${CNTL_PV}",
                    "trigger": true
                  },
                  {
                    "name": "${MON_PV}",
                    "trigger": true
                  },
                  {
                    "name": "${COLOR_PV}",
                    "trigger": true
                  }
                ],
                "conditions": [
                  {
                    "expression": "{2} == 0",
                    "value": {
                      "$role": "STOP",
                      "fallback": "#c4162a",
                      "fallbackDark": "#e05454"
                    }
                  },
                  {
                    "expression": "({0} - {1}) * ({0} - {1}) > (0.005 * {0}) * (0.005 * {0}) + 0.0004",
                    "value": {
                      "$role": "Attention",
                      "fallback": "#b5710d",
                      "fallbackDark": "#f5b73d"
                    }
                  }
                ],
                "default": {
                  "$role": "Text_Muted",
                  "fallback": "#6e6e77",
                  "fallbackDark": "#8e8e9a"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
