              "offLabel": "TV",
              "buttonType": "toggle",
              "onColor": {
                "$role": "Selected_Tint",
                "fallback": "#dbe7fb",
                "fallbackDark": "#22385e"
              },
              "offColor": {
                "$role": "Button_Background",
                "fallback": "#ecedef",
                "fallbackDark": "#2c3235"
              },
              "foregroundColor": {
                "$role": "Text",
                "fallback": "#24292e",
                "fallbackDark": "#ccccdc"
              },
              "fontSize": 10
            },
            "geometry": {
              "x": 1,
              "y": 23,
              "width": 28,
              "height": 24
            },
            "meta": {
              "comment": "Phoebus script [EmbeddedPy] pvs=[$(loctv), $(paddle_in), $(light_on)]\nfrom org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil\n\nvalue = PVUtil.getDouble(pvs[0])\nif value == 1:\n\tpvs[1].write(1)\n\tpvs[2].write(1)\nelif value == 0:\n\tpvs[1].write(0)\n\tpvs[2].write(0)"
            },
            "warnings": [
              "Boolean Button_6: script needs the script runtime (tier 2): value = PVUtil.getDouble(pvs[0])"
            ]
          },
          {
            "id": "w-005",
            "type": "pv-button",
            "props": {
              "pv": "${paddle}",
              "readbackPV": "${paddle_rb}",
              "onLabel": "IN",
              "offLabel": "OUT",
              "buttonType": "toggle",
              "onColor": {
                "$role": "Attention_Tint",
                "fallback": "#fbe7c6",
                "fallbackDark": "#4a3a14"
              },
              "offColor": {
                "$role": "Button_Background",
                "fallback": "#ecedef",
                "fallbackDark": "#2c3235"
              },
              "foregroundColor": {
                "$role": "Text",
                "fallback": "#24292e",
                "fallbackDark": "#ccccdc"
              },
              "fontSize": 10
            },
            "geometry": {
              "x": 1,
              "y": 53,
              "width": 28,
              "height": 24
            }
          },
          {
            "id": "w-006",
            "type": "pv-led",
            "props": {
              "pv": "${light}",
