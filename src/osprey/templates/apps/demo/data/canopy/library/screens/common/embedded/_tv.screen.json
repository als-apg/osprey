{
  "schemaVersion": "1.1",
  "kind": "screen",
  "id": "common/embedded/_tv",
  "metadata": {
    "title": "_tv",
    "source": {
      "type": "bob-converter"
    },
    "size": {
      "width": 800,
      "height": 600
    }
  },
  "macros": [
    {
      "name": "TV",
      "default": ""
    },
    {
      "name": "light",
      "default": ""
    },
    {
      "name": "loctv",
      "default": ""
    },
    {
      "name": "paddle",
      "default": ""
    },
    {
      "name": "paddle_rb",
      "default": ""
    }
  ],
  "root": {
    "id": "w-001",
    "type": "absolute-canvas",
    "props": {
      "width": 800,
      "height": 600,
      "backgroundColor": {
        "$role": "Display_Background",
        "fallback": "#ffffff"
      }
    },
    "geometry": {
      "x": 0,
      "y": 0,
      "width": 800,
      "height": 600
    },
    "children": [
      {
        "id": "w-002",
        "type": "group",
        "props": {
          "layoutMode": "absolute"
        },
        "geometry": {
          "x": 0,
          "y": 0,
          "width": 30,
          "height": 110
        },
        "children": [
          {
            "id": "w-003",
            "type": "text-label",
            "props": {
              "text": "${TV}",
              "align": "center",
              "foregroundColor": {
                "$role": "Text",
                "fallback": "#000000"
              },
              "fontSize": 8
            },
            "geometry": {
              "x": 0,
              "y": 0,
              "width": 30,
              "height": 20
            }
          },
          {
            "id": "w-004",
            "type": "pv-button",
            "props": {
              "pv": "${loctv}",
              "readbackPV": "${loctv}",
              "onLabel": "",
              "offLabel": "",
              "buttonType": "toggle",
              "onColor": {
                "$role": "Background",
                "fallback": "#ffffff"
              },
              "offColor": {
                "$role": "Background",
                "fallback": "#ffffff"
              },
              "onImage": "../images/TV on.jpg",
              "offImage": "../images/TV off.jpg"
            },
            "geometry": {
              "x": 0,
              "y": 20,
              "width": 30,
              "height": 30
            },
            "meta": {
              "comment": "Phoebus script [EmbeddedPy] pvs=[$(loctv), $(paddle_in), $(light_on)]\nfrom org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil\n\nvalue = PVUtil.getDouble(pvs[0])\nif value == 1:\n\tpvs[1].write(1)\n\tpvs[2].write(1)\nelif value == 0:\n\tpvs[1].write(0)\n\tpvs[2].write(0)"
            },
            "warnings": [
              "Boolean Button_6: script needs the script runtime (tier 2): value = PVUtil.getDouble(pvs[0])"
            ]
          },
          {
            "id": "w-005",
            "type": "pv-button",
            "props": {
              "pv": "${paddle}",
              "readbackPV": "${paddle_rb}",
              "onLabel": "",
              "offLabel": "",
              "buttonType": "toggle",
              "onColor": {
                "$role": "Background",
                "fallback": "#ffffff"
              },
              "offColor": {
                "$role": "Background",
                "fallback": "#ffffff"
              },
              "onImage": "../images/Paddle in.jpg",
              "offImage": "../images/Paddle out.jpg"
            },
            "geometry": {
              "x": 0,
              "y": 50,
              "width": 30,
              "height": 30
            }
          },
          {
            "id": "w-006",
            "type": "pv-led",
            "props": {
              "pv": "${light}",
              "onColor": "#ffff00",
              "offColor": {
                "$role": "Background",
                "fallback": "#808080"
              }
            },
            "geometry": {
              "x": 0,
              "y": 80,
              "width": 30,
              "height": 30
            }
          }
        ]
      }
    ]
  }
}
