{
  "schemaVersion": "1.1",
  "kind": "screen",
  "id": "common/embedded/_tv",
  "metadata": {
    "title": "_tv",
    "source": {
      "type": "bob-converter"
    },
    "size": {
      "width": 800,
      "height": 600
    }
  },
  "macros": [
    {
      "name": "TV",
      "default": ""
    },
    {
      "name": "light",
      "default": ""
    },
    {
      "name": "loctv",
      "default": ""
    },
    {
      "name": "paddle",
      "default": ""
    },
    {
      "name": "paddle_rb",
      "default": ""
    }
  ],
  "root": {
    "id": "w-001",
    "type": "absolute-canvas",
    "props": {
      "width": 800,
      "height": 600,
      "backgroundColor": {
        "$role": "Transparent",
        "fallback": "#ffffff00"
      }
    },
    "geometry": {
      "x": 0,
      "y": 0,
      "width": 800,
      "height": 600
    },
    "children": [
      {
        "id": "w-002",
        "type": "group",
        "props": {
          "layoutMode": "absolute"
        },
        "geometry": {
          "x": 0,
          "y": 0,
          "width": 30,
          "height": 110
        },
        "children": [
          {
            "id": "w-003",
            "type": "text-label",
            "props": {
              "text": "${TV}",
              "align": "center",
              "foregroundColor": {
                "$role": "Text_Muted",
                "fallback": "#6e6e77",
                "fallbackDark": "#8e8e9a"
