              "offColor": {
                "$role": "Off",
                "fallback": "#c6c7cc",
                "fallbackDark": "#3a3f45"
              }
            },
            "geometry": {
              "x": 8,
              "y": 86,
              "width": 14,
              "height": 14
            }
          }
        ]
