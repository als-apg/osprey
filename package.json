{
  "name": "osprey-frontend-devtools",
  "description": "Dev-only JS toolchain (typecheck + tests) for OSPREY web interfaces. Not part of the Python wheel.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "happy-dom": "^20.14.5",
    "eslint": "^10",
    "@eslint/js": "^10",
    "globals": "^17"
  }
}
