{
  "name": "osprey-frontend-devtools",
  "description": "Dev-only JS toolchain (typecheck + tests) for OSPREY web interfaces. Not part of the Python wheel.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs}\""
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "happy-dom": "^21.0.4",
    "eslint": "^10",
    "@eslint/js": "^10",
    "globals": "^17",
    "marked": "12.0.2",
    "dompurify": "3.4.17",
    "dockview-core": "7.0.2",
    "jsdom": "^31.0.0",
    "prettier": "3.9.10"
  }
}
