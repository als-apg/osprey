{
  "name": "osprey-frontend-devtools",
  "description": "Dev-only JS toolchain (typecheck + tests) for OSPREY web interfaces. Not part of the Python wheel.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc --noEmit -p packages/dock-engine",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs}\"",
    "build:dock-engine": "node packages/dock-engine/scripts/build.mjs",
    "check:dock-engine": "node packages/dock-engine/scripts/build.mjs --check",
    "test:dock-engine": "vitest run -c packages/dock-engine/vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "happy-dom": "^20.14.5",
    "eslint": "^10",
    "@eslint/js": "^10",
    "globals": "^17",
    "marked": "12.0.2",
    "dompurify": "3.4.16",
    "jsdom": "^30.1.2",
    "vite": "8.3.2",
    "typescript-6": "npm:typescript@6.0.3",
    "@types/node": "26.1.0",
    "prettier": "3.9.9"
  }
}
