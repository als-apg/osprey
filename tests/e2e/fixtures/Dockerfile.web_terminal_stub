# Throwaway stand-in for the real ``<registry_url>/web-terminal:latest`` image
# (src/osprey/templates/modules/web_terminals/docker-compose.web.yml.j2), used
# ONLY by tests/e2e/test_deploy_lifecycle.py to exercise lifecycle MECHANICS
# (up/idempotency, `osprey users seed/passwd/remove/prune`, `osprey reset`)
# against a real container runtime. It never runs the actual osprey web app —
# it just needs to (a) stay running and pass the per-user service's healthcheck
# (`curl -fsS http://<bind>:<port>/health`), which `osprey up` waits on before
# it reports the stack started, and (b) satisfy what seeding.py's container-side
# reconcile scripts depend on: a "dispatch" user (chown target) and the two
# mount-point directories the per-user compose service declares volumes onto.
#
# The paths below are the directory of the project the fixture's catalog
# names for its default persona (/app/osprey-e2e-mus-p3-assistant/...) — see
# multi_user_config.yml. If that project ever changes, these paths must change
# with it.
#
# `var/agent_data` must name the same directory as config.yml's
# `agent_data.base_dir` (the fixture config declares none, so it is the default
# `var/agent_data`), exactly as the shipped project Dockerfile does: the
# per-user agent-data volume mounts THERE — render.py derives the mount target
# from that key — and a directory the image never created is created root-owned
# at first start, which the non-root user below then cannot write to.
FROM alpine:3.20

# busybox-extras carries the httpd applet (the base busybox does not); curl is
# what the healthcheck runs.
RUN apk add --no-cache busybox-extras curl \
    && adduser -D dispatch \
    && mkdir -p /data/claude-config \
    && mkdir -p /app/osprey-e2e-mus-p3-assistant/var/agent_data \
    && mkdir -p /app/osprey-e2e-mus-p3-assistant/.claude/skills \
    && chown -R dispatch:dispatch /data/claude-config /app/osprey-e2e-mus-p3-assistant \
    && mkdir -p /srv \
    && echo ok > /srv/health

# Serves /srv/health on the address and port compose hands each user's
# container. seeding.py execs into this container as root (-u 0), so the
# process's own uid doesn't matter here.
CMD ["sh", "-c", "exec httpd -f -p \"${OSPREY_TERMINAL_BIND_HOST:-127.0.0.1}:${OSPREY_TERMINAL_WEB_PORT}\" -h /srv"]
