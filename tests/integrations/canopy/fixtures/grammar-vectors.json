  "pointers": [
    {
      "name": "c0 in a nested child",
      "class": "c0",
      "doc": {
        "root": {
          "children": [
            {
              "type": "label",
              "text": "ok"
            },
            {
              "type": "label",
              "text": "a\u0007b"
            }
          ]
        }
      },
      "pointer": "/root/children/1/text"
    },
    {
      "name": "del in a pv name",
      "class": "del",
      "doc": {
        "root": {
          "pv": "SR:\u007fCURRENT"
        }
      },
      "pointer": "/root/pv"
    },
    {
      "name": "c1 in a rule value",
      "class": "c1",
      "doc": {
        "root": {
          "rules": [
            {
              "conditions": [
                {
                  "value": "x"
                },
                {
                  "value": "\u009b31m"
                }
              ]
            }
          ]
        }
      },
      "pointer": "/root/rules/0/conditions/1/value"
    },
    {
      "name": "bidi override in the title",
      "class": "bidi",
      "doc": {
        "metadata": {
          "title": "abc\u202edef"
        },
        "root": {}
      },
      "pointer": "/metadata/title"
    },
    {
      "name": "zero-width space in a name",
      "class": "format",
      "doc": {
        "root": {
          "name": "a\u200bb"
        }
      },
      "pointer": "/root/name"
    },
    {
      "name": "lone surrogate in a text",
      "class": "surrogate",
      "doc": {
        "root": {
          "children": [
            {
              "text": "\ud800"
            }
          ]
        }
      },
      "pointer": "/root/children/0/text"
    },
    {
      "name": "the first of two in member order",
      "class": "c0",
      "doc": {
        "a": "ok",
        "b": "\u0000",
        "c": "\u0000"
      },
      "pointer": "/b"
    },
    {
      "name": "depth first: a nested string precedes a later sibling",
      "class": "c0",
      "doc": {
        "a": {
          "z": [
            "ok",
            "\u0001"
          ]
        },
        "b": "\u0001"
      },
      "pointer": "/a/z/1"
    },
    {
      "name": "an offending key reports the object that holds it",
      "class": "c0",
      "doc": {
        "root": {
          "ok": 1,
          "bad\u0000key": "x"
        }
      },
      "pointer": "/root"
    },
    {
      "name": "a key is read before its own value and after earlier members",
      "class": "bidi",
      "doc": {
        "a": {
          "b": "ok"
        },
        "k\u200f": "\u0001"
      },
      "pointer": ""
    },
    {
      "name": "an earlier value precedes a later offending key",
      "class": "c0",
      "doc": {
        "a": "\u0001",
        "k\u200f": "x"
      },
      "pointer": "/a"
    },
    {
      "name": "tilde and slash in keys are escaped",
      "class": "c0",
      "doc": {
        "a/b": {
          "c~d": [
            "x",
            "\u0001"
          ]
        }
      },
      "pointer": "/a~1b/c~0d/1"
    },
    {
      "name": "an empty key",
      "class": "c0",
      "doc": {
        "": "\u0001"
      },
      "pointer": "/"
    },
    {
      "name": "a root string",
      "class": "c1",
      "doc": "\u0085",
      "pointer": ""
    },
    {
      "name": "a root list",
      "class": "bidi",
      "doc": [
        "a",
        [
          "b",
          "\u200f"
        ]
      ],
      "pointer": "/1/1"
    },
    {
      "name": "a clean document",
      "class": null,
      "doc": {
        "metadata": {
          "title": "Tab\there, line\nbreak\r\n, caf\u00e9 \ud83d\ude00 \u2028"
        },
        "root": {
          "x": 1,
          "y": 2.5,
          "on": true,
          "none": null,
          "children": []
        }
      },
      "pointer": null
    },
    {
      "name": "an empty document",
      "class": null,
      "doc": {},
      "pointer": null
    }
  ],
  "casefold": [
    {
      "name": "no collision",
      "paths": [
        "a/x.screen.json",
        "a/y.png",
        "b/x.screen.json",
        "b/X2.png"
      ],
      "collisions": []
    },
    {
      "name": "no paths",
      "paths": [],
      "collisions": []
    },
    {
      "name": "the same name in two directories",
      "paths": [
        "a/x.png",
        "b/X.png"
      ],
      "collisions": []
    },
    {
      "name": "a repeated path is one member",
      "paths": [
        "a/x.png",
        "a/x.png"
      ],
      "collisions": []
    },
    {
      "name": "a file pair",
      "paths": [
