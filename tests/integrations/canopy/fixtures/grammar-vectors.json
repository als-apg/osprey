          "IMG",
          "img"
        ]
      ]
    },
    {
      "name": "a nested directory pair",
      "paths": [
        "a/Sub/x.png",
        "a/sub/y.png"
      ],
      "collisions": [
        [
          "a/Sub",
          "a/sub"
        ]
      ]
    },
    {
      "name": "a directory pair and the file pair under it",
      "paths": [
        "A/x.png",
        "a/X.png"
      ],
      "collisions": [
        [
          "A",
          "a"
        ],
        [
          "A/x.png",
          "a/X.png"
        ]
      ]
    },
    {
      "name": "a file against a directory in another case",
      "paths": [
        "Lib",
        "lib/x.png"
      ],
      "collisions": [
        [
          "Lib",
          "lib"
        ]
      ]
    },
    {
      "name": "a path that is both a member and a directory",
      "paths": [
        "lib",
        "lib/x.png"
      ],
      "collisions": [
        [
          "lib"
        ]
      ]
    },
    {
      "name": "three spellings",
      "paths": [
        "Ab",
        "aB",
        "AB",
        "c"
      ],
      "collisions": [
        [
          "AB",
          "Ab",
          "aB"
        ]
      ]
    },
    {
      "name": "casefold, not lower",
      "paths": [
        "stra\u00dfe.png",
        "STRASSE.png"
      ],
      "collisions": [
        [
          "STRASSE.png",
          "stra\u00dfe.png"
        ]
      ]
    }
  ]
}
