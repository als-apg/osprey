      "code": "name = 'control_context.json'\nprint(name)\n",
      "policy": "selective", "enabled": true, "execution_mode": "readwrite",
      "dispatch": false, "switch": "on", "expected": "ask"
    },
    {
      "id": "tool-name-false-positive-pinned",
