<clickhouse>
    <logger>
        <level>warning</level>
    </logger>
    <mark_cache_size>536870912</mark_cache_size>
    <!-- The server's own memory cap, a share of the container's limit. -->
    <max_server_memory_usage_to_ram_ratio>0.9</max_server_memory_usage_to_ram_ratio>
    <!-- The hard ceiling only: the readers' pool plus two spare slots for the
         archive and the reconcile. The pool itself is the `readers` workload. -->
    <max_concurrent_select_queries>4</max_concurrent_select_queries>
    <query_cache>
        <max_size_in_bytes>0</max_size_in_bytes>
    </query_cache>
    <query_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <metric_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </part_log>
    <asynchronous_insert_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </asynchronous_insert_log>
    <access_control_improvements>
        <!-- Pinned, not inherited: the archive, the all-users view and every
             reader with a RESTRICTIVE-only policy read rows because of it. -->
        <users_without_row_policies_can_read_rows>true</users_without_row_policies_can_read_rows>
        <select_from_system_db_requires_grant>true</select_from_system_db_requires_grant>
    </access_control_improvements>
    <!-- A user created without IDENTIFIED can never exist. -->
    <allow_implicit_no_password>0</allow_implicit_no_password>
</clickhouse>