{
  "name": "reopen-tabs-group-restores-showing",
  "rule": "rule-15",
  "before": {
    "split": "row",
    "items": [
      {
        "tile": "t1",
        "tabs": ["a"],
        "showing": "a",
        "size": 0.5
      },
      {
        "tile": "t2",
        "tabs": ["b", "e"],
        "showing": "e",
        "size": 0.3
      },
      {
        "tile": "t3",
        "tabs": ["c"],
        "showing": "c",
        "size": 0.2
      }
    ]
  },
  "op": {
    "fn": "reopen",
    "record": {
      "kind": "tabs",
      "records": [
        {
          "kind": "tab",
          "key": "f",
          "tile": "t2",
          "index": 2,
          "showing": false
        },
        {
          "kind": "tab",
          "key": "g",
          "tile": "t2",
          "index": 3,
          "showing": true
        }
      ]
    },
    "context": {
      "focusedTile": "t3",
      "dock": {
        "px": {
          "width": 1000,
          "height": 600
        },
        "minPx": 40
      }
    }
  },
  "after": {
    "split": "row",
    "items": [
      {
        "tile": "t1",
        "tabs": ["a"],
        "showing": "a",
        "size": 0.5
      },
      {
        "tile": "t2",
        "tabs": ["b", "e", "f", "g"],
        "showing": "g",
        "size": 0.3
      },
      {
        "tile": "t3",
        "tabs": ["c"],
        "showing": "c",
        "size": 0.2
      }
    ]
  }
}
