{
  "name": "reopen-tile-share-clamped-by-neighbour",
  "rule": "rule-8",
  "before": {
    "split": "row",
    "items": [
      {
        "tile": "t1",
        "tabs": ["a"],
        "showing": "a",
        "size": 0.1
      },
      {
        "tile": "t3",
        "tabs": ["c"],
        "showing": "c",
        "size": 0.9
      }
    ]
  },
  "op": {
    "fn": "reopen",
    "record": {
      "kind": "tile",
      "tile": "t2",
      "tabs": ["b"],
      "showing": "b",
      "neighbour": "t1",
      "side": "right",
      "share": 0.7
    },
    "context": {
      "focusedTile": "t3",
      "dock": {
        "px": {
          "width": 1000,
          "height": 600
        },
        "minPx": 40
      }
    }
  },
  "after": {
    "split": "row",
    "items": [
      {
        "tile": "t1",
        "tabs": ["a"],
        "showing": "a",
        "size": 0.04
      },
      {
        "tile": "t2",
        "tabs": ["b"],
        "showing": "b",
        "size": 0.06,
        "from": "t1"
      },
      {
        "tile": "t3",
        "tabs": ["c"],
        "showing": "c",
        "size": 0.9
      }
    ]
  }
}
