{
  "name": "close-last-tab-removes-tile",
  "rule": "rule-8",
  "before": {
    "split": "row",
    "items": [
      {
        "tile": "t1",
        "tabs": ["a"],
        "showing": "a",
        "size": 0.5
      },
      {
        "tile": "t2",
        "tabs": ["b"],
        "showing": "b",
        "size": 0.3
      },
      {
        "tile": "t3",
        "tabs": ["c"],
        "showing": "c",
        "size": 0.2
      }
    ]
  },
  "op": {
    "fn": "closeTab",
    "key": "b"
  },
  "after": {
    "split": "row",
    "items": [
      {
        "tile": "t1",
        "tabs": ["a"],
        "showing": "a",
        "size": 0.8
      },
      {
        "tile": "t3",
        "tabs": ["c"],
        "showing": "c",
        "size": 0.2
      }
    ]
  },
  "record": {
    "kind": "tile",
    "tile": "t2",
    "tabs": ["b"],
    "showing": "b",
    "neighbour": "t1",
    "side": "right",
    "share": 0.3
  }
}
