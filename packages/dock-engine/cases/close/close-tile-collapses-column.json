{
  "name": "close-tile-collapses-column",
  "rule": "rule-5",
  "before": {
    "split": "row",
    "items": [
      {
        "split": "column",
        "size": 0.5,
        "items": [
          {
            "tile": "t1",
            "tabs": ["a"],
            "showing": "a",
            "size": 0.5
          },
          {
            "tile": "t4",
            "tabs": ["d"],
            "showing": "d",
            "size": 0.5,
            "from": "t1"
          }
        ]
      },
      {
        "tile": "t2",
        "tabs": ["b"],
        "showing": "b",
        "size": 0.3
      },
      {
        "tile": "t3",
        "tabs": ["c"],
        "showing": "c",
        "size": 0.2
      }
    ]
  },
  "op": {
    "fn": "closeTile",
    "tile": "t4"
  },
  "after": {
    "split": "row",
    "items": [
      {
        "tile": "t1",
        "tabs": ["a"],
        "showing": "a",
        "size": 0.5
      },
      {
        "tile": "t2",
        "tabs": ["b"],
        "showing": "b",
        "size": 0.3
      },
      {
        "tile": "t3",
        "tabs": ["c"],
        "showing": "c",
        "size": 0.2
      }
    ]
  },
  "record": {
    "kind": "tile",
    "tile": "t4",
    "tabs": ["d"],
    "showing": "d",
    "neighbour": "t1",
    "side": "bottom",
    "share": 0.5
  }
}
